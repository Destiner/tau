+    #[gpui::test]
+    fn test_scroll_sensitivity_scales_wheel_delta_only(cx: &mut TestAppContext) {
+        cx.update(crate::init);
+        let mut input = None;
+        let window = cx.open_window(size(px(400.), px(100.)), |window, cx| {
+            input = Some(cx.new(|cx| crate::input::EditorState::new(window, cx)));
+            gpui::EmptyView
+        });
+        let input = input.unwrap();
+        window
+            .update(cx, |_, window, cx| {
+                input.update(cx, |state, cx| {
+                    state.input_bounds = Bounds::new(Point::default(), size(px(100.), px(20.)));
+                    state.scroll_size = size(px(200.), px(200.));
+                    let value = state.value();
+                    let selection = state.active_selection().clone();
+                    let revision = state.document_revision;
+                    let scroll = |state: &mut crate::input::EditorState,
+                                  window: &mut Window,
+                                  cx: &mut Context<crate::input::EditorState>,
+                                  delta| {
+                        state.on_scroll_wheel(
+                            &ScrollWheelEvent {
+                                delta,
+                                ..Default::default()
+                            },
+                            window,
+                            cx,
+                        );
+                        state.scroll_handle.offset()
+                    };
+                    assert_eq!(
+                        scroll(
+                            state,
+                            window,
+                            cx,
+                            gpui::ScrollDelta::Pixels(point(px(-0.5), px(-0.25)))
+                        ),
+                        point(px(-0.5), px(-0.25))
+                    );
+                    state.set_scroll_sensitivity(0.5);
+                    assert_eq!(
+                        scroll(
+                            state,
+                            window,
+                            cx,
+                            gpui::ScrollDelta::Pixels(point(px(-0.5), px(-0.25)))
+                        ),
+                        point(px(-0.75), px(-0.375))
+                    );
+                    let line_height = window.line_height();
+                    let offset = scroll(
+                        state,
+                        window,
+                        cx,
+                        gpui::ScrollDelta::Lines(point(-0.25, -0.5)),
+                    );
+                    assert_eq!(offset.x, px(-0.75) - line_height * 0.125);
+                    assert_eq!(offset.y, px(-0.375) - line_height * 0.25);
+                    assert_eq!(
+                        scroll(
+                            state,
+                            window,
+                            cx,
+                            gpui::ScrollDelta::Pixels(point(px(0.), px(0.25)))
+                        )
+                        .y,
+                        offset.y + px(0.125)
+                    );
+                    assert_eq!(
+                        scroll(
+                            state,
+                            window,
+                            cx,
+                            gpui::ScrollDelta::Pixels(point(px(-1000.), px(-1000.)))
+                        ),
+                        point(px(-100.), px(-180.))
+                    );
+                    state.set_scroll_sensitivity(f32::NAN);
+                    assert_eq!(state.scroll_sensitivity, 1.0);
+                    state.set_scroll_sensitivity(f32::INFINITY);
+                    assert_eq!(state.scroll_sensitivity, 1.0);
+                    state.set_scroll_sensitivity(0.0);
+                    assert_eq!(state.scroll_sensitivity, 1.0);
+                    state.set_scroll_sensitivity(-1.0);
+                    assert_eq!(state.scroll_sensitivity, 1.0);
+                    assert_eq!(state.value(), value);
+                    assert_eq!(state.active_selection(), &selection);
+                    assert_eq!(state.document_revision, revision);
+                });
+            })
+            .unwrap();
+    }
