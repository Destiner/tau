--- /dev/null
+++ b/src/profile_tests.rs
@@ -0,0 +1,64 @@
+use super::*;
+
+#[test]
+fn projection_is_opt_in_and_preserves_mermaid_defaults() {
+    let mut graph = Graph::default();
+    graph.spacing.node_node = 28.0;
+    graph.spacing.layer_layer = 48.0;
+    let original = layered_options_to_source(&graph);
+    assert_eq!(original.spacing.node_node, 40.0);
+    assert_eq!(original.spacing.node_node_between_layers, 40.0);
+    assert_eq!(
+        container_options_to_source(&graph, Direction::Down, HierarchyHandling::IncludeChildren)
+            .spacing
+            .node_node,
+        50.0
+    );
+    graph.spacing.layered_profile = Some(LayeredProfile::default());
+    for options in [
+        layered_options_to_source(&graph),
+        container_options_to_source(&graph, Direction::Down, HierarchyHandling::IncludeChildren),
+    ] {
+        assert_eq!(options.spacing.node_node, 28.0);
+        assert_eq!(options.spacing.node_node_between_layers, 48.0);
+        assert_eq!(options.spacing.edge_edge, 12.0);
+        assert_eq!(options.spacing.edge_edge_between_layers, 12.0);
+        assert_eq!(options.spacing.edge_node_between_layers, 12.0);
+        assert_eq!(options.thoroughness, 3);
+        assert_eq!(
+            options.horizontal_content_alignment,
+            source_port::ContentAlignment::Center
+        );
+    }
+    graph.spacing.layered_profile = None;
+    assert_eq!(layered_options_to_source(&graph), original);
+}
+
+#[test]
+fn profile_numbers_are_bounded_and_center_labels_are_independent() {
+    let mut graph = Graph::default();
+    graph.spacing.node_node = f64::NAN;
+    graph.spacing.layered_profile = Some(LayeredProfile {
+        edge_edge: f64::INFINITY,
+        thoroughness: usize::MAX,
+        ..Default::default()
+    });
+    let options = layered_options_to_source(&graph);
+    assert_eq!(options.spacing.node_node, 40.0);
+    assert_eq!(options.spacing.edge_edge, 20.0);
+    assert_eq!(options.thoroughness, 32);
+    let edge = Edge {
+        label: Some(Label {
+            width: 40.0,
+            height: 20.0,
+        }),
+        id: "e".into(),
+        source: "a".into(),
+        target: "b".into(),
+        terminal_labels: vec![],
+        minlen: 1,
+        inside_self_loops_yo: false,
+    };
+    assert!(!source_edge_labels(&edge, true, true, true, false)[0].inline);
+    assert!(source_edge_labels(&edge, true, true, true, true)[0].inline);
+}
