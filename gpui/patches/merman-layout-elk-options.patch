+fn apply_layered_profile(graph: &Graph, options: &mut SourceLayeredOptions) {
+    let Some(profile) = graph.spacing.layered_profile else {
+        return;
+    };
+    // Reject invalid numeric input by retaining the source default for that field.
+    fn bounded(value: f64, default: f64) -> f64 {
+        if value.is_finite() && (0.0..=10_000.0).contains(&value) {
+            value
+        } else {
+            default
+        }
+    }
+    options.spacing.node_node = bounded(graph.spacing.node_node, options.spacing.node_node);
+    options.spacing.node_node_between_layers = bounded(
+        graph.spacing.layer_layer,
+        options.spacing.node_node_between_layers,
+    );
+    options.spacing.edge_edge = bounded(profile.edge_edge, options.spacing.edge_edge);
+    options.spacing.edge_node = bounded(profile.edge_node, options.spacing.edge_node);
+    options.spacing.edge_edge_between_layers = bounded(
+        profile.edge_edge_between_layers,
+        options.spacing.edge_edge_between_layers,
+    );
+    options.spacing.edge_node_between_layers = bounded(
+        profile.edge_node_between_layers,
+        options.spacing.edge_node_between_layers,
+    );
+    options.spacing.edge_label = bounded(profile.edge_label, options.spacing.edge_label);
+    options.thoroughness = profile.thoroughness.clamp(1, 32);
+    if profile.center_content {
+        options.horizontal_content_alignment = source_port::ContentAlignment::Center;
+        options.vertical_content_alignment = source_port::ContentAlignment::Center;
+    }
