+    pub edge_edge: f64,
+    pub edge_node: f64,
+    pub edge_edge_between_layers: f64,
+    pub edge_node_between_layers: f64,
+    pub edge_label: f64,
+    pub thoroughness: usize,
+    pub center_content: bool,
+    pub inline_center_labels: bool,
+}
+
+impl Default for LayeredProfile {
+    fn default() -> Self {
+        Self {
+            edge_edge: 12.0,
+            edge_node: 10.0,
+            edge_edge_between_layers: 12.0,
+            edge_node_between_layers: 12.0,
+            edge_label: 2.0,
+            thoroughness: 3,
+            center_content: true,
+            inline_center_labels: true,
+        }
+    }
+}
