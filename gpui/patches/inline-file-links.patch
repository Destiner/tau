+#[gpui::test]
+fn root_tab_reaches_generated_and_explicit_inline_controls(cx: &mut TestAppContext) {
+    cx.update(crate::init);
+    for source in ["src/a.rs", "`src/a.rs`", "[file](docs/a%2520b.md)"] {
+        let events = Arc::new(Mutex::new(Vec::new()));
+        let captured = events.clone();
+        let (_, window) = cx.add_window_view(|window, cx| {
+            let host = cx.new(|cx| Host {
+                text: cx.new(|cx| {
+                    crate::TextViewState::markdown_with_extensions(source, extensions(), cx)
+                }),
+                events,
+            });
+            crate::Root::new(host, window, cx)
+        });
+        window.update(|window, cx| {
+            let _ = window.draw(cx);
+            assert!(window.focused(cx).is_none());
+            for key in ["tab", "enter"] {
+                let keystroke = gpui::Keystroke::parse(key).unwrap();
+                window.dispatch_event(
+                    gpui::KeyDownEvent {
+                        keystroke: keystroke.clone(),
+                        is_held: false,
+                        prefer_character_input: false,
+                    }
+                    .to_platform_input(),
+                    cx,
+                );
+                window.dispatch_event(gpui::KeyUpEvent { keystroke }.to_platform_input(), cx);
+                let _ = window.draw(cx);
+                assert!(window.focused(cx).is_some(), "{source}: {key}");
+            }
+        });
+        assert_eq!(
+            captured.lock().unwrap().as_slice(),
+            &[if source.starts_with('[') {
+                InlineLinkTarget::Explicit("docs/a%2520b.md".into())
+            } else {
+                InlineLinkTarget::WrittenPath {
+                    path: "src/a.rs".into(),
+                    button: false,
+                }
+            }]
+        );
+    }
+}
