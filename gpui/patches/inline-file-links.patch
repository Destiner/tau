@@ -0,0 +1,480 @@
+use super::*;
+use crate::text::{InlineLinkDecoration, InlineLinkTarget};
+use gpui::{AppContext as _, InputEvent as _};
+use gpui::{Context, Entity, Modifiers, MouseButton, Render, TestAppContext, point, px};
+
+#[test]
+fn inline_only_keeps_block_markers_blank_lines_and_source_offsets() {
+    let source = "# **src/a.rs**\n\n> quote\n- item\n```rs\ncode\n```\n&amp;";
+    let mut cx = NodeContext {
+        markdown_extensions: MarkdownExtensions::default().inline_only(true).into(),
+        ..Default::default()
+    };
+    let document = super::super::format::markdown::parse(source, &mut cx).unwrap();
+    assert_eq!(document.blocks.len(), 1);
+    let BlockNode::Paragraph(paragraph) = &document.blocks[0] else {
+        panic!()
+    };
+    assert!(
+        paragraph
+            .text()
+            .starts_with("# src/a.rs\n\n> quote\n- item")
+    );
+    let path = paragraph
+        .children
+        .iter()
+        .find(|node| node.text.contains("src/a.rs"))
+        .unwrap();
+    let start = path.text.find("src/a.rs").unwrap();
+    assert_eq!(
+        &source[path.selected_source_range(start..start + 8).unwrap()],
+        "src/a.rs"
+    );
+    let span = paragraph.span.as_ref().unwrap();
+    assert_eq!(span.start..span.end, 0..source.len());
+}
+
+struct ContextHost {
+    text: Entity<crate::TextViewState>,
+    events: Arc<Mutex<Vec<InlineLinkTarget>>>,
+    activations: Arc<Mutex<usize>>,
+}
+impl Render for ContextHost {
+    fn render(&mut self, _: &mut Window, _: &mut Context<Self>) -> impl IntoElement {
+        let events = self.events.clone();
+        let activations = self.activations.clone();
+        div().w(px(100.)).child(
+            crate::TextView::new(&self.text)
+                .markdown_extensions(extensions())
+                .on_link_context_menu(move |target, _, _, _| {
+                    events.lock().unwrap().push(target.clone())
+                })
+                .on_link_activate(move |_, _, _, _| *activations.lock().unwrap() += 1),
+        )
+    }
+}
+
+#[gpui::test]
+fn context_is_hit_tested_without_activation_focus_or_selection_mutation(cx: &mut TestAppContext) {
+    cx.update(crate::init);
+    let events = Arc::new(Mutex::new(Vec::new()));
+    let received = events.clone();
+    let activations = Arc::new(Mutex::new(0));
+    let activated = activations.clone();
+    let mut retained = None;
+    let (_, window) = cx.add_window_view(|window, cx| {
+        let host = cx.new(|cx| ContextHost {
+            text: cx.new(|cx| crate::TextViewState::markdown("src/a.rs trailing", cx)),
+            events,
+            activations,
+        });
+        retained = Some(host.clone());
+        crate::Root::new(host, window, cx)
+    });
+    let host = retained.unwrap();
+    window.update(|_, cx| {
+        let text = host.read(cx).text.clone();
+        text.update(cx, |text, cx| text.select_all(cx));
+    });
+    let origin = window.update(|window, cx| window.focused(cx));
+    window.simulate_mouse_down(
+        point(px(10.), px(10.)),
+        MouseButton::Right,
+        Modifiers::default(),
+    );
+    window.simulate_mouse_up(
+        point(px(10.), px(10.)),
+        MouseButton::Right,
+        Modifiers::default(),
+    );
+    assert_eq!(*activated.lock().unwrap(), 0);
+    assert_eq!(
+        received.lock().unwrap().as_slice(),
+        &[InlineLinkTarget::WrittenPath {
+            path: "src/a.rs".into(),
+            button: false
+        }]
+    );
+    window.update(|window, cx| {
+        assert_eq!(window.focused(cx), origin);
+        assert_eq!(
+            host.read(cx)
+                .text
+                .read(cx)
+                .selected_text()
+                .trim_end_matches('\n'),
+            "src/a.rs trailing"
+        );
+    });
+    if cfg!(target_os = "macos") {
+        let modifiers = Modifiers {
+            control: true,
+            ..Default::default()
+        };
+        window.simulate_mouse_down(point(px(10.), px(10.)), MouseButton::Left, modifiers);
+        window.simulate_mouse_up(point(px(10.), px(10.)), MouseButton::Left, modifiers);
+        assert_eq!(received.lock().unwrap().len(), 2);
+        assert_eq!(*activated.lock().unwrap(), 0);
+        window.update(|window, cx| {
+            assert_eq!(window.focused(cx), origin);
+            assert_eq!(
+                host.read(cx)
+                    .text
+                    .read(cx)
+                    .selected_text()
+                    .trim_end_matches('\n'),
+                "src/a.rs trailing"
+            );
+        });
+    }
+}
