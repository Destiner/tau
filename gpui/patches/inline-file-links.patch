+++ b/src/text/link_source.rs
@@ -0,0 +1,133 @@
+use std::{ops::Range, sync::Arc};
+
+use super::node::LinkMark;
+
+#[derive(Clone, PartialEq)]
+pub(super) struct LinkSource(Arc<[SourceLink]>);
+
+#[derive(PartialEq)]
+struct SourceLink {
+    range: Range<usize>,
+    mark: LinkMark,
+    order: usize,
+    prefix_end: usize,
+}
+
+impl From<Vec<(Range<usize>, LinkMark)>> for LinkSource {
+    fn from(links: Vec<(Range<usize>, LinkMark)>) -> Self {
+        observe(|stats| stats.indexed_links += links.len());
+        let mut links = links
+            .into_iter()
+            .enumerate()
+            .map(|(order, (range, mark))| SourceLink {
+                range,
+                mark,
+                order,
+                prefix_end: 0,
+            })
+            .collect::<Vec<_>>();
+        links.sort_by_key(|link| (link.range.start, link.order));
+        let mut end = 0;
+        for link in &mut links {
+            end = end.max(link.range.end);
+            link.prefix_end = end;
+        }
+        Self(links.into())
+    }
+}
+
+impl LinkSource {
+    fn intersecting(&self, range: &Range<usize>) -> &[SourceLink] {
+        let start = self.0.partition_point(|link| {
+            observe(|stats| stats.lookup_steps += 1);
+            link.prefix_end <= range.start
+        });
+        let end = self.0.partition_point(|link| {
+            observe(|stats| stats.lookup_steps += 1);
+            link.range.start < range.end
+        });
+        &self.0[start..end.max(start)]
+    }
+
+    pub(super) fn slice(&self, start: usize, end: usize) -> Vec<(Range<usize>, LinkMark)> {
+        let mut links = self
+            .intersecting(&(start..end))
+            .iter()
+            .filter_map(|link| {
+                observe(|stats| stats.lookup_steps += 1);
+                let clipped_start = link.range.start.max(start);
+                let clipped_end = link.range.end.min(end);
+                (clipped_start < clipped_end).then(|| {
+                    (
+                        link.order,
+                        (
+                            clipped_start - start..clipped_end - start,
+                            link.mark.clone(),
+                        ),
+                    )
+                })
+            })
+            .collect::<Vec<_>>();
