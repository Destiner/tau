+// The block parser still splits at blank lines. Keep their original positions
+// and bytes as text, rather than escaping or synthesizing a different source.
+fn join_inline_paragraphs(root: &mut Node, source: &str) {
+    let Node::Root(root) = root else {
+        return;
+    };
+    let mut children = Vec::new();
+    let mut previous = Point {
+        line: 1,
+        column: 1,
+        offset: 0,
+    };
+    for node in std::mem::take(&mut root.children) {
+        let Node::Paragraph(paragraph) = node else {
+            continue;
+        };
+        if let Some(position) = &paragraph.position {
+            if position.start.offset > previous.offset {
+                children.push(Node::Text(mdast::Text {
+                    value: source[previous.offset..position.start.offset].into(),
+                    position: Some(markdown::unist::Position {
+                        start: previous.clone(),
+                        end: position.start.clone(),
+                    }),
+                }));
+            }
+            previous = position.end.clone();
+        }
+        children.extend(paragraph.children);
+    }
+    if previous.offset < source.len() {
+        let end = root
+            .position
+            .as_ref()
+            .map(|p| p.end.clone())
+            .unwrap_or_else(|| Point {
+                offset: source.len(),
+                ..previous.clone()
+            });
+        children.push(Node::Text(mdast::Text {
+            value: source[previous.offset..].into(),
+            position: Some(markdown::unist::Position {
+                start: previous,
+                end,
+            }),
+        }));
+    }
+    root.children.push(Node::Paragraph(mdast::Paragraph {
+        children,
+        position: root.position.clone(),
+    }));
+}
