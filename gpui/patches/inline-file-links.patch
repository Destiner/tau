+#[test]
+fn large_single_paragraph_render_admission_is_indexed_and_preserves_copy() {
+    let source = "src/a.rs ".repeat(50_000);
+    assert_eq!(source.len(), 450_000);
+    let mut cx = NodeContext {
+        decoration_source: source.clone().into(),
+        markdown_extensions: MarkdownExtensions::default()
+            .inline_links(|leaf| {
+                leaf.text
+                    .match_indices("src/a.rs")
+                    .map(|(at, path)| InlineLinkDecoration {
+                        range: at..at + path.len(),
+                        path: path.to_owned().into(),
+                        button: false,
+                    })
+                    .collect()
+            })
+            .into(),
+        ..Default::default()
+    };
+    let document = super::super::format::markdown::parse(&source, &mut cx).unwrap();
+    assert_eq!(document.blocks.len(), 1);
+    let BlockNode::Paragraph(paragraph) = &document.blocks[0] else {
+        panic!()
+    };
+    let before = paragraph.source_for_range(None);
+    DECORATION_OVERLAP_STEPS.with(|steps| steps.set(0));
+    let mut count = 0;
+    for node in &paragraph.children {
+        let original_marks = node.marks.clone();
+        let original_segments = node.source_segments.clone();
+        for (range, mark) in node.render_marks(&cx) {
+            if let Some(link) = mark.link.filter(|link| link.generated.is_some()) {
+                assert_eq!(link.url.as_ref(), "src/a.rs");
+                assert_eq!(&node.text[range.clone()], "src/a.rs");
+                assert_eq!(
+                    &source[node.selected_source_range(range).unwrap()],
+                    "src/a.rs"
+                );
+                count += 1;
+            }
+        }
+        assert_eq!(node.marks, original_marks);
+        assert_eq!(node.source_segments, original_segments);
+    }
+    assert_eq!(count, 50_000);
+    // BTreeMap lookup/insert is logarithmic; admission examines at most one
+    // indexed neighbor, rather than all previously admitted decorations.
+    DECORATION_OVERLAP_STEPS.with(|steps| assert!(steps.get() <= 50_000));
+    assert_eq!(paragraph.source_for_range(None), before);
+    assert_eq!(before.trim_end(), source.trim_end());
+}
