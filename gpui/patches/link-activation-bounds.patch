+    pub(super) fn record_bounds(&self, range: &Range<usize>, bounds: Bounds<Pixels>) {
+        self.1
+            .lock()
+            .unwrap()
+            .entry((range.start, range.end))
+            .and_modify(|current| *current = current.union(&bounds))
+            .or_insert(bounds);
+    }
+
+    pub(super) fn bounds(&self, range: &Range<usize>) -> Option<Bounds<Pixels>> {
