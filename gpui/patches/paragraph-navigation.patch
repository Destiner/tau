+    fn move_paragraph(&mut self, up: bool, window: &mut Window, cx: &mut Context<Self>) {
+        if !self.is_editable() || self.is_code_editor() {
+            return;
+        }
+        self.move_all_cursors(
+            |s, sel| {
+                let offset = if sel.is_empty() {
+                    sel.cursor_offset()
+                } else if up {
+                    sel.start
+                } else {
+                    sel.end
+                };
+                let row = s.text.offset_to_point(offset).row;
+                let edge = if up {
+                    s.text.line_start_offset(row)
+                } else {
+                    s.text.line_end_offset(row)
+                };
+                let target = if !sel.is_empty() || offset != edge {
+                    edge
+                } else if up {
+                    s.text.line_start_offset(row.saturating_sub(1))
+                } else {
+                    s.text
+                        .line_end_offset((row + 1).min(s.text.lines_len() - 1))
+                };
+                (target, None, false)
+            },
+            Some(if up {
+                MoveDirection::Up
+            } else {
+                MoveDirection::Down
+            }),
+            window,
+            cx,
+        );
+    }
+
+    pub(super) fn paragraph_up(
+        &mut self,
+        _: &MoveParagraphUp,
+        window: &mut Window,
+        cx: &mut Context<Self>,
+    ) {
+        self.move_paragraph(true, window, cx);
+    }
+
+    pub(super) fn paragraph_down(
+        &mut self,
+        _: &MoveParagraphDown,
+        window: &mut Window,
+        cx: &mut Context<Self>,
+    ) {
+        self.move_paragraph(false, window, cx);
+    }
