+    #[gpui::test]
+    fn test_paragraph_navigation(cx: &mut TestAppContext) {
+        let view = InputView::build_textarea(cx, |state| state.default_value("abc\ndef\nghi"));
+        let mut cx = VisualTestContext::from_window(view.window_handle.into(), cx);
+        cx.run_until_parked();
+        cx.update(|window, cx| {
+            view.input.update(cx, |state, cx| {
+                state.move_to(5, None, cx);
+                state.paragraph_up(&MoveParagraphUp, window, cx);
+                assert_eq!(state.cursor(), 4);
+                state.paragraph_up(&MoveParagraphUp, window, cx);
+                assert_eq!(state.cursor(), 0);
+                state.paragraph_up(&MoveParagraphUp, window, cx);
+                assert_eq!(state.cursor(), 0);
+                state.move_to(5, None, cx);
+                state.paragraph_down(&MoveParagraphDown, window, cx);
+                assert_eq!(state.cursor(), 7);
+                state.paragraph_down(&MoveParagraphDown, window, cx);
+                assert_eq!(state.cursor(), 11);
+                for (start, end, up, down) in
+                    [(4, 6, 4, 7), (4, 7, 4, 7), (3, 4, 0, 7), (1, 6, 0, 7)]
+                {
+                    state.set_selection(start, end);
+                    state.paragraph_up(&MoveParagraphUp, window, cx);
+                    assert_eq!(state.cursor(), up);
+                    state.set_selection(start, end);
+                    state.paragraph_down(&MoveParagraphDown, window, cx);
+                    assert_eq!(state.cursor(), down);
+                }
+                state.set_value("\nabc\n\n", window, cx);
+                state.move_to(3, None, cx);
+                for expected in [4, 5, 6, 6] {
+                    state.paragraph_down(&MoveParagraphDown, window, cx);
+                    assert_eq!(state.cursor(), expected);
+                }
+                state.move_to(3, None, cx);
+                for expected in [1, 0, 0] {
+                    state.paragraph_up(&MoveParagraphUp, window, cx);
+                    assert_eq!(state.cursor(), expected);
+                }
+                state.set_value("", window, cx);
+                state.paragraph_down(&MoveParagraphDown, window, cx);
+                assert_eq!(state.cursor(), 0);
+                state.set_value("é😀\n漢字\n終", window, cx);
+                state.move_to(2, None, cx);
+                state.paragraph_down(&MoveParagraphDown, window, cx);
+                assert_eq!(state.cursor(), 6);
+                state.paragraph_up(&MoveParagraphUp, window, cx);
+                assert_eq!(state.cursor(), 0);
+            });
+        });
+    }
