+#[gpui::test]
+fn unmounted_views_query_current_order_clear_and_exact_unicode_source(cx: &mut TestAppContext) {
+    cx.update(crate::init);
+    let order = Rc::new(RefCell::new(vec![10, 20, 30]));
+    let provider = order.clone();
+    let domain = TextSelectionDomain::new(
+        move |item, _| {
+            provider
+                .borrow()
+                .iter()
+                .position(|id| *id == item)
+                .map(|i| i as u64)
+        },
+        |_, _| String::new(),
+    );
+    let view = cx.new(|cx| TextViewState::markdown("pré **naïve** tail", cx));
+    view.update(cx, |view, cx| {
+        view.set_selection_domain(Some((domain.clone(), 20)), cx)
+    });
+    cx.update(|cx| domain.set_range(interval((10, 1), (30, 2)), false, cx));
+    view.read_with(cx, |view, cx| {
+        assert_eq!(view.selected_text_with(cx), "pré naïve tail\n");
+        assert_eq!(view.selected_source_range_with(cx), Some(0..20));
+        assert!(view.selected_text().is_empty());
+        assert_eq!(view.selected_source_range(), None);
+    });
+    order.replace(vec![20, 10, 30]);
+    view.read_with(cx, |view, cx| {
+        assert!(view.selected_text_with(cx).is_empty());
+        assert_eq!(view.selected_source_range_with(cx), None);
+    });
+    cx.update(|cx| domain.set_range(interval((20, 5), (20, 11)), false, cx));
+    view.read_with(cx, |view, cx| {
+        assert_eq!(view.selected_text_with(cx), "naïve");
+        assert_eq!(view.selected_source_range_with(cx), Some(7..13));
+        assert_eq!(
+            view.copy_rendered_range(5..11, SelectionFormat::Source)
+                .unwrap(),
+            "**naïve**"
+        );
+    });
+    domain.clear();
+    view.read_with(cx, |view, cx| {
+        assert!(view.selected_text_with(cx).is_empty());
+        assert_eq!(view.selected_source_range_with(cx), None);
+    });
+}
