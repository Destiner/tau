+#[gpui::test]
+fn ordinary_async_reply_pending_and_remount_preserve_nonzero_offsets(cx: &mut TestAppContext) {
+    cx.update(crate::init);
+    for bytes in [5 * 1024, 8 * 1024] {
+        let source = format!(
+            "prefix **word** {}",
+            "ordinary reply text. ".repeat((bytes - 16) / 21)
+        );
+        assert!(source.len() > 4096 && source.len() <= 8192);
+        let domain = TextSelectionDomain::new(|item, _| Some(item), |_, _| String::new());
+        let selected = interval((10, 7), (10, 11));
+        cx.update(|cx| domain.set_range(selected, false, cx));
+        for _ in 0..2 {
+            let view = cx.new(|cx| TextViewState::markdown(&source, cx));
+            view.update(cx, |view, cx| {
+                view.set_selection_domain(Some((domain.clone(), 10)), cx)
+            });
+            view.read_with(cx, |view, cx| {
+                assert!(view.rendered_text().is_empty());
+                assert_eq!(view.selected_rendered_range_with(cx), None);
+                assert!(view.selected_text_with(cx).is_empty());
+                assert_eq!(view.selected_source_range_with(cx), None);
+                assert_eq!(domain.range(cx), Some(selected));
+            });
+            cx.run_until_parked();
+            view.read_with(cx, |view, cx| {
+                assert_eq!(view.selected_rendered_range_with(cx), Some(7..11));
+                assert_eq!(view.selected_text_with(cx), "word");
+                assert_eq!(view.selected_source_range_with(cx), Some(9..13));
+                assert_eq!(domain.range(cx), Some(selected));
+            });
+            view.update(cx, |view, cx| view.push_str(" appended", cx));
+            view.read_with(cx, |view, cx| {
+                assert_eq!(view.selected_rendered_range_with(cx), None);
+                assert_eq!(domain.range(cx), Some(selected));
+            });
+            cx.run_until_parked();
+            view.read_with(cx, |view, cx| {
+                assert_eq!(view.selected_text_with(cx), "word");
+                assert_eq!(domain.range(cx), Some(selected));
+            });
+            let weak = view.downgrade();
+            drop(view);
+            assert!(weak.upgrade().is_none());
+            assert_eq!(domain.stored_range(), Some(selected));
+        }
+    }
+}
