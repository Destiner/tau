+#[gpui::test]
+fn append_bounds_survive_closing_markup_beyond_cursor(cx: &mut TestAppContext) {
+    cx.update(crate::init);
+    let domain = TextSelectionDomain::new(|item, _| Some(item), |_, _| String::new());
+    let view = cx.new(|cx| TextViewState::markdown("alpha *beta", cx));
+    view.update(cx, |view, cx| {
+        view.set_selection_domain(Some((domain.clone(), 10)), cx)
+    });
+    cx.update(|cx| domain.set_range(interval((10, 0), (10, 5)), false, cx));
+    view.update(cx, |view, cx| view.push_str(" gamma", cx));
+    cx.run_until_parked();
+    view.read_with(cx, |view, cx| {
+        assert_eq!(view.selected_text_with(cx), "alpha")
+    });
+    view.update(cx, |view, cx| view.push_str("*", cx));
+    cx.run_until_parked();
+    cx.update(|cx| assert_eq!(domain.range(cx), Some(interval((10, 0), (10, 5)))));
+    view.read_with(cx, |view, cx| {
+        assert_eq!(view.selected_rendered_range_with(cx), Some(0..5));
+        assert_eq!(view.selected_text_with(cx), "alpha");
+    });
+    view.update(cx, |view, cx| view.set_text("different source", cx));
+    cx.update(|cx| assert_eq!(domain.range(cx), None));
+}
