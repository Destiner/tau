+fn interval(a: (u64, usize), b: (u64, usize)) -> TextSelectionDomainRange {
+    TextSelectionDomainRange {
+        anchor: TextSelectionDomainEndpoint {
+            item: a.0,
+            offset: a.1,
+        },
+        cursor: TextSelectionDomainEndpoint {
+            item: b.0,
+            offset: b.1,
+        },
+    }
+}
