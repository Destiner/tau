+    let state = window
+        .update(cx, |_, window, cx| {
+            let state = WindowSelectionState::ensure(window, cx);
+            let a = participant(10, &domain, cx);
+            let b = participant(30, &domain, cx);
+            register(&state, &a, 0., cx);
+            register(&state, &b, 20., cx);
+            begin(&state, 3., 1., cx);
+            update(&state, 7., 21., cx);
+            state.update(cx, |state, cx| state.end(cx));
+            drop(a);
+            drop(b);
+            assert_eq!(
+                TextSelection::selected_text(window, cx),
+                "partial first\nnever mounted intermediate\npartial last"
+            );
+            assert_eq!(calls.get(), 1);
+            TextSelection::clear(window, cx);
+            assert_eq!(domain.range(cx), None);
+            assert_eq!(TextSelection::selected_text(window, cx), "");
+            assert_eq!(calls.get(), 1);
+            state
+        })
+        .unwrap();
+    cx.update(|cx| {
+        let a = participant(10, &domain, cx);
+        register(&state, &a, 0., cx);
+        begin(&state, 2., 1., cx);
+        update(&state, 8., 1., cx);
+    });
+    drop(state);
+    cx.update(|_| {});
+    cx.update(|cx| assert_eq!(domain.range(cx), None));
+}
+
+#[gpui::test]
+fn invalid_domain_retains_local_select_all_copy_fallback(cx: &mut TestAppContext) {
+    cx.update(|cx| {
+        let domain = domain();
+        let state = cx.new(|_| WindowSelectionState::default());
+        let a = participant(10, &domain, cx);
+        register(&state, &a, 0., cx);
+        begin(&state, 2., 1., cx);
+        update(&state, 8., 1., cx);
+        a.set_local_selection(true, cx);
+        assert_eq!(domain.range(cx), None);
+        a.copy_with(|_| "local select all".into(), cx);
+        assert_eq!(
+            state.update(cx, |state, cx| state.selected_text(cx)),
+            "local select all"
+        );
+    });
+}
