+#[gpui::test]
+fn explicit_replacement_and_endpoint_deletion_invalidate(cx: &mut TestAppContext) {
+    cx.update(crate::init);
+    let exists = Rc::new(Cell::new(true));
+    let provider = exists.clone();
+    let domain = TextSelectionDomain::new(
+        move |item, _| provider.get().then_some(item),
+        |_, _| String::new(),
+    );
+    let view = cx.new(|cx| TextViewState::markdown("alpha beta", cx));
+    view.update(cx, |view, cx| {
+        view.set_selection_domain(Some((domain.clone(), 10)), cx)
+    });
+    for replacement in ["replacement".repeat(512), String::new()] {
+        cx.update(|cx| domain.set_range(interval((10, 1), (10, 4)), true, cx));
+        view.update(cx, |view, cx| view.set_text(&replacement, cx));
+        assert_eq!(domain.stored_range(), None);
+        assert!(!domain.is_selecting());
+        cx.run_until_parked();
+        cx.update(|cx| assert_eq!(domain.range(cx), None));
+    }
+    cx.update(|cx| domain.set_range(interval((10, 1), (10, 4)), true, cx));
+    exists.set(false);
+    cx.update(|cx| {
+        assert_eq!(domain.range(cx), None);
+        assert_eq!(domain.stored_range(), None);
+        assert!(!domain.is_selecting());
+    });
