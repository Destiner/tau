+use super::*;
+use gpui::{ContentMask, HitboxId, Render, TestAppContext, div, size};
+use std::cell::Cell;
+
+fn domain() -> TextSelectionDomain {
+    TextSelectionDomain::new(|item, _| Some(item), |_, _| "provider".into())
+}
+
+fn participant(item: u64, domain: &TextSelectionDomain, cx: &mut App) -> TextSelectionHandle {
+    let handle = TextSelectionHandle::new("legacy must not be copied", cx);
+    handle.set_domain(Some((domain.clone(), item)), cx);
+    handle.resolve_content_key_with(
+        |point, _| Some(TextSelectionContentKey::new(f32::from(point.x) as u64)),
+        cx,
+    );
+    handle
+}
+
+fn register(
+    state: &Entity<WindowSelectionState>,
+    handle: &TextSelectionHandle,
+    y: f32,
+    cx: &mut App,
+) {
+    let bounds = Bounds::new(point(px(0.), px(y)), size(px(100.), px(10.)));
+    state.update(cx, |state, cx| {
+        state.register_participant(
+            handle.clone(),
+            TextSelectionRegistration::new(
+                Hitbox {
+                    id: HitboxId::placeholder(),
+                    bounds,
+                    content_mask: ContentMask { bounds },
+                    behavior: HitboxBehavior::Normal,
+                },
+                bounds,
+            )
+            // Deliberately unrelated to source order.
+            .with_document_order(100 - y as u64)
+            .with_text_bounds(vec![bounds]),
+            cx,
+        );
+    });
+}
+
+fn begin(state: &Entity<WindowSelectionState>, x: f32, y: f32, cx: &mut App) {
+    state.update(cx, |state, cx| state.begin(point(px(x), px(y)), false, cx));
+    WindowSelectionState::resolve_content_keys(state, cx);
+}
+
+fn update(state: &Entity<WindowSelectionState>, x: f32, y: f32, cx: &mut App) {
+    state.update(cx, |state, cx| state.update(point(px(x), px(y)), cx));
+    WindowSelectionState::resolve_content_keys(state, cx);
+}
+
+fn interval(a: (u64, usize), b: (u64, usize)) -> TextSelectionDomainRange {
+    TextSelectionDomainRange {
+        anchor: TextSelectionDomainEndpoint {
+            item: a.0,
+            offset: a.1,
+        },
+        cursor: TextSelectionDomainEndpoint {
+            item: b.0,
+            offset: b.1,
+        },
+    }
+}
+
+#[gpui::test]
+fn begin_forward_reverse_partial_and_end(cx: &mut TestAppContext) {
+    cx.update(|cx| {
+        let domain = domain();
+        let state = cx.new(|_| WindowSelectionState::default());
+        let a = participant(10, &domain, cx);
+        let b = participant(30, &domain, cx);
+        register(&state, &a, 0., cx);
+        register(&state, &b, 20., cx);
+        begin(&state, 3., 1., cx);
+        assert_eq!(domain.range(cx), Some(interval((10, 3), (10, 3))));
+        assert!(domain.is_selecting());
+        update(&state, 7., 21., cx);
+        assert_eq!(a.logical_range(12, cx), Some(3..12));
+        assert_eq!(b.logical_range(12, cx), Some(0..7));
+        assert_eq!(domain.projected_range(20, 9, cx), Some(0..9));
+        assert_eq!(domain.projected_range(40, 9, cx), None);
+        assert_eq!(
+            a.snapshot(cx).unwrap().coverage(),
+            TextSelectionCoverage::ToEnd
+        );
+        state.update(cx, |state, cx| state.end(cx));
+        assert!(!domain.is_selecting());
+        begin(&state, 7., 21., cx);
+        update(&state, 3., 1., cx);
+        assert_eq!(domain.range(cx), Some(interval((30, 7), (10, 3))));
+        assert_eq!(a.logical_range(12, cx), Some(3..12));
+        assert_eq!(b.logical_range(12, cx), Some(0..7));
+        begin(&state, 8., 1., cx);
+        update(&state, 2., 1., cx);
+        assert_eq!(a.logical_range(12, cx), Some(2..8));
+        assert_eq!(b.logical_range(12, cx), None);
+    });
+}
+
+#[gpui::test]
+fn sweep_one_then_both_endpoints_and_drop_preserves_interval(cx: &mut TestAppContext) {
+    let (domain, state, weak_a, weak_b) = cx.update(|cx| {
+        let domain = domain();
+        let state = cx.new(|_| WindowSelectionState::default());
+        let a = participant(10, &domain, cx);
+        let b = participant(30, &domain, cx);
+        register(&state, &a, 0., cx);
+        register(&state, &b, 20., cx);
+        begin(&state, 3., 1., cx);
+        update(&state, 7., 21., cx);
+        state.update(cx, |state, cx| {
+            state.end(cx);
+            state.finish_frame(cx);
+        });
+        register(&state, &b, 20., cx);
+        state.update(cx, |state, cx| {
+            state.finish_frame(cx);
+        });
+        assert_eq!(state.read(cx).participants.len(), 1);
+        assert_eq!(domain.range(cx), Some(interval((10, 3), (30, 7))));
+        assert!(b.snapshot(cx).unwrap().window_points().is_none());
+        let weak_a = a.downgrade();
+        drop(a);
+        state.update(cx, |state, cx| {
+            state.finish_frame(cx);
+        });
+        let weak_b = b.downgrade();
+        drop(b);
+        (domain, state, weak_a, weak_b)
+    });
+    cx.update(|cx| {
+        assert!(weak_a.upgrade().is_none());
+        assert!(weak_b.upgrade().is_none());
+        assert!(state.read(cx).participants.is_empty());
+        assert!(state.read(cx).has_selection(cx));
+        assert_eq!(
+            state.update(cx, |state, cx| state.selected_text(cx)),
+            "provider"
+        );
+        let middle = participant(20, &domain, cx);
+        register(&state, &middle, 10., cx);
+        let snapshot = middle.snapshot(cx).unwrap();
+        assert_eq!(snapshot.coverage(), TextSelectionCoverage::Full);
+        assert!(snapshot.window_points().is_none());
+        assert_eq!(middle.logical_range(100, cx), Some(0..100));
+        let remounted_a = participant(10, &domain, cx);
+        register(&state, &remounted_a, 0., cx);
+        assert_eq!(remounted_a.logical_range(12, cx), Some(3..12));
+        assert_eq!(
+            remounted_a.snapshot(cx).unwrap().coverage(),
+            TextSelectionCoverage::ToEnd
+        );
+    });
+}
