+#[gpui::test]
+fn source_mutation_invalidation_and_hover_cannot_resurrect(cx: &mut TestAppContext) {
+    cx.update(|cx| {
+        let present = Rc::new(Cell::new(true));
+        let p = present.clone();
+        let domain =
+            TextSelectionDomain::new(move |item, _| p.get().then_some(item), |_, _| "copy".into());
+        let state = cx.new(|_| WindowSelectionState::default());
+        let a = participant(10, &domain, cx);
+        register(&state, &a, 0., cx);
+        begin(&state, 2., 1., cx);
+        update(&state, 8., 1., cx);
+        state.update(cx, |state, cx| state.end(cx));
+        domain.invalidate();
+        WindowSelectionState::resolve_content_keys(&state, cx);
+        register(&state, &a, 0., cx);
+        assert_eq!(domain.range(cx), None);
+        assert_eq!(a.snapshot(cx), None);
+        assert_eq!(state.update(cx, |state, cx| state.selected_text(cx)), "");
+        begin(&state, 2., 1., cx);
+        update(&state, 8., 1., cx);
+        present.set(false);
+        assert_eq!(domain.range(cx), None);
+        assert!(!domain.is_selecting());
+        present.set(true);
+        assert_eq!(domain.range(cx), None);
+    });
+}
