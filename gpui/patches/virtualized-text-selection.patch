+++ b/src/text/logical_selection_tests.rs
@@ -0,0 +1,302 @@
+use super::{
+    SelectionFormat, document::ParsedDocument, format::markdown, node::NodeContext,
+    range_highlight::RenderedIndex,
+};
+use gpui::AppContext as _;
+use std::ops::Range;
+
+fn document(source: &str) -> (ParsedDocument, RenderedIndex) {
+    let document = markdown::parse(source, &mut NodeContext::default()).unwrap();
+    let index = RenderedIndex::new(&document);
+    (document, index)
+}
+
+fn occurrence(text: &str, needle: &str) -> Range<usize> {
+    let start = text.find(needle).unwrap();
+    start..start + needle.len()
+}
+
+#[test]
+fn cold_copy_parses_large_markdown_without_view_or_executor() {
+    let source = "**naïve** &amp; `code`\n\n".repeat(600);
+    let plain = "naïve & code\n".repeat(600);
+    assert_eq!(
+        super::TextViewState::copy_markdown_slice(&source, None, None, SelectionFormat::Plain)
+            .unwrap(),
+        plain
+    );
+    assert_eq!(
+        super::TextViewState::copy_markdown_slice(
+            &source,
+            Some(0),
+            Some(6),
+            SelectionFormat::Source
+        )
+        .unwrap(),
+        "**naïve**"
+    );
+    assert!(
+        super::TextViewState::copy_markdown_slice(
+            &source,
+            Some(3),
+            Some(4),
+            SelectionFormat::Plain
+        )
+        .is_err()
+    );
+}
+
+#[test]
+fn logical_projection_is_utf8_exact_without_layout() {
+    let source = "**甲乙** same\n\n*same* &amp; café";
+    let (doc, index) = document(source);
+    let rendered = doc.text();
+    let range = occurrence(&rendered, "乙");
+    assert_eq!(
+        doc.copy_rendered_range(&index, range.clone(), SelectionFormat::Plain)
+            .unwrap(),
+        "乙"
+    );
+    assert_eq!(
+        doc.copy_rendered_range(&index, range.clone(), SelectionFormat::Source)
+            .unwrap(),
+        "**乙**"
+    );
+    assert_eq!(
+        doc.source_range_for_rendered_range(&index, range),
+        Some(5..8)
+    );
+    let second = rendered.rfind("same").unwrap();
+    let source_second = source.rfind("same").unwrap();
+    assert_eq!(
+        doc.source_range_for_rendered_range(&index, second..second + 4),
+        Some(source_second..source_second + 4)
+    );
+    let entity = occurrence(&rendered, "&");
+    assert_eq!(
+        doc.source_range_for_rendered_range(&index, entity),
+        Some(occurrence(source, "&amp;"))
+    );
+    assert!(
+        doc.copy_rendered_range(&index, 1..2, SelectionFormat::Plain)
+            .is_err()
+    );
+    assert_eq!(doc.source_range_for_rendered_range(&index, 1..2), None);
+    assert!(!doc.blocks.iter().any(|block| block.has_selection()));
+}
+
+#[test]
+fn logical_projection_preserves_separators_and_full_middle_source() {
+    let source =
+        "start\n\n_untouched_ [ref][r]\n\n![alt](image.png)\n\nend\n\n[r]: https://example.com";
+    let (doc, index) = document(source);
+    let rendered = doc.text();
+    let range = 2..rendered.find("end").unwrap() + 2;
+    assert_eq!(
+        doc.copy_rendered_range(&index, range.clone(), SelectionFormat::Plain)
+            .unwrap(),
+        &rendered[range.clone()]
+    );
+    let copied = doc
+        .copy_rendered_range(&index, range, SelectionFormat::Source)
+        .unwrap();
+    assert!(copied.contains("_untouched_ [ref][r]"), "{copied}");
+    assert!(copied.contains("![alt](image.png)"), "{copied}");
+    assert_eq!(
+        doc.copy_rendered_range(&index, 5..6, SelectionFormat::Plain)
+            .unwrap(),
+        "\n"
+    );
+    assert_eq!(doc.source_range_for_rendered_range(&index, 5..6), None);
+    assert_eq!(
+        doc.copy_rendered_range(&index, 3..3, SelectionFormat::Source)
+            .unwrap(),
+        ""
+    );
+}
+
+#[test]
+fn logical_projection_reconstructs_code_tables_lists_and_images() {
+    for (source, needle, expected) in [
+        ("```rust\nalpha beta\n```", "beta", "```rust\nbeta\n```"),
+        ("## **Title**", "itl", "## **itl**"),
+        ("- [x] alpha\n- beta", "lph", "- [x] lph"),
+        (
+            "before ![alt](image.png) after",
+            "before  after",
+            "before ![alt](image.png) after",
+        ),
+    ] {
+        let (doc, index) = document(source);
+        let range = occurrence(&doc.text(), needle);
+        assert_eq!(
+            doc.copy_rendered_range(&index, range, SelectionFormat::Source)
+                .unwrap(),
+            expected
+        );
+        assert!(!doc.blocks.iter().any(|block| block.has_selection()));
+    }
+    let (doc, index) = document("| alpha | beta |\n| :-- | --: |\n| gamma | delta |");
+    let range = occurrence(&doc.text(), "amm");
+    let source = doc
+        .copy_rendered_range(&index, range.clone(), SelectionFormat::Source)
+        .unwrap();
+    assert!(source.contains("| amm |  |"), "{source}");
+    assert_eq!(
+        doc.source_range_for_rendered_range(&index, range),
+        Some(occurrence(&doc.source, "amm"))
+    );
+}
+
+#[test]
+fn logical_projection_includes_covered_zero_width_image_blocks_at_edges() {
+    let source = "![leading](one.png)\n\nbody\n\n![trailing](two.png)";
+    let (doc, index) = document(source);
+    let range = 0..doc.text().len();
+    let copied = doc
+        .copy_rendered_range(&index, range.clone(), SelectionFormat::Source)
+        .unwrap();
+    assert_eq!(copied, source);
+    assert_eq!(
+        doc.source_range_for_rendered_range(&index, range),
+        Some(0..source.len())
+    );
+}
+
+#[test]
+fn logical_projection_rejects_unmapped_content_even_between_mapped_endpoints() {
+    let (mut doc, _) = document("first\n\nsecond\n\nlast");
+    let blocks = std::sync::Arc::make_mut(&mut doc.blocks);
+    let super::node::BlockNode::Paragraph(paragraph) = &mut blocks[1] else {
+        panic!("paragraph");
+    };
+    paragraph.children[0].source_segments.clear();
+    let index = RenderedIndex::new(&doc);
+    let rendered = doc.text();
+    assert_eq!(
+        doc.source_range_for_rendered_range(&index, 0..rendered.len()),
+        None
+    );
+    assert_eq!(
+        doc.copy_rendered_range(&index, 0..rendered.len(), SelectionFormat::Plain)
+            .unwrap(),
+        rendered
+    );
+}
+
+#[test]
+fn logical_projection_maps_inline_objects_and_repeated_images() {
+    let source = "文 $x$ ![one](one.png) ![two](two.png) end";
+    let (doc, index) = document(source);
+    let rendered = doc.text();
+    let range = 0..rendered.trim_end_matches('\n').len();
+    let copied = doc
+        .copy_rendered_range(&index, range.clone(), SelectionFormat::Source)
+        .unwrap();
+    assert!(copied.contains("$x$"), "{copied}");
+    assert!(copied.contains("![one](one.png)"), "{copied}");
+    assert!(copied.contains("![two](two.png)"), "{copied}");
+    assert_eq!(
+        doc.source_range_for_rendered_range(&index, range),
+        Some(0..source.len())
+    );
+}
+
+#[gpui::test]
+fn logical_projection_state_queries_do_not_need_a_window(cx: &mut gpui::TestAppContext) {
+    let view = cx.update(|cx| cx.new(|cx| super::TextViewState::markdown("**甲乙**", cx)));
+    view.update(cx, |state, cx| {
+        state.set_logical_selection(Some(3..6), cx).unwrap();
+        assert_eq!(state.selected_text(), "乙");
+        assert_eq!(state.selected_source_range(), Some(5..8));
+        assert_eq!(
+            state
+                .copy_rendered_range(0..3, SelectionFormat::Source)
+                .unwrap(),
+            "**甲**"
+        );
+        assert_eq!(state.logical_selection(), Some(3..6));
+        state.invalidate_inline_layout(cx);
+        assert_eq!(state.logical_selection(), Some(3..6));
+        assert_eq!(state.selected_text(), "乙");
+        assert!(state.set_logical_selection(Some(1..2), cx).is_err());
+        assert_eq!(state.logical_selection(), Some(3..6));
+        state.clear_selection(cx);
+        assert_eq!(state.logical_selection(), None);
+        assert_eq!(state.selected_text(), "");
+        state.set_logical_selection(Some(0..3), cx).unwrap();
+        state.set_text("replacement", cx);
+        assert_eq!(state.logical_selection(), None);
+        assert_eq!(
+            state.rendered_offset_at(gpui::point(gpui::px(0.), gpui::px(0.))),
+            None
+        );
+    });
+}
+
+#[gpui::test]
+fn logical_projection_mounted_object_hit_test_is_atomic_and_clears_per_frame(
+    cx: &mut gpui::TestAppContext,
+) {
+    let view =
+        cx.update(|cx| cx.new(|cx| super::TextViewState::markdown("before object after", cx)));
+    view.update(cx, |state, _| {
+        let bounds = gpui::Bounds::new(
+            gpui::point(gpui::px(10.), gpui::px(20.)),
+            gpui::size(gpui::px(40.), gpui::px(20.)),
+        );
+        state.selection_adapter.register_inline(vec![bounds]);
+        state
+            .selection_adapter
+            .register_rendered_object(bounds, 7..13);
+        assert_eq!(
+            state.rendered_offset_at(gpui::point(gpui::px(15.), gpui::px(25.))),
+            Some(7)
+        );
+        assert_eq!(
+            state.rendered_offset_at(gpui::point(gpui::px(45.), gpui::px(25.))),
+            Some(13)
+        );
+        assert_eq!(
+            state.rendered_offset_at(gpui::point(gpui::px(45.), gpui::px(50.))),
+            None
+        );
+        state.selection_adapter.begin_frame();
+        assert_eq!(
+            state.rendered_offset_at(gpui::point(gpui::px(15.), gpui::px(25.))),
+            None
+        );
+    });
+}
+
+#[gpui::test]
+fn logical_projection_survives_append_reparse(cx: &mut gpui::TestAppContext) {
+    let view = cx.update(|cx| cx.new(|cx| super::TextViewState::markdown("first", cx)));
+    view.update(cx, |state, cx| {
+        state.set_logical_selection(Some(1..4), cx).unwrap();
+        state.push_str(" **tail**", cx);
+    });
+    cx.run_until_parked();
+    view.read_with(cx, |state, _| {
+        assert_eq!(state.logical_selection(), Some(1..4));
+        assert_eq!(state.selected_text(), "irs");
+        assert_eq!(state.source_range_for_rendered_range(7..9), Some(9..11));
+    });
+}
+
+#[test]
+fn logical_projection_maps_escapes_and_indented_code() {
+    for (source, needle, expected) in [
+        ("a \\* b", "*", 2..4),
+        ("    alpha\n    beta\n", "pha\nbet", 6..17),
+        ("**repeat** **repeat**", "peat", 4..8),
+    ] {
+        let (doc, index) = document(source);
+        let range = occurrence(&doc.text(), needle);
+        assert_eq!(
+            doc.source_range_for_rendered_range(&index, range),
+            Some(expected),
+            "{source}"
+        );
+    }
+}
