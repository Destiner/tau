+                    for &stop in &stops[1..] {
+                        state.right(&MoveRight, window, cx);
+                        assert_eq!(state.cursor(), stop);
+                    }
+                    for &stop in stops[..stops.len() - 1].iter().rev() {
+                        state.left(&MoveLeft, window, cx);
