+    /// Horizontal navigation uses graphemes; deletion still uses scalar boundaries.
+    /// Only materialize the current line, not the entire document, on each key press.
+    pub(super) fn previous_grapheme_boundary(&self, offset: usize) -> usize {
+        let offset = self
+            .text
+            .clip_offset(offset.min(self.text.len()), Bias::Left);
+        let row = self.text.offset_to_point(offset).row;
+        let start = self.text.line_start_offset(row);
+        if offset == start {
+            return self.previous_boundary(offset);
+        }
+        let line = self
+            .text
+            .slice(start..self.text.line_end_offset(row))
+            .to_string();
+        let local = offset - start;
+        let target = line
+            .grapheme_indices(true)
+            .map(|(index, _)| index)
+            .take_while(|&index| index < local)
+            .last()
+            .unwrap_or(0);
+        self.clamp_offset_to_visible_backward(self.cursor_boundary(start + target, Bias::Left))
+    }
+
+    pub(super) fn next_grapheme_boundary(&self, offset: usize) -> usize {
+        let offset = self
+            .text
+            .clip_offset(offset.min(self.text.len()), Bias::Left);
+        let row = self.text.offset_to_point(offset).row;
+        let start = self.text.line_start_offset(row);
+        let end = self.text.line_end_offset(row);
+        if offset >= end {
+            return self.next_boundary(offset);
+        }
+        let line = self.text.slice(start..end).to_string();
+        let local = offset - start;
+        let target = line
+            .grapheme_indices(true)
+            .map(|(index, _)| index)
+            .chain(std::iter::once(line.len()))
+            .find(|&index| index > local)
+            .unwrap_or(line.len());
+        self.clamp_offset_to_visible_forward(self.cursor_boundary(start + target, Bias::Right))
+    }
