 #[allow(non_upper_case_globals)]
 const NSUTF8StringEncoding: NSUInteger = 4;
 
+// Preserve the panel's destination: guessing a different filename could bypass
+// overwrite consent for that different path.
+fn save_destination_from_url(url: &objc2_foundation::NSURL) -> Option<PathBuf> {
+    if url.isFileURL() {
+        url.to_file_path()
+    } else {
+        None
+    }
+}
+
+#[cfg(test)]
+mod save_destination_tests {
+    use super::save_destination_from_url;
+    use objc2_foundation::{NSString, NSURL};
+    use std::path::Path;
+
+    #[test]
+    fn preserves_native_url_filenames() {
+        for filename in [
+            "a.sql.s",
+            "a.txtx.txt",
+            "archive.tar.gz",
+            "a.sql.sql",
+            "a.s.s",
+            "résumé.日本語.日",
+            "cafe\u{301}.sql.s",
+            "name with spaces.#%.s",
+        ] {
+            let expected = Path::new("/tau-save-url-regression").join(filename);
+            let url = NSURL::from_file_path(&expected).expect("synthetic absolute file URL");
+            assert_eq!(
+                save_destination_from_url(&url).as_deref(),
+                Some(expected.as_path())
+            );
+        }
+    }
+
+    #[test]
+    fn rejects_non_file_url() {
+        let url = NSURL::URLWithString(&NSString::from_str("https://example.invalid/a.sql.s"))
+            .expect("synthetic HTTPS URL");
+        assert_eq!(save_destination_from_url(&url), None);
+    }
+}
+
