+pub(super) fn auto_grow_cursor_margin(
+    override_margin: Option<Pixels>,
+    line_height: Pixels,
+    viewport: Pixels,
+) -> Pixels {
+    override_margin
+        .unwrap_or(line_height)
+        .clamp(px(0.), viewport / 2.)
+}
