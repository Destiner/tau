@@ -0,0 +1,242 @@
+use super::*;
+
+impl StateInner {
+    pub(super) fn layout_estimated_items(
+        &mut self,
+        available_width: Option<Pixels>,
+        available_height: Pixels,
+        padding: &Edges<Pixels>,
+        render_item: &mut RenderItemFn,
+        window: &mut Window,
+        cx: &mut App,
+    ) -> LayoutItemsResponse {
+        let items = self.items.clone();
+        let epoch = self.geometry_epoch;
+        let needs_visit = |summary: &ListItemSummary| {
+            summary.height != px(0.)
+                || summary.unrendered_count > 0
+                || summary.oldest_epoch.is_some_and(|old| old < epoch)
+        };
+        let space = size(
+            available_width.map_or(AvailableSpace::MaxContent, AvailableSpace::Definite),
+            AvailableSpace::MinContent,
+        );
+        let count = items.summary().count;
+        let mut top = self.logical_scroll_top();
+        if self.follow_state.is_following() {
+            top = ListOffset {
+                item_ix: count,
+                offset_in_item: px(0.),
+            };
+            self.logical_scroll_top = Some(top);
+        }
+        let anchor = top.item_ix;
+        let mut cursor = items.cursor::<Count>(());
+        cursor.seek(&Count(anchor), Bias::Right);
+        if matches!(cursor.item(), Some(ListItem::Measured { size, epoch: old, .. })
+            if size.height == px(0.) && *old == epoch)
+        {
+            top.offset_in_item = px(0.);
+            self.pending_scroll = None;
+            if self.logical_scroll_top.is_some() {
+                self.logical_scroll_top = Some(top);
+            }
+        }
+        let mut budget = VIEWPORT_STEP_BUDGET;
+        let mut layouts = VecDeque::new();
+        let mut height = padding.top;
+        let mut max_width = px(0.);
+        let mut pending = false;
+        let mut reached_end = false;
+        loop {
+            if height - top.offset_in_item >= available_height + self.overdraw {
+                break;
+            }
+            if cursor.item_summary().is_some_and(|s| !needs_visit(s)) {
+                cursor.search_forward(needs_visit);
+            }
+            let Some(item) = cursor.item() else {
+                reached_end = true;
+                break;
+            };
+            if budget == 0 {
+                pending = true;
+                break;
+            }
+            budget -= 1;
+            let ix = cursor.start().0;
+            self.geometry_visits += 1;
+            let mut element = render_item(ix, window, cx);
+            let measured = element.layout_as_root(space, window, cx);
+            self.replace_item(
+                ix,
+                ListItem::Measured {
+                    epoch,
+                    size: measured,
+                    focus_handle: item.focus_handle(),
+                },
+            );
+            self.exact_items.insert(ix);
+            if ix == anchor {
+                if let Some(adjustment) = self.pending_scroll.take() {
+                    top.offset_in_item = match adjustment {
+                        PendingScroll::Absolute { item_ix, offset } if item_ix == ix => {
+                            offset.min(measured.height)
+                        }
+                        PendingScroll::Proportional(p) if p.item_ix == ix => {
+                            measured.height * p.fraction
+                        }
+                        _ => top.offset_in_item,
+                    };
+                    self.logical_scroll_top = Some(top);
+                }
+            }
+            if height - top.offset_in_item < available_height && measured.height > px(0.) {
+                layouts.push_back(ItemLayout {
+                    index: ix,
+                    element,
+                    size: measured,
+                });
+            }
+            height += measured.height;
+            max_width = max_width.max(measured.width);
+            cursor.search_forward(needs_visit);
+        }
+        reached_end |= cursor.item().is_none();
+        height += padding.bottom;
+        // Never clamp an anchor at an unmeasured frontier: it is not the physical end.
+        cursor.seek(&Count(anchor), Bias::Right);
+        if reached_end && height - top.offset_in_item < available_height {
+            let mut first = anchor;
+            while height < available_height {
+                cursor.search_backward(needs_visit);
+                let Some(item) = cursor.item() else {
+                    first = 0;
+                    break;
+                };
+                if budget == 0 {
+                    pending = true;
+                    break;
+                }
+                budget -= 1;
+                let ix = cursor.start().0;
+                self.geometry_visits += 1;
+                let mut element = render_item(ix, window, cx);
+                let measured = element.layout_as_root(space, window, cx);
+                self.replace_item(
+                    ix,
+                    ListItem::Measured {
+                        epoch,
+                        size: measured,
+                        focus_handle: item.focus_handle(),
+                    },
+                );
+                self.exact_items.insert(ix);
+                first = ix;
+                height += measured.height;
+                max_width = max_width.max(measured.width);
+                if measured.height > px(0.) {
+                    layouts.push_front(ItemLayout {
+                        index: ix,
+                        element,
+                        size: measured,
+                    });
+                }
+            }
+            top = ListOffset {
+                item_ix: first,
+                offset_in_item: height - available_height,
+            };
+            if self.alignment == ListAlignment::Top {
+                top.offset_in_item = top.offset_in_item.max(px(0.));
+            }
+            if !pending {
+                self.logical_scroll_top = match self.alignment {
+                    ListAlignment::Top => Some(top),
+                    ListAlignment::Bottom => None,
+                };
+            }
+        }
+        let mut leading = top.offset_in_item;
+        while !pending && leading < self.overdraw {
+            cursor.search_backward(needs_visit);
+            let Some(item) = cursor.item() else {
+                break;
+            };
+            if budget == 0 {
+                pending = true;
+                break;
+            }
+            budget -= 1;
+            let ix = cursor.start().0;
+            let measured = match item {
+                ListItem::Measured {
+                    size, epoch: old, ..
+                } if *old == epoch => *size,
+                _ => {
+                    self.geometry_visits += 1;
+                    let measured = render_item(ix, window, cx).layout_as_root(space, window, cx);
+                    self.replace_item(
+                        ix,
+                        ListItem::Measured {
+                            epoch,
+                            size: measured,
+                            focus_handle: item.focus_handle(),
+                        },
+                    );
+                    self.exact_items.insert(ix);
+                    measured
+                }
+            };
+            leading += measured.height;
+        }
+        self.trim_exact_cache();
+        self.viewport_pending = pending;
+        if pending {
+            window.request_animation_frame();
+        }
+        if !pending
+            && reached_end
+            && self.wheel_reached_end
+            && self.follow_state.has_stopped_following()
+        {
+            let total = self.items.summary().height + padding.top + padding.bottom;
+            if self.scroll_top(&top) + available_height >= total - px(1.) {
+                self.follow_state.start_following();
+            }
+        }
+        // Keep the boundary intent through viewport continuation, not through a reversal.
+        if !pending {
+            self.wheel_reached_end = false;
+        }
+        let focused_visible = layouts.iter().any(|layout| {
+            items
+                .find::<Count, _>((), &Count(layout.index), Bias::Right)
+                .2
+                .is_some_and(|item| item.contains_focused(window, cx))
+        });
+        if !focused_visible {
+            let mut focused = items.filter::<_, Count>((), |s| s.has_focus_handles);
+            focused.next();
+            while let Some(item) = focused.item() {
+                if item.contains_focused(window, cx) {
+                    self.geometry_visits += 1;
+                    let mut element = render_item(focused.start().0, window, cx);
+                    let size = element.layout_as_root(space, window, cx);
+                    layouts.push_back(ItemLayout {
+                        index: focused.start().0,
+                        element,
+                        size,
+                    });
+                    break;
+                }
+                focused.next();
+            }
+        }
+        LayoutItemsResponse {
+            max_item_width: max_width,
+            scroll_top: top,
+            item_layouts: layouts,
+        }
+    }
+}
diff --git a/src/elements/list/estimated_tests.rs b/src/elements/list/estimated_tests.rs
