@@ -0,0 +1,466 @@
+use super::*;
+use crate::{self as gpui, AppContext, Context, Render, TestAppContext, VisualTestContext, canvas};
+use std::cell::Cell;
+
+pub(super) struct Rows {
+    pub(super) state: ListState,
+    pub(super) heights: Rc<RefCell<Vec<f32>>>,
+    pub(super) visits: Rc<Cell<usize>>,
+    pub(super) painted: Rc<RefCell<BTreeSet<usize>>>,
+}
+impl Render for Rows {
+    fn render(&mut self, _: &mut Window, _: &mut Context<Self>) -> impl IntoElement {
+        let heights = self.heights.clone();
+        let visits = self.visits.clone();
+        let painted = self.painted.clone();
+        list(self.state.clone(), move |ix, _, _| {
+            visits.set(visits.get() + 1);
+            let painted = painted.clone();
+            canvas(
+                |_, _, _| {},
+                move |_, _, _, _| {
+                    painted.borrow_mut().insert(ix);
+                },
+            )
+            .h(px(heights.borrow()[ix]))
+            .w_full()
+            .into_any()
+        })
+        .size_full()
+    }
+}
+pub(super) fn draw(cx: &mut VisualTestContext, rows: &Rows, width: f32, height: f32) {
+    cx.draw(
+        point(px(0.), px(0.)),
+        size(px(width), px(height)),
+        |_, cx| {
+            cx.new(|_| Rows {
+                state: rows.state.clone(),
+                heights: rows.heights.clone(),
+                visits: rows.visits.clone(),
+                painted: rows.painted.clone(),
+            })
+            .into_any_element()
+        },
+    );
+}
+pub(super) fn wheel(cx: &mut VisualTestContext, distance: f32) {
+    cx.simulate_event(ScrollWheelEvent {
+        position: point(px(1.), px(1.)),
+        delta: ScrollDelta::Pixels(point(px(0.), px(-distance))),
+        ..Default::default()
+    });
+}
+pub(super) fn rows(count: usize, hint: f32) -> Rows {
+    Rows {
+        state: ListState::new(count, ListAlignment::Top, px(0.))
+            .with_estimated_item_size(size(px(0.), px(hint))),
+        heights: Rc::new(RefCell::new(
+            (0..count).map(|ix| 13. + (ix % 7) as f32 * 10.).collect(),
+        )),
+        visits: Rc::new(Cell::new(0)),
+        painted: Rc::default(),
+    }
+}
+pub(super) fn physical(rows: &Rows) -> f32 {
+    let top = rows.state.logical_scroll_top();
+    rows.heights.borrow()[..top.item_ix].iter().sum::<f32>() + top.offset_in_item.0
+}
+fn settle(cx: &mut VisualTestContext, rows: &Rows, width: f32, height: f32) {
+    for _ in 0..100 {
+        draw(cx, rows, width, height);
+        if rows.state.0.borrow().wheel_input.is_empty() && !rows.state.0.borrow().viewport_pending {
+            return;
+        }
+    }
+    panic!("wheel continuation did not settle");
+}
+
+#[gpui::test]
+fn width_change_stale_zero_suffix_is_not_exact(cx: &mut TestAppContext) {
+    let cx = cx.add_empty_window();
+    let rows = rows(10000, 10.);
+    rows.heights.borrow_mut().fill(0.);
+    settle(cx, &rows, 200., 200.);
+    assert_eq!(rows.state.0.borrow().items.summary().rendered_count, 10000);
+    rows.state.scroll_to(ListOffset {
+        item_ix: 0,
+        offset_in_item: px(0.),
+    });
+    rows.heights.borrow_mut().fill(10.);
+    let visits = rows.visits.get();
+    draw(cx, &rows, 300., 200.);
+    assert!(rows.visits.get() - visits <= VIEWPORT_STEP_BUDGET);
+    assert!(!rows.state.0.borrow().viewport_pending);
+    assert_eq!(rows.state.is_scrolled_to_end(), None);
+
+    // Only the relevant suffix must be exact, not the entire history.
+    rows.state.scroll_to(ListOffset {
+        item_ix: 9960,
+        offset_in_item: px(0.),
+    });
+    draw(cx, &rows, 300., 400.);
+    draw(cx, &rows, 300., 200.);
+    assert_eq!(rows.state.is_scrolled_to_end(), Some(false));
+    rows.state.scroll_to_end();
+    draw(cx, &rows, 300., 200.);
+    assert_eq!(rows.state.is_scrolled_to_end(), Some(true));
+}
+
+#[gpui::test]
+fn width_change_implicit_bottom_intent_has_empty_suffix(cx: &mut TestAppContext) {
+    let cx = cx.add_empty_window();
+    let rows = rows(10000, 10.);
+    rows.state.0.borrow_mut().alignment = ListAlignment::Bottom;
+    rows.heights.borrow_mut().fill(0.);
+    settle(cx, &rows, 200., 200.);
+    assert!(rows.state.0.borrow().logical_scroll_top.is_none());
+    rows.heights.borrow_mut().fill(10.);
+    draw(cx, &rows, 300., 200.);
+    assert!(rows.state.0.borrow().logical_scroll_top.is_none());
+    assert_eq!(rows.state.logical_scroll_top().item_ix, 10000);
+    // The first viewport has no known overflow, so the query is not scrollable yet.
+    assert_eq!(rows.state.is_scrolled_to_end(), None);
+    draw(cx, &rows, 300., 100.);
+    // None is an implicit end intent here, not a reader anchor at item zero.
+    assert!(rows.state.0.borrow().logical_scroll_top.is_none());
+    assert_eq!(rows.state.is_scrolled_to_end(), Some(true));
+}
+
+#[gpui::test]
+fn cold_wheels_are_physical_and_history_independent(cx: &mut TestAppContext) {
+    let cx = cx.add_empty_window();
+    for count in [1000, 10000] {
+        for hint in [1., 30., 500.] {
+            let rows = rows(count, hint);
+            draw(cx, &rows, 200., 200.);
+            assert!(rows.visits.get() < 25);
+            let initial = rows.visits.get();
+            let mut expected = 0.;
+            for distance in [0.25, 550., -0.5, 1700., -550., -0.25, -900., 123.75] {
+                wheel(cx, distance);
+                expected = (expected + distance).max(0.);
+                settle(cx, &rows, 200., 200.);
+                assert!(
+                    (physical(&rows) - expected).abs() < 0.01,
+                    "count={count}, hint={hint}, delta={distance}: {} != {expected}",
+                    physical(&rows)
+                );
+                assert!(rows.state.estimated_geometry_stats().1 <= EXACT_CACHE_LIMIT);
+            }
+            assert!(rows.visits.get() - initial < 350);
+            assert_eq!(rows.state.estimated_geometry_stats().0, rows.visits.get());
+        }
+    }
+}
+
+#[gpui::test]
+fn multiple_inputs_keep_fifo_and_bottom_reversal(cx: &mut TestAppContext) {
+    let cx = cx.add_empty_window();
+    let rows = rows(1000, 1.);
+    draw(cx, &rows, 200., 200.);
+    for distance in [550., 0.25, -130., 900.] {
+        wheel(cx, distance);
+    }
+    settle(cx, &rows, 200., 200.);
+    assert!((physical(&rows) - 1320.25).abs() < 0.01);
+    rows.state.set_follow_mode(FollowMode::Tail);
+    draw(cx, &rows, 200., 200.);
+    let bottom = physical(&rows);
+    wheel(cx, 1000.);
+    wheel(cx, -55.25);
+    settle(cx, &rows, 200., 200.);
+    assert!((physical(&rows) - (bottom - 55.25)).abs() < 0.01);
+    assert!(!rows.state.is_following_tail());
+}
+
+#[gpui::test]
+fn hints_persist_through_insertion_reset_and_width(cx: &mut TestAppContext) {
+    let cx = cx.add_empty_window();
+    let rows = rows(10000, 80.);
+    draw(cx, &rows, 200., 200.);
+    rows.state.splice_with_size_hints(
+        10000..10000,
+        [(Some(size(px(0.), px(150.))), None), (None, None)],
+    );
+    rows.heights.borrow_mut().extend([150., 80.]);
+    let state = rows.state.0.borrow();
+    assert_eq!(
+        state
+            .items
+            .find::<Count, _>((), &Count(10000), Bias::Right)
+            .2
+            .unwrap()
+            .size_hint()
+            .unwrap()
+            .height,
+        px(150.)
+    );
+    assert_eq!(
+        state
+            .items
+            .find::<Count, _>((), &Count(10001), Bias::Right)
+            .2
+            .unwrap()
+            .size_hint()
+            .unwrap()
+            .height,
+        px(80.)
+    );
+    drop(state);
+    rows.state.scroll_to(ListOffset {
+        item_ix: 5000,
+        offset_in_item: px(5.25),
+    });
+    draw(cx, &rows, 200., 200.);
+    let visits = rows.visits.get();
+    draw(cx, &rows, 100., 200.);
+    draw(cx, &rows, 200., 200.);
+    draw(cx, &rows, 200., 300.);
+    assert_eq!(rows.state.logical_scroll_top().item_ix, 5000);
+    assert_eq!(rows.state.logical_scroll_top().offset_in_item, px(5.25));
+    assert!(rows.visits.get() - visits < 50);
+    assert!(rows.state.estimated_geometry_stats().2 < 50);
+    rows.state.reset(10000);
+    assert_eq!(rows.state.0.borrow().items.summary().height, px(800000.));
+}
+
+#[gpui::test]
+fn distant_seek_settles_locally_and_cache_is_bounded(cx: &mut TestAppContext) {
+    let cx = cx.add_empty_window();
+    let rows = rows(10000, 500.);
+    draw(cx, &rows, 200., 200.);
+    let expected_ix = rows
+        .state
+        .0
+        .borrow()
+        .items
+        .find::<ListItemSummary, _>((), &Height(px(2500100.)), Bias::Right)
+        .0
+        .count;
+    rows.state
+        .set_offset_from_scrollbar(point(px(0.), px(-2500100.)));
+    draw(cx, &rows, 200., 200.);
+    let top = rows.state.logical_scroll_top();
+    assert_eq!(top.item_ix, expected_ix);
+    assert!(top.offset_in_item <= px(rows.heights.borrow()[expected_ix]));
+    assert!(rows.visits.get() < 30);
+    for ix in (0..10000).step_by(25) {
+        rows.state.scroll_to(ListOffset {
+            item_ix: ix,
+            offset_in_item: px(3.),
+        });
+        draw(cx, &rows, 200., 200.);
+    }
+    assert_eq!(rows.state.estimated_geometry_stats().1, EXACT_CACHE_LIMIT);
+    let invalidations = rows.state.estimated_geometry_stats().2;
+    draw(cx, &rows, 100., 200.);
+    assert_eq!(
+        rows.state.estimated_geometry_stats().2 - invalidations,
+        EXACT_CACHE_LIMIT
+    );
+    assert!(rows.state.estimated_geometry_stats().1 < 20);
+}
+
+#[gpui::test]
+fn streaming_removal_and_tail_intent(cx: &mut TestAppContext) {
+    let cx = cx.add_empty_window();
+    let rows = rows(1000, 500.);
+    rows.state.set_follow_mode(FollowMode::Tail);
+    draw(cx, &rows, 200., 200.);
+    assert!(rows.state.is_following_tail());
+    rows.heights.borrow_mut()[999] += 100.;
+    rows.state.remeasure_items(999..1000);
+    draw(cx, &rows, 200., 200.);
+    let total: f32 = rows.heights.borrow().iter().sum();
+    assert!((physical(&rows) - (total - 200.)).abs() < 0.02);
+    wheel(cx, -550.25);
+    settle(cx, &rows, 200., 200.);
+    assert!(!rows.state.is_following_tail());
+    let anchor = rows.state.logical_scroll_top();
+    rows.heights.borrow_mut()[999] += 200.;
+    rows.state.remeasure_items(999..1000);
+    rows.heights.borrow_mut().push(50.);
+    rows.state.splice(1000..1000, 1);
+    draw(cx, &rows, 200., 200.);
+    assert_eq!(rows.state.logical_scroll_top().item_ix, anchor.item_ix);
+    assert_eq!(
+        rows.state.logical_scroll_top().offset_in_item,
+        anchor.offset_in_item
+    );
+    assert!(!rows.state.is_following_tail());
+    rows.state
+        .remeasure_items(anchor.item_ix..anchor.item_ix + 1);
+    rows.heights.borrow_mut()[anchor.item_ix] += 100.;
+    draw(cx, &rows, 200., 200.);
+    assert_eq!(
+        rows.state.logical_scroll_top().offset_in_item,
+        anchor.offset_in_item
+    );
+    rows.state.splice(0..10, 0);
+    rows.heights.borrow_mut().drain(0..10);
+    draw(cx, &rows, 200., 200.);
+    assert_eq!(rows.state.logical_scroll_top().item_ix, anchor.item_ix - 10);
+    wheel(cx, 5000.);
+    settle(cx, &rows, 200., 200.);
+    assert!(rows.state.is_following_tail());
+}
+
+#[gpui::test]
+fn zero_rows_wheel_retains_residual_and_terminates(cx: &mut TestAppContext) {
+    let cx = cx.add_empty_window();
+    for (count, zero_end) in [(1000, 800), (10000, 9000)] {
+        let rows = rows(count, 10.);
+        for ix in 20..zero_end {
+            rows.heights.borrow_mut()[ix] = 0.;
+        }
+        draw(cx, &rows, 200., 200.);
+        wheel(cx, 1500.25);
+        settle(cx, &rows, 200., 200.);
+        assert!((physical(&rows) - 1500.25).abs() < 0.01);
+        wheel(cx, -1500.25);
+        settle(cx, &rows, 200., 200.);
+        assert_eq!(physical(&rows), 0.);
+    }
+}
+
+#[gpui::test]
+fn fractional_row_geometry_uses_actual_layout_oracle(cx: &mut TestAppContext) {
+    let cx = cx.add_empty_window();
+    let rows = rows(1000, 500.);
+    for (ix, height) in rows.heights.borrow_mut().iter_mut().enumerate() {
+        *height += (ix % 4) as f32 * 0.25;
+    }
+    // Taffy/platform pixel rounding means style heights are not an exact physical oracle.
+    // Measure a separate reference list; the list under test remains cold and lazy.
+    let reference = Rows {
+        state: ListState::new(1000, ListAlignment::Top, px(0.)).measure_all(),
+        heights: rows.heights.clone(),
+        visits: Rc::new(Cell::new(0)),
+        painted: Rc::default(),
+    };
+    draw(cx, &reference, 200., 200.);
+    let actual: Vec<f32> = reference
+        .state
+        .0
+        .borrow()
+        .items
+        .iter()
+        .map(|item| item.size().unwrap().height.0)
+        .collect();
+    draw(cx, &rows, 200., 200.);
+    let mut expected: f32 = 0.;
+    for delta in [0.25, 550., -0.5, 1750.25, -1100.75, -550., 0.75] {
+        wheel(cx, delta);
+        settle(cx, &rows, 200., 200.);
+        expected = (expected + delta).max(0.);
+        let top = rows.state.logical_scroll_top();
+        let observed = actual[..top.item_ix].iter().sum::<f32>() + top.offset_in_item.0;
+        assert!(
+            (observed - expected).abs() < 0.01,
+            "{observed} != {expected}"
+        );
+    }
+    assert!(rows.visits.get() < 300);
+}
+
+#[gpui::test]
+fn bottom_alignment_wheels_and_scroll_by_use_rendered_anchor(cx: &mut TestAppContext) {
+    let cx = cx.add_empty_window();
+    let mut rows = rows(1000, 500.);
+    rows.state = ListState::new(1000, ListAlignment::Bottom, px(0.))
+        .with_estimated_item_size(size(px(0.), px(500.)));
+    draw(cx, &rows, 200., 200.);
+    let bottom = rows.heights.borrow().iter().sum::<f32>() - 200.;
+    wheel(cx, -550.25);
+    settle(cx, &rows, 200., 200.);
+    assert!(
+        (physical(&rows) - (bottom - 550.25)).abs() < 0.01,
+        "observed={}, expected={}, logical={:?}, painted={:?}",
+        physical(&rows),
+        bottom - 550.25,
+        rows.state.logical_scroll_top(),
+        rows.state.0.borrow().last_painted_scroll_top
+    );
+    wheel(cx, 1000.);
+    settle(cx, &rows, 200., 200.);
+    // Bottom alignment keeps its public implicit end anchor; read the actual painted anchor.
+    let anchor = rows.state.0.borrow().last_painted_scroll_top.unwrap();
+    let observed =
+        rows.heights.borrow()[..anchor.item_ix].iter().sum::<f32>() + anchor.offset_in_item.0;
+    assert!((observed - bottom).abs() < 0.01);
+    rows.state.scroll_by(px(-55.25));
+    settle(cx, &rows, 200., 200.);
+    assert!((physical(&rows) - (bottom - 55.25)).abs() < 0.01);
+}
+
+#[gpui::test]
+fn large_wheel_has_bounded_visits_and_frame_continuation(cx: &mut TestAppContext) {
+    let cx = cx.add_empty_window();
+    let rows = rows(10000, 1.);
+    draw(cx, &rows, 200., 200.);
+    wheel(cx, 50000.25);
+    let mut frames = 0;
+    loop {
+        let visits = rows.visits.get();
+        draw(cx, &rows, 200., 200.);
+        assert!(rows.visits.get() - visits <= WHEEL_STEP_BUDGET + 25);
+        assert!(rows.state.estimated_geometry_stats().1 <= EXACT_CACHE_LIMIT);
+        frames += 1;
+        if rows.state.0.borrow().wheel_input.is_empty() {
+            break;
+        }
+        assert!(frames < 20);
+        assert!(cx.update(|window, cx| window.simulate_next_frame(cx)) > 0);
+    }
+    assert!(frames > 1);
+    assert!((physical(&rows) - 50000.25).abs() < 0.01);
+    wheel(cx, -50000.25);
+    settle(cx, &rows, 200., 200.);
+    assert_eq!(physical(&rows), 0.);
+}
+
+#[gpui::test]
+fn width_reflow_height_only_and_paused_tail(cx: &mut TestAppContext) {
+    let cx = cx.add_empty_window();
+    let rows = rows(10000, 1.);
+    draw(cx, &rows, 200., 200.);
+    rows.state.scroll_to(ListOffset {
+        item_ix: 5000,
+        offset_in_item: px(5.25),
+    });
+    draw(cx, &rows, 200., 200.);
+    for height in rows.heights.borrow_mut().iter_mut() {
+        *height *= 2.;
+    }
+    draw(cx, &rows, 100., 200.);
+    assert_eq!(rows.state.logical_scroll_top().item_ix, 5000);
+    assert_eq!(rows.state.logical_scroll_top().offset_in_item, px(5.25));
+    let invalidations = rows.state.estimated_geometry_stats().2;
+    draw(cx, &rows, 100., 400.);
+    assert_eq!(rows.state.estimated_geometry_stats().2, invalidations);
+    for height in rows.heights.borrow_mut().iter_mut() {
+        *height /= 2.;
+    }
+    draw(cx, &rows, 200., 200.);
+    assert_eq!(rows.state.logical_scroll_top().item_ix, 5000);
+    assert_eq!(rows.state.logical_scroll_top().offset_in_item, px(5.25));
+    rows.state.set_follow_mode(FollowMode::Tail);
+    draw(cx, &rows, 200., 200.);
+    rows.heights.borrow_mut().push(133.);
+    rows.state.splice(10000..10000, 1);
+    draw(cx, &rows, 200., 200.);
+    assert!(rows.state.is_following_tail());
+    let total: f32 = rows.heights.borrow().iter().sum();
+    assert!((physical(&rows) - (total - 200.)).abs() < 0.02);
+    rows.state.pause_following_tail();
+    rows.state.remeasure_items(9999..10001);
+    draw(cx, &rows, 200., 200.);
+    assert!(
+        !rows.state.is_following_tail(),
+        "geometry refinement is not user tail intent"
+    );
+    wheel(cx, 1.);
+    settle(cx, &rows, 200., 200.);
+    assert!(rows.state.is_following_tail());
+}
