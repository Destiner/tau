@@ -0,0 +1,151 @@
+use super::estimated_tests::{draw, physical, rows, wheel};
+use super::*;
+use crate::{self as gpui, TestAppContext, VisualTestContext};
+
+fn bounded_settle(
+    cx: &mut VisualTestContext,
+    rows: &super::estimated_tests::Rows,
+    width: f32,
+) -> usize {
+    for frame in 1..=100 {
+        let limit = if rows.state.0.borrow().wheel_input.is_empty() {
+            VIEWPORT_STEP_BUDGET
+        } else {
+            VIEWPORT_STEP_BUDGET + WHEEL_STEP_BUDGET + 1
+        };
+        let callbacks = rows.visits.get();
+        let measurements = rows.state.estimated_geometry_stats().0;
+        draw(cx, rows, width, 200.);
+        let delta = rows.visits.get() - callbacks;
+        assert!(delta <= limit, "callbacks={delta}");
+        assert_eq!(
+            rows.state.estimated_geometry_stats().0 - measurements,
+            delta
+        );
+        let state = rows.state.0.borrow();
+        if !state.viewport_pending && state.wheel_input.is_empty() {
+            return frame;
+        }
+    }
+    panic!("viewport continuation did not terminate");
+}
+
+#[gpui::test]
+fn ten_thousand_zero_rows_cold_known_resize_and_visible_paint(cx: &mut TestAppContext) {
+    let cx = cx.add_empty_window();
+    let rows = rows(10001, 20.);
+    rows.heights.borrow_mut().fill(0.);
+    rows.heights.borrow_mut()[10000] = 300.;
+    assert!(bounded_settle(cx, &rows, 200.) > 1);
+    assert_eq!(rows.visits.get(), 10001);
+    assert_eq!(*rows.painted.borrow(), BTreeSet::from([10000]));
+    assert_eq!(rows.state.item_is_below_viewport(10000), Some(false));
+    // All zero rows remain known even though the positive-height hot cache is bounded.
+    for _ in 0..3 {
+        let before = rows.visits.get();
+        assert_eq!(bounded_settle(cx, &rows, 200.), 1);
+        assert_eq!(rows.visits.get() - before, 1);
+    }
+    assert!(bounded_settle(cx, &rows, 220.) > 1);
+    assert_eq!(bounded_settle(cx, &rows, 220.), 1);
+    assert_eq!(physical(&rows), 0.);
+    rows.heights.borrow_mut()[5000] = 50.;
+    rows.state.remeasure_items(5000..5001);
+    rows.painted.borrow_mut().clear();
+    assert_eq!(bounded_settle(cx, &rows, 220.), 1);
+    assert!(rows.painted.borrow().contains(&5000));
+    assert!(rows.painted.borrow().contains(&10000));
+}
+
+#[gpui::test]
+fn zero_run_tail_bottom_and_all_zero_termination(cx: &mut TestAppContext) {
+    let cx = cx.add_empty_window();
+    for all_zero in [false, true] {
+        let rows = rows(10001, 20.);
+        rows.heights.borrow_mut().fill(0.);
+        if !all_zero {
+            rows.heights.borrow_mut()[0] = 300.;
+        }
+        rows.state.set_follow_mode(FollowMode::Tail);
+        assert!(bounded_settle(cx, &rows, 200.) > 1);
+        assert!(rows.state.is_following_tail());
+        assert_eq!(physical(&rows), if all_zero { 0. } else { 100. });
+        assert_eq!(bounded_settle(cx, &rows, 200.), 1);
+        if !all_zero {
+            assert_eq!(*rows.painted.borrow(), BTreeSet::from([0]));
+            assert_eq!(rows.state.item_is_above_viewport(0), Some(false));
+            wheel(cx, -0.25);
+            bounded_settle(cx, &rows, 200.);
+            assert!(!rows.state.is_following_tail());
+            assert!((physical(&rows) - 99.75).abs() < 0.01);
+            wheel(cx, 0.25);
+            bounded_settle(cx, &rows, 200.);
+            assert!(rows.state.is_following_tail());
+        }
+    }
+}
+
+#[gpui::test]
+fn zero_run_leading_overdraw_bottom_alignment_and_anchor(cx: &mut TestAppContext) {
+    let cx = cx.add_empty_window();
+    let rows = rows(10001, 20.);
+    rows.heights.borrow_mut().fill(0.);
+    rows.heights.borrow_mut()[10000] = 300.;
+    rows.state.0.borrow_mut().overdraw = px(50.);
+    rows.state.scroll_to(ListOffset {
+        item_ix: 10000,
+        offset_in_item: px(0.),
+    });
+    assert!(bounded_settle(cx, &rows, 200.) > 1);
+    assert_eq!(bounded_settle(cx, &rows, 200.), 1);
+    assert_eq!(rows.state.logical_scroll_top().item_ix, 10000);
+    rows.state.scroll_to(ListOffset {
+        item_ix: 5000,
+        offset_in_item: px(100.),
+    });
+    assert_eq!(bounded_settle(cx, &rows, 200.), 1);
+    assert_eq!(physical(&rows), 0.);
+    rows.state.0.borrow_mut().alignment = ListAlignment::Bottom;
+    rows.state.scroll_to(ListOffset {
+        item_ix: 10001,
+        offset_in_item: px(0.),
+    });
+    assert_eq!(bounded_settle(cx, &rows, 200.), 1);
+    let painted = rows.state.0.borrow().last_painted_scroll_top.unwrap();
+    assert_eq!(painted.item_ix, 10000);
+    assert_eq!(painted.offset_in_item, px(100.));
+    rows.state.0.borrow_mut().overdraw = px(150.);
+    rows.state.remeasure_items(0..10001);
+    assert!(bounded_settle(cx, &rows, 200.) > 1);
+    let painted = rows.state.0.borrow().last_painted_scroll_top.unwrap();
+    assert_eq!(painted.item_ix, 10000);
+    assert_eq!(painted.offset_in_item, px(100.));
+    assert_eq!(bounded_settle(cx, &rows, 200.), 1);
+}
+
+#[gpui::test]
+fn viewport_continuation_interrupt_seek_and_fifo_reversal(cx: &mut TestAppContext) {
+    let cx = cx.add_empty_window();
+    let rows = rows(10002, 20.);
+    rows.heights.borrow_mut().fill(0.);
+    rows.heights.borrow_mut()[0] = 250.;
+    rows.heights.borrow_mut()[10001] = 300.;
+    rows.state.scroll_to(ListOffset {
+        item_ix: 1,
+        offset_in_item: px(0.),
+    });
+    draw(cx, &rows, 200., 200.);
+    assert!(rows.state.0.borrow().viewport_pending);
+    rows.state.scroll_to(ListOffset {
+        item_ix: 0,
+        offset_in_item: px(0.),
+    });
+    assert_eq!(bounded_settle(cx, &rows, 200.), 1);
+    assert_eq!(physical(&rows), 0.);
+    wheel(cx, 275.25);
+    wheel(cx, -25.5);
+    assert!(bounded_settle(cx, &rows, 200.) > 1);
+    assert!((physical(&rows) - 249.75).abs() < 0.01);
+    assert!(rows.painted.borrow().contains(&10001));
+    assert_eq!(rows.state.item_is_below_viewport(10001), Some(false));
+}
