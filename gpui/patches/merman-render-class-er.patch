+use super::super::*;
+use crate::er::presentation as profile;
+
+pub(super) struct EntityContext<'a> {
+    pub config: &'a serde_json::Value,
+    pub measurer: &'a dyn crate::text::TextMeasurer,
+    pub translate: (f64, f64),
+    pub diagram_id: SvgDiagramId<'a>,
+    pub rect_styles: &'a str,
+    pub text_styles: &'a str,
+}
+
+pub(super) fn entity(
+    out: &mut String,
+    node: &crate::model::LayoutNode,
+    model: &crate::er::ErEntity,
+    ctx: &EntityContext<'_>,
+) {
+    let config = ctx.config;
+    let measurer = ctx.measurer;
+    let (tx, ty) = ctx.translate;
+    let settings = crate::er::ErConfigView::new(config).render_settings();
+    let measure = crate::er::measure_entity_box(
+        model,
+        measurer,
+        &settings.label_style,
+        &settings.attr_style,
+        settings.entity_measurement,
+    );
+    let fg = theme_token(config, "textColor", "#333333");
+    let fill = theme_token(config, "mainBkg", "#ECECFF");
+    let stroke = theme_token(config, "nodeBorder", "#9370DB");
+    let x = -node.width / 2.0;
+    let y = -node.height / 2.0;
+    let mono = settings
+        .attr_style
+        .font_family
+        .as_deref()
+        .unwrap_or("monospace");
+    let rect_styles = escape_xml(ctx.rect_styles);
+    let text_styles = escape_xml(ctx.text_styles);
+    let id = format!("{}-{}", ctx.diagram_id, model.id);
+    let _ = write!(
+        out,
+        r#"<g class="node compact-er {}" id="{}" transform="translate({},{})"><rect x="{}" y="{}" width="{}" height="{}" style="fill:{};stroke:{};stroke-width:1;{rect_styles}"/><rect x="{}" y="{}" width="{}" height="{}" style="fill:{};fill-opacity:0.05;stroke:none"/><line x1="{}" x2="{}" y1="{}" y2="{}" style="stroke:{};stroke-opacity:0.12;stroke-width:1"/><text x="0" y="{}" text-anchor="middle" dominant-baseline="central" style="font-family:{};font-size:13px;font-weight:500;fill:{};{text_styles}">{}</text>"#,
+        escape_xml(&model.css_classes),
+        escape_xml(&id),
+        fmt(node.x + tx),
+        fmt(node.y + ty),
+        fmt(x),
+        fmt(y),
+        fmt(node.width),
+        fmt(node.height),
+        escape_xml(&fill),
+        escape_xml(&stroke),
+        fmt(x),
+        fmt(y),
+        fmt(node.width),
+        fmt(profile::HEADER),
+        escape_xml(&fg),
+        fmt(x),
+        fmt(-x),
+        fmt(y + profile::HEADER),
+        fmt(y + profile::HEADER),
+        escape_xml(&fg),
+        fmt(y + profile::HEADER / 2.0),
+        escape_xml(&settings.font_family),
+        escape_xml(&fg),
+        escape_xml(measure.label.rendered_text())
+    );
+    for (i, row) in measure.rows.iter().enumerate() {
+        let cy = y + profile::HEADER + (i as f64 + 0.5) * profile::ROW;
+        let badge = profile::key_width(
+            row.key_label.rendered_text(),
+            measurer,
+            &settings.label_style,
+        );
+        out.push_str("<g>");
+        if !row.comment_label.rendered_text().is_empty() {
+            let _ = write!(
+                out,
+                "<title>{}</title>",
+                escape_xml(row.comment_label.rendered_text())
+            );
+        }
+        if badge > 0.0 {
+            let _ = write!(
+                out,
+                r#"<rect x="{}" y="{}" width="{}" height="14" rx="2" style="fill:{};fill-opacity:0.1;stroke:none"/><text x="{}" y="{}" text-anchor="middle" dominant-baseline="central" style="font-family:{};font-size:9px;font-weight:600;fill:{};fill-opacity:0.6;{text_styles}">{}</text>"#,
+                fmt(x + 6.0),
+                fmt(cy - 7.0),
+                fmt(badge),
+                escape_xml(&fg),
+                fmt(x + 6.0 + badge / 2.0),
+                fmt(cy),
+                escape_xml(&settings.font_family),
+                escape_xml(&fg),
+                escape_xml(row.key_label.rendered_text())
+            );
+        }
+        let _ = write!(
+            out,
+            r#"<text x="{}" y="{}" dominant-baseline="central" style="font-family:{};font-size:11px;font-weight:400;fill:{};fill-opacity:0.45;{text_styles}">{}</text><text x="{}" y="{}" text-anchor="end" dominant-baseline="central" style="font-family:{};font-size:11px;font-weight:400;fill:{};fill-opacity:0.6;{text_styles}">{}</text></g>"#,
+            fmt(x + 8.0 + if badge > 0.0 { badge + 6.0 } else { 0.0 }),
+            fmt(cy),
+            escape_xml(mono),
+            escape_xml(&fg),
+            escape_xml(row.type_label.rendered_text()),
+            fmt(-x - 8.0),
+            fmt(cy),
+            escape_xml(mono),
+            escape_xml(&fg),
+            escape_xml(row.name_label.rendered_text())
+        );
+    }
+    if measure.rows.is_empty() {
+        let _ = write!(
+            out,
+            r#"<text x="0" y="{}" text-anchor="middle" dominant-baseline="central" style="font-family:{};font-size:11px;font-style:italic;fill:{};fill-opacity:0.45">(no attributes)</text>"#,
+            fmt(y + profile::HEADER + profile::ROW / 2.0),
+            escape_xml(mono),
+            escape_xml(&fg)
+        );
+    }
+    out.push_str("</g>");
+}
