diff --git a/src/class/presentation.rs b/src/class/presentation.rs
new file mode 100644
index 0000000..2b8fd06
--- /dev/null
+++ b/src/class/presentation.rs
@@ -0,0 +1,200 @@
+//! Opt-in compartment presentation. Geometry is derived from semantic rows, never labels.
+use crate::text::{TextMeasurer, TextStyle, WrapMode};
+use serde_json::Value;
+
+type Node = merman_core::models::class_diagram::ClassNode;
+
+pub(crate) const HEADER: f64 = 32.0;
+pub(crate) const ROW: f64 = 20.0;
+pub(crate) const PAD: f64 = 8.0;
+
+pub(crate) fn enabled(config: &Value) -> bool {
+    config
+        .pointer("/class/presentationProfile")
+        .and_then(Value::as_str)
+        == Some("compact")
+}
+
+pub(crate) fn member_style(config: &Value) -> TextStyle {
+    TextStyle {
+        font_family: Some(
+            config
+                .pointer("/class/memberFontFamily")
+                .and_then(Value::as_str)
+                .unwrap_or("Menlo, monospace")
+                .to_owned(),
+        ),
+        font_size: 11.0,
+        font_weight: Some("400".into()),
+        font_style: None,
+    }
+}
+
+pub(crate) fn title_style(config: &Value) -> TextStyle {
+    let mut style = super::config::ClassConfigView::new(config).render_text_style(13.0);
+    style.font_weight = Some("500".into());
+    style
+}
+
+pub(crate) fn annotation_style(config: &Value) -> TextStyle {
+    let mut style = title_style(config);
+    style.font_size = 11.0;
+    style.font_weight = Some("400".into());
+    style.font_style = Some("italic".into());
+    style
+}
+
+pub(crate) fn section_height(count: usize) -> f64 {
+    if count == 0 {
+        PAD
+    } else {
+        count as f64 * ROW + PAD
+    }
+}
+
+pub(crate) fn header_height(node: &Node) -> f64 {
+    HEADER.max(title(node).lines().count().max(1) as f64 * 14.0 + 8.0)
+        + node.annotations.len() as f64 * 16.0
+}
+
+pub(crate) fn member_text(member: &merman_core::models::class_diagram::ClassMember) -> String {
+    let visibility = if member.visibility.is_empty() {
+        String::new()
+    } else {
+        format!("{} ", member.visibility)
+    };
+    let id = merman_core::common::parse_generic_types(member.id.trim());
+    let (name, ty) = if member.member_type == "method" {
+        (
+            format!(
+                "{}({})",
+                id,
+                merman_core::common::parse_generic_types(member.parameters.trim())
+            ),
+            merman_core::common::parse_generic_types(member.return_type.trim()),
+        )
+    } else if let Some((ty, name)) = id.split_once(char::is_whitespace) {
+        (name.trim().to_owned(), ty.to_owned())
+    } else {
+        (id, String::new())
+    };
+    format!(
+        "{visibility}{name}{}",
+        if ty.is_empty() {
+            String::new()
+        } else {
+            format!(": {ty}")
+        }
+    )
+}
+
+pub(crate) fn row_style(
+    member: &merman_core::models::class_diagram::ClassMember,
+    config: &Value,
+) -> TextStyle {
+    let mut style = member_style(config);
+    if member.classifier == "*" {
+        style.font_style = Some("italic".into());
+    }
+    style
+}
+
+pub(crate) fn title(node: &Node) -> String {
+    let label = if node.label.is_empty() {
+        &node.id
+    } else {
+        &node.label
+    };
+    let title = if node.type_param.is_empty() {
+        label.clone()
+    } else {
+        format!("{label}<{}>", node.type_param)
+    };
+    crate::text::mermaid_html_breaks_to_newlines(&title).into_owned()
+}
+
+pub(crate) fn dimensions(node: &Node, config: &Value, measurer: &dyn TextMeasurer) -> (f64, f64) {
+    let title_style = title_style(config);
+    let mut width = 120.0_f64.max(
+        measurer
+            .measure_wrapped(&title(node), &title_style, None, WrapMode::SvgLike)
+            .width
+            + PAD * 2.0,
+    );
+    for row in node.members.iter().chain(&node.methods) {
+        width = width.max(
+            measurer
+                .measure_wrapped(
+                    &member_text(row),
+                    &row_style(row, config),
+                    None,
+                    WrapMode::SvgLike,
+                )
+                .width
+                + PAD * 2.0,
+        );
+    }
+    for annotation in &node.annotations {
+        width = width.max(
+            measurer
+                .measure_wrapped(
+                    &format!("<<{annotation}>>"),
+                    &annotation_style(config),
+                    None,
+                    WrapMode::SvgLike,
+                )
+                .width
+                + PAD * 2.0,
+        );
+    }
+    (
+        width,
+        header_height(node)
+            + section_height(node.members.len())
+            + section_height(node.methods.len()),
+    )
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use crate::text::DeterministicTextMeasurer;
+    use serde_json::json;
+
+    #[test]
+    fn compact_compartments_and_role_fonts_are_semantic() {
+        let config = json!({"fontFamily":"Requested Sans", "class":{
+            "presentationProfile":"compact", "memberFontFamily":"Requested Mono"
+        }});
+        assert_eq!(title_style(&config).font_size, 13.0);
+        assert_eq!(title_style(&config).font_weight.as_deref(), Some("500"));
+        assert_eq!(
+            member_style(&config).font_family.as_deref(),
+            Some("Requested Mono")
+        );
+        assert_eq!(member_style(&config).font_size, 11.0);
+        let mut node: Node = serde_json::from_value(json!({
+            "id":"Renamed", "label":"Renamed", "text":"", "domId":"renamed"
+        }))
+        .unwrap();
+        let measurer = DeterministicTextMeasurer::default();
+        assert_eq!(dimensions(&node, &config, &measurer), (120.0, 48.0));
+        let member = serde_json::from_value(json!({
+            "memberType":"method", "visibility":"+", "id":"load", "classifier":"*",
+            "parameters":"List~T~", "returnType":"Result~T~", "displayText":"", "cssStyle":"font-style:italic;"
+        })).unwrap();
+        assert_eq!(member_text(&member), "+ load(List<T>): Result<T>");
+        assert_eq!(
+            row_style(&member, &config).font_style.as_deref(),
+            Some("italic")
+        );
+        node.methods.push(member);
+        assert_eq!(dimensions(&node, &config, &measurer).1, 68.0);
+        node.annotations.push("interface".into());
+        assert_eq!(dimensions(&node, &config, &measurer).1, 84.0);
+        node.label = "Much Longer Generic Label".into();
+        node.type_param = "T".into();
+        assert_eq!(title(&node), "Much Longer Generic Label<T>");
+        assert!(dimensions(&node, &config, &measurer).0 > 120.0);
+    }
+}
