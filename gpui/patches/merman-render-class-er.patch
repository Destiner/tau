new file mode 100644
index 0000000..8d9d93d
--- /dev/null
+++ b/src/er/presentation.rs
@@ -0,0 +1,191 @@
+//! Compact ER compartments, measured with the same role fonts used by the painter.
+use super::{ErBoxLabel, ErEntity, ErEntityMeasure, ErEntityMeasureRow};
+use crate::text::{TextMeasurer, TextStyle, WrapMode};
+use serde_json::Value;
+
+pub(crate) const HEADER: f64 = 34.0;
+pub(crate) const ROW: f64 = 22.0;
+pub(crate) const PAD: f64 = 14.0;
+
+pub(crate) fn enabled(config: &Value) -> bool {
+    config
+        .pointer("/er/presentationProfile")
+        .and_then(Value::as_str)
+        == Some("compact")
+}
+pub(crate) fn relationship_minlen(label: &str) -> usize {
+    // ELK inserts a label layer, with the configured layer gap on both sides.
+    if label.trim().is_empty() { 1 } else { 2 }
+}
+
+pub(crate) fn attr_style(config: &Value) -> TextStyle {
+    TextStyle {
+        font_family: Some(
+            config
+                .pointer("/er/attributeFontFamily")
+                .and_then(Value::as_str)
+                .unwrap_or("Menlo, monospace")
+                .into(),
+        ),
+        font_size: 11.0,
+        font_weight: Some("400".into()),
+        font_style: None,
+    }
+}
+pub(crate) fn key_style(title_style: &TextStyle) -> TextStyle {
+    TextStyle {
+        font_size: 9.0,
+        font_weight: Some("600".into()),
+        ..title_style.clone()
+    }
+}
+pub(crate) fn key_width(text: &str, measurer: &dyn TextMeasurer, title_style: &TextStyle) -> f64 {
+    if text.is_empty() {
+        0.0
+    } else {
+        measurer
+            .measure_wrapped(text, &key_style(title_style), None, WrapMode::SvgLike)
+            .width
+            + 8.0
+    }
+}
+pub(super) fn measure(
+    entity: &ErEntity,
+    measurer: &dyn TextMeasurer,
+    title_style: &TextStyle,
+    attr_style: &TextStyle,
+) -> ErEntityMeasure {
+    let label = ErBoxLabel::from_source(if entity.alias.trim().is_empty() {
+        &entity.label
+    } else {
+        &entity.alias
+    });
+    let label_metrics =
+        measurer.measure_wrapped(label.rendered_text(), title_style, None, WrapMode::SvgLike);
+    let mut width = 140.0_f64.max(label_metrics.width + PAD * 2.0);
+    let mut rows = Vec::with_capacity(entity.attributes.len());
+    for attr in &entity.attributes {
+        let type_label = ErBoxLabel::from_source(&attr.ty);
+        let name_label = ErBoxLabel::from_source(&attr.name);
+        let key_label = ErBoxLabel::from_source(&attr.keys.join(","));
+        let type_width = measurer
+            .measure_wrapped(
+                type_label.rendered_text(),
+                attr_style,
+                None,
+                WrapMode::SvgLike,
+            )
+            .width;
+        let name_width = measurer
+            .measure_wrapped(
+                name_label.rendered_text(),
+                attr_style,
+                None,
+                WrapMode::SvgLike,
+            )
+            .width;
+        let badge_width = key_width(key_label.rendered_text(), measurer, title_style);
+        width = width.max(
+            type_width
+                + name_width
+                + PAD * 2.0
+                + if badge_width > 0.0 {
+                    badge_width + 6.0
+                } else {
+                    0.0
+                },
+        );
+        rows.push(ErEntityMeasureRow {
+            type_label,
+            name_label,
+            key_label,
+            comment_label: ErBoxLabel::from_source(&attr.comment),
+            height: ROW,
+        });
+    }
+    ErEntityMeasure {
+        width,
+        height: HEADER + entity.attributes.len().max(1) as f64 * ROW,
+        text_padding: PAD,
+        label,
+        label_html_width: label_metrics.width,
+        label_height: HEADER,
+        label_max_width_px: width.ceil() as i64,
+        has_key: false,
+        has_comment: false,
+        type_col_w: 0.0,
+        name_col_w: 0.0,
+        key_col_w: 0.0,
+        comment_col_w: 0.0,
+        rows,
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use crate::er::ErConfigView;
+    use crate::text::DeterministicTextMeasurer;
+    use serde_json::json;
+
+    #[test]
+    fn compact_roles_and_compartments_follow_semantics() {
+        let config = json!({"fontFamily":"Requested Sans", "er":{
+            "presentationProfile":"compact", "attributeFontFamily":"Requested Mono"
+        }});
+        let settings = ErConfigView::new(&config).render_settings();
+        assert_eq!(settings.label_style.font_size, 13.0);
+        assert_eq!(settings.label_style.font_weight.as_deref(), Some("500"));
+        assert_eq!(
+            settings.attr_style.font_family.as_deref(),
+            Some("Requested Mono")
+        );
+        assert_eq!(settings.attr_style.font_size, 11.0);
+        assert_eq!(key_style(&settings.label_style).font_size, 9.0);
+        let measurer = DeterministicTextMeasurer::default();
+        let mut entity = ErEntity {
+            label: "Renamed".into(),
+            ..Default::default()
+        };
+        assert_eq!(
+            measure(
+                &entity,
+                &measurer,
+                &settings.label_style,
+                &settings.attr_style
+            )
+            .height,
+            56.0
+        );
+        for count in 1..=5 {
+            entity
+                .attributes
+                .push(merman_core::diagrams::er::ErAttributeRenderModel {
+                    ty: "string".into(),
+                    name: "attribute".into(),
+                    keys: vec!["PK".into(), "FK".into()],
+                    comment: "retained".into(),
+                });
+            let measured = measure(
+                &entity,
+                &measurer,
+                &settings.label_style,
+                &settings.attr_style,
+            );
+            assert_eq!(measured.height, HEADER + count as f64 * ROW);
+            assert!(measured.width >= 140.0);
+            assert_eq!(measured.rows[0].key_label.rendered_text(), "PK,FK");
+            assert_eq!(measured.rows[0].comment_label.rendered_text(), "retained");
+        }
+    }
+
+    #[test]
+    fn labelled_relationships_reserve_two_gaps_without_matching_fixture_text() {
+        for label in ["contains", "renamed", "longer relationship label", "多言語"] {
+            assert_eq!(relationship_minlen(label), 2);
+        }
+        for label in ["", "  ", "\n"] {
+            assert_eq!(relationship_minlen(label), 1);
+        }
+    }
+}
