diff --git a/src/svg/parity/class/presentation.rs b/src/svg/parity/class/presentation.rs
new file mode 100644
index 0000000..e1727b1
--- /dev/null
+++ b/src/svg/parity/class/presentation.rs
@@ -0,0 +1,124 @@
+use super::super::*;
+use crate::class::presentation as profile;
+
+pub(super) fn body(
+    out: &mut String,
+    node: &super::ClassSvgNode,
+    width: f64,
+    height: f64,
+    config: &serde_json::Value,
+) {
+    let x = -width / 2.0;
+    let y = -height / 2.0;
+    let header = profile::header_height(node);
+    let title_style = profile::title_style(config);
+    let member_style = profile::member_style(config);
+    let fg = theme_token(config, "textColor", "#333333");
+    let title_family = title_style.font_family.as_deref().unwrap_or("sans-serif");
+    let mono = member_style.font_family.as_deref().unwrap_or("monospace");
+    let _ = write!(
+        out,
+        r#"<g class="compact-class" fill="{}"><rect x="{}" y="{}" width="{}" height="{}" style="fill:{};fill-opacity:0.05;stroke:none"/>"#,
+        escape_xml(&fg),
+        fmt(x),
+        fmt(y),
+        fmt(width),
+        fmt(header),
+        escape_xml(&fg)
+    );
+    for divider in [
+        y + header,
+        y + header + profile::section_height(node.members.len()),
+    ] {
+        let _ = write!(
+            out,
+            r#"<line x1="{}" x2="{}" y1="{}" y2="{}" style="stroke:{};stroke-opacity:0.12;stroke-width:1"/>"#,
+            fmt(x),
+            fmt(-x),
+            fmt(divider),
+            fmt(divider),
+            escape_xml(&fg)
+        );
+    }
+    let title = profile::title(node);
+    let lines: Vec<_> = title.lines().collect();
+    let title_y = y + header / 2.0 + node.annotations.len() as f64 * 6.0;
+    let _ = write!(
+        out,
+        r#"<text x="0" y="{}" text-anchor="middle" dominant-baseline="central" style="font-family:{};font-size:13px;font-weight:500;fill:{}">"#,
+        fmt(title_y),
+        escape_xml(title_family),
+        escape_xml(&fg)
+    );
+    if lines.len() <= 1 {
+        out.push_str(&escape_xml(&title));
+    } else {
+        for (i, line) in lines.iter().enumerate() {
+            let _ = write!(
+                out,
+                r#"<tspan x="0" y="{}">{}</tspan>"#,
+                fmt(title_y + (i as f64 - (lines.len() - 1) as f64 / 2.0) * 14.0),
+                escape_xml(line)
+            );
+        }
+    }
+    out.push_str("</text>");
+    for (i, annotation) in node.annotations.iter().enumerate() {
+        let _ = write!(
+            out,
+            r#"<text x="0" y="{}" text-anchor="middle" dominant-baseline="central" style="font-family:{};font-size:11px;font-weight:400;font-style:italic;fill:{};fill-opacity:0.6">{}</text>"#,
+            fmt(y + 12.0 + i as f64 * 16.0),
+            escape_xml(title_family),
+            escape_xml(&fg),
+            escape_xml(&format!("<<{annotation}>>"))
+        );
+    }
+    for (rows, top) in [
+        (&node.members, y + header),
+        (
+            &node.methods,
+            y + header + profile::section_height(node.members.len()),
+        ),
+    ] {
+        for (i, row) in rows.iter().enumerate() {
+            let _ = write!(
+                out,
+                r#"<text x="{}" y="{}" dominant-baseline="central" style="font-family:{};font-size:11px;font-weight:400;fill:{};fill-opacity:0.6;{}">{}</text>"#,
+                fmt(x + profile::PAD),
+                fmt(top + profile::PAD / 2.0 + profile::ROW * (i as f64 + 0.5)),
+                escape_xml(mono),
+                escape_xml(&fg),
+                escape_xml(&row.css_style),
+                escape_xml(&profile::member_text(row))
+            );
+        }
+    }
+    out.push_str("</g>");
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use serde_json::json;
+
+    #[test]
+    fn multiline_titles_are_drawn_as_independently_positioned_lines() {
+        let node = serde_json::from_value(json!({
+            "id":"Alias", "label":"First<br>Second", "text":"", "domId":"alias"
+        }))
+        .unwrap();
+        let mut svg = String::new();
+        body(
+            &mut svg,
+            &node,
+            120.0,
+            52.0,
+            &json!({"fontFamily":"Requested Sans"}),
+        );
+        assert_eq!(svg.matches("<tspan").count(), 2);
+        assert!(svg.contains(">First</tspan>"));
+        assert!(svg.contains(">Second</tspan>"));
+        assert!(!svg.contains("&lt;br"));
+        assert!(svg.contains("font-family:Requested Sans;font-size:13px;font-weight:500"));
+    }
+}
