+    struct LongLeadingView {
+        text: String,
+        fractional: bool,
+        layout: std::rc::Rc<std::cell::RefCell<Option<gpui::TextLayout>>>,
+    }
+
+    impl Render for LongLeadingView {
+        fn render(&mut self, _: &mut Window, _: &mut Context<Self>) -> impl IntoElement {
+            let text = SelectableText::new("long-leading", self.text.clone()).text_style(
+                gpui::TextStyleRefinement {
+                    fractional_line_height: Some(self.fractional),
+                    ..Default::default()
+                },
+            );
+            *self.layout.borrow_mut() = Some(text.styled_text.layout().clone());
+            div().size_full().child(TextSelectionLayer).child(
+                div()
+                    .w(px(480.))
+                    .text_size(px(12.))
+                    .line_height(gpui::relative(1.65))
+                    .child(text),
+            )
+        }
+    }
+
+    #[gpui::test]
+    fn fractional_leading_selection_hit_tests_hundreds_of_rendered_lines(cx: &mut TestAppContext) {
+        let text: String = (0..300).map(|row| format!("row {row:03}\n")).collect();
+        for (fractional, height) in [(false, 20.), (true, 19.8)] {
+            let layout = std::rc::Rc::new(std::cell::RefCell::new(None));
+            let (_, view) = cx.add_window_view(|_, _| LongLeadingView {
+                text: text.clone(),
+                fractional,
+                layout: layout.clone(),
+            });
+            view.update(|window, cx| {
+                let _ = window.draw(cx);
+            });
+            let layout = layout
+                .borrow()
+                .clone()
+                .expect("rendered SelectableText layout");
+            assert!((f32::from(layout.line_height()) - height).abs() < 0.001);
+            let origin = layout.position_for_index(0).unwrap();
+            for row in [1, 25, 100, 200, 299] {
+                let index = row * 8;
+                let caret = layout.position_for_index(index).unwrap();
+                assert!((f32::from(caret.y - origin.y) - row as f32 * height).abs() < 0.02);
+                assert_eq!(
+                    layout.index_for_position(point(caret.x + px(1.), caret.y + px(height / 2.))),
+                    Ok(index)
+                );
+            }
+            let start = 1;
+            let end = 20;
+            let at = |row| point(px(1.), px(row as f32 * height + height / 2.));
+            view.simulate_mouse_down(at(start), MouseButton::Left, Modifiers::default());
+            view.simulate_mouse_move(at(end), Some(MouseButton::Left), Modifiers::default());
+            view.simulate_mouse_up(at(end), MouseButton::Left, Modifiers::default());
+            view.update(|window, cx| {
+                let _ = window.draw(cx);
+                assert_eq!(
+                    TextSelection::selected_text(window, cx),
+                    &text[start * 8..end * 8]
+                );
+            });
+        }
+    }
+
