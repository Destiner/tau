 const BOTTOM_MARGIN_ROWS: usize = 3;
 pub(super) const RIGHT_MARGIN: Pixels = px(10.);
+
+// Plain textareas wrap at the full content width; editors and single-line inputs
+// keep clearance for the caret and editor affordances.
+pub(super) fn right_margin_for_mode<M: InputModeKind>(state: &InputBaseState<M>) -> Pixels {
+    if state.is_multi_line() && !state.is_code_editor() {
+        px(0.)
+    } else {
+        RIGHT_MARGIN
+    }
+}
+
+fn text_wrap_width(content_width: Pixels, line_number_width: Pixels, margin: Pixels) -> Pixels {
+    (content_width - line_number_width - margin).max(px(1.))
+}
