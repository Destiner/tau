+    fn test_textarea_end_keeps_visual_column_for_down_and_up(cx: &mut TestAppContext) {
+        let view =
+            InputView::build_textarea(cx, |state| state.default_value("0123456789".repeat(120)));
+        let mut cx = VisualTestContext::from_window(view.window_handle.into(), cx);
+        cx.run_until_parked();
+        cx.update(|window, cx| {
+            view.input.update(cx, |state, cx| {
+                let rows = &state.display_map.line(0).unwrap().wrapped_lines;
+                assert!(rows.len() >= 3);
+                let first_end = rows[0].end;
+                let second_end = rows[1].end;
+                let third_end = rows[2].end;
+                assert!(first_end < second_end && second_end < third_end);
+
+                state.move_to(2, None, cx);
+                state.end(&MoveEnd, window, cx);
+                assert_eq!(state.cursor(), first_end);
+                assert!(state.cursor_line_end_affinity);
+                state.down(&MoveDown, window, cx);
+                assert_eq!(state.cursor(), second_end);
+                state.up(&MoveUp, window, cx);
+                assert_eq!(state.cursor(), first_end);
+                state.down(&MoveDown, window, cx);
+                assert_eq!(state.cursor(), second_end);
+                state.down(&MoveDown, window, cx);
+                assert_eq!(state.cursor(), third_end);
+            });
+        });
+    }
