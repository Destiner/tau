+    #[gpui::test]
+    fn padded_inline_code_drag_selects_across_code_boundaries(cx: &mut TestAppContext) {
+        struct Root {
+            text: Entity<TextViewState>,
+        }
+        impl Render for Root {
+            fn render(&mut self, _: &mut Window, _: &mut Context<Self>) -> impl IntoElement {
+                div().w(px(210.)).child(crate::TextSelectionLayer).child(
+                    TextView::new(&self.text)
+                        .selectable(true)
+                        .style(TextViewStyle::default().with_inline_code_padding(px(8.))),
+                )
+            }
+        }
+        cx.update(crate::init);
+        let (root, cx) = cx.add_window_view(|_, cx| Root {
+            text: cx.new(|cx| TextViewState::markdown("before `code` after", cx)),
+        });
+        let cx: &mut VisualTestContext = cx;
+        cx.run_until_parked();
+        cx.simulate_mouse_down(
+            point(px(2.), px(8.)),
+            MouseButton::Left,
+            Modifiers::default(),
+        );
+        cx.update(|window, cx| {
+            let _ = window.draw(cx);
+        });
+        cx.simulate_mouse_move(
+            point(px(205.), px(8.)),
+            Some(MouseButton::Left),
+            Modifiers::default(),
+        );
+        cx.update(|window, cx| {
+            let _ = window.draw(cx);
+        });
+        cx.simulate_mouse_up(
+            point(px(205.), px(8.)),
+            MouseButton::Left,
+            Modifiers::default(),
+        );
+        cx.update(|window, cx| {
+            let _ = window.draw(cx);
+        });
+        let selected = root.read_with(cx, |root, cx| root.text.read(cx).selected_text());
+        assert_eq!(selected.trim(), "before code after");
+    }
