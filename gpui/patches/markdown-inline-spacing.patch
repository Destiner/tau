     #[test]
+    fn opt_in_inline_code_padding_reserves_wrap_and_paint_width() {
+        use super::super::inline::test_fonts::{BODY, MONO, WideMonoTextSystem};
+        use gpui::{Empty, TestApp};
+
+        let mut app = TestApp::with_text_system(Arc::new(WideMonoTextSystem));
+        let mut window = app.open_window(|_, _| Empty);
+        let style = TextStyle {
+            font_family: BODY.into(),
+            font_size: AbsoluteLength::Pixels(px(16.)),
+            ..Default::default()
+        };
+        let items = [MeasureItem::Text {
+            text: "a code z".into(),
+            links: vec![],
+            highlights: vec![(
+                2..6,
+                InlineHighlight {
+                    font_family: Some(MONO.into()),
+                    font_size_scale: Some(0.875),
+                    ..Default::default()
+                },
+            )],
+        }];
+        window.update(|_, window, cx| {
+            let original = layout_flow(&items, &[None], &style, None, window, cx);
+            let padded =
+                layout_flow_with_padding(&items, &[None], &style, None, px(8.), window, cx);
+            assert_eq!(padded.size.width - original.size.width, px(12.));
+            let code_width = |layout: &InlineFlowLayout| {
+                layout
+                    .fragments
+                    .iter()
+                    .find_map(|fragment| match fragment {
+                        PositionedFragment::Text { text, size, .. } if text.as_ref() == "code" => {
+                            Some(size.width)
+                        }
+                        _ => None,
+                    })
+                    .expect("code fragment")
+            };
+            assert_eq!(code_width(&padded) - code_width(&original), px(12.));
+            let narrow = original.size.width - px(3.);
+            let wrapped =
+                layout_flow_with_padding(&items, &[None], &style, Some(narrow), px(8.), window, cx);
+            assert!(wrapped.size.height > padded.size.height);
+            assert_eq!(
+                layout_flow(&items, &[None], &style, None, window, cx).size,
+                original.size
+            );
+        });
+    }
