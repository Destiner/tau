+    #[test]
+    fn inline_code_padding_changes_painted_wrap_without_changing_selection_or_defaults() {
+        use gpui::TestApp;
+
+        const SOURCE: &str = "Before `code` after and another `token` at the edge";
+        struct Root {
+            default: Entity<TextViewState>,
+            padded: Entity<TextViewState>,
+        }
+        impl Render for Root {
+            fn render(&mut self, _: &mut Window, _: &mut Context<Self>) -> impl IntoElement {
+                div()
+                    .w(px(165.))
+                    .text_size(px(13.))
+                    .child(crate::TextSelectionLayer)
+                    .child(TextView::new(&self.default).selectable(true))
+                    .child(
+                        TextView::new(&self.padded)
+                            .selectable(true)
+                            .style(TextViewStyle::default().with_inline_code_padding(px(8.))),
+                    )
+            }
+        }
+        let mut app = TestApp::new();
+        app.update(crate::init);
+        let mut window = app.open_window(|_, cx| Root {
+            default: cx.new(|cx| TextViewState::markdown(SOURCE, cx)),
+            padded: cx.new(|cx| TextViewState::markdown(SOURCE, cx)),
+        });
+        window.draw();
+        app.run_until_parked();
+        window.draw();
+        window.read(|root, cx| {
+            let lines =
+                |view: &Entity<TextViewState>| view.read(cx).selection_adapter.text_bounds().len();
+            assert!(lines(&root.padded) >= lines(&root.default));
+            assert_eq!(TextViewStyle::default().inline_code_padding(), px(2.));
+        });
+        window.update(|root, _, cx| {
+            root.default.update(cx, |state, cx| state.select_all(cx));
+            root.padded.update(cx, |state, cx| state.select_all(cx));
+        });
+        window.draw();
+        window.read(|root, cx| {
+            let plain = root.default.read(cx);
+            let padded = root.padded.read(cx);
+            assert_eq!(
+                plain.rendered_text().as_str(),
+                padded.rendered_text().as_str()
+            );
+            assert_eq!(plain.selected_text(), padded.selected_text());
+            assert_eq!(
+                padded.selected_text().trim(),
+                "Before code after and another token at the edge"
+            );
+        });
+    }
