+                <= 0.51
+        );
+        let size_shift = (body * task.size_em - f32::from(task.loose_size)) / 2.;
+        assert!(
+            (f32::from(positions[1].top() - positions[0].top()) - body * 0.28 - size_shift).abs()
+                <= 0.51
+        );
+    }
+}
