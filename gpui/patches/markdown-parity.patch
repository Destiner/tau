+    pub(crate) fn block_margins(
+        &self,
+        style: &TextViewStyle,
+        body: Pixels,
+        rem_size: Pixels,
+        after_heading: bool,
+    ) -> (Pixels, Pixels) {
+        let Some(policy) = style.block_spacing() else {
+            return (Pixels::ZERO, Pixels::ZERO);
+        };
+        match self {
+            Self::Heading { level, .. } => {
+                let size = style
+                    .heading(*level)
+                    .text
+                    .font_size
+                    .map(|size| size.to_pixels(rem_size))
+                    .unwrap_or_else(|| {
+                        Self::heading_defaults(*level)
+                            .0
+                            .to_pixels(style.body_text_size().unwrap_or(px(14.)))
+                    });
+                (
+                    size * if after_heading {
+                        policy.consecutive_heading_top
+                    } else {
+                        policy.heading_top
+                    },
+                    size * policy.heading_bottom,
+                )
+            }
+            Self::HorizontalRule { .. } => (body * policy.rule, body * policy.rule),
+            Self::Definition { .. } | Self::Unknown | Self::Break { .. } => {
+                (Pixels::ZERO, Pixels::ZERO)
+            }
+            _ => (body * policy.paragraph, body * policy.paragraph),
+        }
+    }
+
+    /// A left border does not contain vertical margins. The first descendant's
+    /// margin collapses through a quote even when the document resets the quote.
+    pub(crate) fn collapsed_boundary_top(
+        &self,
+        style: &TextViewStyle,
+        body: Pixels,
+        rem: Pixels,
+    ) -> Pixels {
+        match self {
+            Self::CodeBlock(_) => body * style.block_spacing().map_or(0., |p| p.first_code_top),
+            Self::List { children, .. } => children.first().map_or(Pixels::ZERO, |first| {
+                if let Self::ListItem {
+                    children,
+                    spread: true,
+                    ..
+                } = first
+                    && matches!(children.first(), Some(Self::Paragraph(_)))
+                {
+                    body * style
+                        .block_spacing()
+                        .map_or(0., |p| p.loose_list_continuation)
+                } else {
+                    Pixels::ZERO
+                }
+            }),
+            Self::Blockquote { children, .. } => children.first().map_or(Pixels::ZERO, |first| {
+                first
+                    .block_margins(style, body, rem, false)
+                    .0
+                    .max(first.collapsed_boundary_top(style, body, rem))
+            }),
+            _ => Pixels::ZERO,
+        }
+    }
