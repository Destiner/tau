+use super::{
+    MarkdownBlockSpacing, MarkdownExtensions, MarkdownTaskCheckbox, TextView, TextViewState,
+    TextViewStyle,
+    document::NodeRenderOptions,
+    format::markdown,
+    node::{BlockNode, NodeContext},
+};
+use gpui::{
+    AppContext as _, Context, Entity, IntoElement, ParentElement as _, Render, Styled as _, Window,
+    div, px,
+};
+
+fn profile(body: f32) -> TextViewStyle {
+    TextViewStyle::default()
+        .with_body_text_size(px(body))
+        .with_block_spacing(MarkdownBlockSpacing::default())
+        .with_list_style(px(body * 1.4), px(0.), gpui::black())
+        .with_task_checkbox(MarkdownTaskCheckbox {
+            size_em: 0.95,
+            gap_em: 0.45,
+            offset_em: 0.1,
+            radius: px(3.),
+            border: gpui::rgb(0xcccccc).into(),
+            background: gpui::white(),
+            checked_background: gpui::rgb(0xeeeeee).into(),
+            ..Default::default()
+        })
+}
+
+#[test]
+fn parity_first_code_top_is_opt_in_and_does_not_shift_prose() {
+    for body in [11., 13.] {
+        let default = profile(body);
+        let enabled = default.clone().with_block_spacing(MarkdownBlockSpacing {
+            first_code_top: 0.7,
+            ..Default::default()
+        });
+        for source in [
+            "```text\ncode\n```",
+            "```mermaid\ngraph TD; A-->B\n```",
+            "    code",
+        ] {
+            let doc = markdown::parse(source, &mut NodeContext::default()).unwrap();
+            let code = &doc.blocks[0];
+            assert_eq!(
+                code.collapsed_boundary_top(&default, px(body), px(16.)),
+                px(0.)
+            );
+            assert_eq!(
+                code.collapsed_boundary_top(&enabled, px(body), px(16.)),
+                px(body * 0.7)
+            );
+        }
+        let prose = markdown::parse("first paragraph", &mut NodeContext::default()).unwrap();
+        assert_eq!(
+            prose.blocks[0].collapsed_boundary_top(&enabled, px(body), px(16.)),
+            px(0.)
+        );
+        assert!(default != enabled);
+    }
+}
+
+#[test]
+fn parity_task_profile_keeps_disabled_opacity_and_ua_geometry_per_item() {
+    let task = MarkdownTaskCheckbox::default();
+    assert_eq!(task.loose_opacity, 0.45);
+    assert_eq!(task.opacity(false), 1.);
+    assert_eq!(task.opacity(true), 0.45);
+    for body in [11., 13., 17.] {
+        let (size, inset, gap) = task.geometry(px(body), false);
+        assert_eq!(size, px(body * 0.95));
+        assert_eq!(inset, px(0.));
+        assert_eq!(gap, px(body * 0.45) + px(body * 0.25));
+        let (size, inset, gap) = task.geometry(px(body), true);
+        assert_eq!(size, px(12.));
+        assert_eq!(inset, px(2.));
+        assert_eq!(gap, px(3.) + px(body * 0.25));
+    }
+    let custom = MarkdownTaskCheckbox {
+        size_em: 0.8,
+        gap_em: 0.6,
+        space_em: 0.3,
+        loose_size: px(12.),
+        loose_inset: px(4.),
+        loose_gap: px(5.),
+        loose_opacity: 0.7,
+        ..task
+    };
+    assert_eq!(custom.geometry(px(10.), false), (px(8.), px(0.), px(9.)));
+    assert_eq!(custom.geometry(px(10.), true), (px(12.), px(4.), px(8.)));
+    assert_eq!(custom.opacity(true), 0.7);
+    assert_eq!(custom.opacity(false), 1.);
+    assert!(TextViewStyle::default().task_checkbox().is_none());
+    assert!(profile(13.) != profile(13.).with_task_checkbox(custom));
+}
