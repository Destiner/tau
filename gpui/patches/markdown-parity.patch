+    let (first, last) = root.read_with(window, |root, cx| {
+        let lines = root.text.read(cx).selection_adapter.text_bounds();
+        let styled = root.loose.read(cx).selection_adapter.text_bounds();
+        let original = root.baseline.read(cx).selection_adapter.text_bounds();
+        assert_eq!(styled.len(), 3);
