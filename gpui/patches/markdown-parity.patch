+            3 => (rems(1.25), FontWeight::SEMIBOLD),
+            4 => (rems(1.125), FontWeight::SEMIBOLD),
+            5 => (rems(1.), FontWeight::SEMIBOLD),
+            6 => (rems(1.), FontWeight::MEDIUM),
+            _ => (rems(1.), FontWeight::NORMAL),
+        }
+    }
