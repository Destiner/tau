+#[cfg(target_os = "macos")]
+fn main() {
+    use gpui::{
+        AppContext as _, Context, Entity, FontWeight, IntoElement, ParentElement as _, Render,
+        Styled as _, Window, div, px,
+    };
+    use gpui_base::{
+        MarkdownBlockSpacing, MarkdownExtensions, SelectionFormat, TextView, TextViewState,
+        TextViewStyle,
+    };
+
+    struct Root {
+        state: Entity<TextViewState>,
+        body: f32,
+        width: f32,
+        custom: bool,
+    }
+    impl Render for Root {
+        fn render(&mut self, _: &mut Window, _: &mut Context<Self>) -> impl IntoElement {
+            let style = TextViewStyle::default()
+                .with_body_text_size(px(self.body))
+                .with_block_spacing(MarkdownBlockSpacing {
+                    first_code_top: 0.7,
+                    ..Default::default()
+                })
+                .with_task_checkbox(Default::default())
+                .with_table_css_cells(true)
+                .with_table_fit_content(true)
+                .with_table({
+                    let mut s = gpui::StyleRefinement::default().text_size(px(self.body * 0.94));
+                    s.overflow.x = Some(gpui::Overflow::Scroll);
+                    s
+                })
+                .with_table_head(gpui::StyleRefinement::default().font_weight(FontWeight::SEMIBOLD))
+                .with_table_cell(
+                    gpui::StyleRefinement::default()
+                        .py(px(6.))
+                        .line_height(gpui::relative(1.62)),
+                );
+            let extensions = if self.custom {
+                MarkdownExtensions::default()
+                    .code_block_body_renderer(|_, _, _| Some(div().h(px(40.)).into_any_element()))
+            } else {
+                MarkdownExtensions::default()
+            };
+            div()
+                .w(px(self.width))
+                .font_family(".AppleSystemUIFont")
+                .text_size(px(self.body))
+                .line_height(gpui::relative(1.62))
+                .child(
+                    TextView::new(&self.state)
+                        .selectable(true)
+                        .selection_format(SelectionFormat::Source)
+                        .markdown_extensions(extensions)
+                        .style(style),
+                )
+        }
+    }
+    let platform = gpui_platform::current_platform(true);
+    let mut cx = gpui::TestAppContext::build_with_text_system(
+        gpui::TestDispatcher::new(0),
+        Some("markdown_layout_native"),
+        platform.text_system(),
+    );
+    cx.update(gpui_base::init);
+    check_task_marker_geometry(&mut cx);
+    for body in [13., 11.] {
+        for width in [180., 280.] {
+            let source = "| Name | Description |\n| --- | --- |\n| Alpha | A long unwrapped cell with several words |\n| Beta | Another cell |";
+            let (root, window) = cx.add_window_view(|_, cx| Root {
+                body,
+                width,
+                custom: false,
+                state: cx.new(|cx| TextViewState::markdown(source, cx)),
+            });
+            let window: &mut gpui::VisualTestContext = window;
+            window.run_until_parked();
+            window.update(|w, cx| {
+                let _ = w.draw(cx);
+            });
+            let name = window.debug_bounds("css-cell-text-0-0").unwrap();
+            let cell = window.debug_bounds("css-cell-0-0").unwrap();
+            window.update(|w, _| {
+                let typography = gpui::TextStyle { font_family: ".AppleSystemUIFont".into(), font_weight: FontWeight::SEMIBOLD, ..Default::default() };
+                let text_system = w.text_system();
+                let shaped = text_system.layout_line("Name", px(body * 0.94), &[typography.to_run(4)], None).width;
+                let mut wrapper = text_system.line_wrapper(typography.font(), px(body * 0.94));
+                let fragments = [gpui::LineFragment::text("Name")];
+                let breaks = wrapper.wrap_line(&fragments, name.size.width).count();
+                let isolated: gpui::Pixels = "Name".chars().map(|c| text_system.layout_line(&c.to_string(), px(body * 0.94), &[typography.to_run(c.len_utf8())], None).width).sum();
+                println!("Name {body}/{width}: shaped={shaped:?}, isolated={isolated:?}, available={:?}, generic-wrapper-breaks={breaks}", name.size.width);
+                assert!(shaped <= name.size.width, "outward-rounded floor fits the shaped semibold word");
+            });
+            assert!(
+                (f32::from(name.size.height) - body * 0.94 * 1.62).abs() < 1.,
+                "Name must be one line at {body}/{width}: {name:?}"
+            );
+            assert!(name.left() >= cell.left() + px(11.9));
+            assert!(name.right() <= cell.right() - px(11.9));
+            root.update(window, |r, cx| r.state.update(cx, |s, cx| s.select_all(cx)));
+            root.read_with(window, |r, cx| {
+                assert_eq!(r.state.read(cx).selected_text().trim_end(), source)
+            });
+        }
+        {
+            let word = "UnbreakableColumnNameThatMustScrollNormally";
+            let source = format!("| {word} | Other |\n| --- | --- |\n| x | y |");
+            let (_, window) = cx.add_window_view(|_, cx| Root {
+                body,
+                width: 180.,
+                custom: false,
+                state: cx.new(|cx| TextViewState::markdown(&source, cx)),
+            });
+            let window: &mut gpui::VisualTestContext = window;
+            window.run_until_parked();
+            window.update(|w, cx| {
+                let _ = w.draw(cx);
+            });
+            let text = window.debug_bounds("css-cell-text-0-0").unwrap();
+            assert!(
+                (f32::from(text.size.height) - body * 0.94 * 1.62).abs() < 1.,
+                "unbreakable word must not emergency-wrap"
+            );
+            assert!(
+                text.right() > px(180.),
+                "min-content columns may scroll rather than clipping words"
+            );
+        }
+        {
+            let source =
+                "Before\n\n- first\n\n  continuation\n\n- last\n\n1. next\n\n   details\n\n2. end";
+            let (_, window) = cx.add_window_view(|_, cx| Root {
+                body,
+                width: 280.,
+                custom: false,
+                state: cx.new(|cx| TextViewState::markdown(source, cx)),
+            });
+            let window: &mut gpui::VisualTestContext = window;
+            window.run_until_parked();
+            window.update(|w, cx| {
+                let _ = w.draw(cx);
+            });
+            let first = window.debug_bounds("css-list-0-1").unwrap();
+            let next = window.debug_bounds("css-list-0-2").unwrap();
+            assert!(
+                (f32::from(first.top()) - body * (1.62 + 0.7)).abs() < 1.5,
+                "first paragraph margin collapses into block gap"
+            );
+            assert!(
+                (f32::from(next.top() - first.bottom()) - body * 0.7).abs() < 1.,
+                "last/first paragraphs collapse through neighboring list boundaries"
+            );
+        }
+        for (source, custom) in [
+            ("```text\ncode\n```", false),
+            ("```mermaid\ngraph TD; A-->B\n```", true),
+        ] {
+            let (_, window) = cx.add_window_view(|_, cx| Root {
+                body,
+                width: 280.,
+                custom,
+                state: cx.new(|cx| TextViewState::markdown(source, cx)),
+            });
+            let window: &mut gpui::VisualTestContext = window;
+            window.run_until_parked();
+            window.update(|w, cx| {
+                let _ = w.draw(cx);
+            });
+            let content = window.debug_bounds("parity-content-0").unwrap();
+            assert!(
+                (f32::from(content.top()) - body * 0.7).abs() < 1.,
+                "first code/custom body margin: {body} {content:?}"
+            );
+        }
+        for (source, lines) in [
+            ("- first\n\n  continuation\n\n- last", 3.),
+            ("1. first\n\n   continuation\n\n2. last", 3.),
+            (
+                "- [x] Done\n\n  Details for done.\n\n  - Nested item\n  - [ ] Nested task\n\n- [ ] Pending",
+                5.,
+            ),
+        ] {
+            let (_, window) = cx.add_window_view(|_, cx| Root {
+                body,
+                width: 280.,
+                custom: false,
+                state: cx.new(|cx| TextViewState::markdown(source, cx)),
+            });
+            let window: &mut gpui::VisualTestContext = window;
+            window.run_until_parked();
+            window.update(|w, cx| {
+                let _ = w.draw(cx);
+            });
+            let content = window.debug_bounds("css-list-0-0").unwrap();
+            assert!(
+                (f32::from(content.top()) - body * 0.28).abs() < 1.,
+                "loose first boundary: {content:?}"
+            );
+            let expected = body * (lines * 1.62 + (lines - 1.) * 0.28);
+            assert!(
+                (f32::from(content.size.height) - expected).abs() < 1.5,
+                "loose margins collapse: {body} {content:?} expected {expected}"
+            );
+        }
+    }
+    println!(
+        "native Markdown profile: 13px/11px real-font table, list, code/custom-body geometry and source selection passed"
+    );
+}
+
+#[cfg(target_os = "macos")]
+fn check_task_marker_geometry(cx: &mut gpui::TestAppContext) {
+    use gpui::{
+        AppContext as _, Context, Entity, IntoElement, ParentElement as _, Render, Styled as _,
+        Window, div, px,
+    };
+    use gpui_base::{
+        MarkdownTaskCheckbox, SelectionFormat, TextView, TextViewState, TextViewStyle,
+    };
+
+    struct TaskRoot {
+        state: Entity<TextViewState>,
+        body: f32,
+        dark: bool,
+        offset: f32,
+    }
+    impl Render for TaskRoot {
+        fn render(&mut self, _: &mut Window, _: &mut Context<Self>) -> impl IntoElement {
+            let task = MarkdownTaskCheckbox {
+                offset_em: self.offset,
+                border: gpui::rgb(if self.dark { 0x5c5c5c } else { 0xbebebe }).into(),
+                background: gpui::rgb(if self.dark { 0x1e1e1e } else { 0xffffff }).into(),
+                checked_background: gpui::rgb(if self.dark { 0x846837 } else { 0xf8c98b }).into(),
+                ..Default::default()
+            };
+            div()
+                .w(px(280.))
+                .font_family(".AppleSystemUIFont")
+                .text_size(px(self.body))
+                .line_height(gpui::relative(1.62))
+                .child(
+                    TextView::new(&self.state)
+                        .selectable(true)
+                        .selection_format(SelectionFormat::Source)
+                        .style(
+                            TextViewStyle::default()
+                                .with_body_text_size(px(self.body))
+                                .with_dark(self.dark)
+                                .with_list_style(
+                                    px(self.body * 1.4),
+                                    px(self.body * 0.28),
+                                    gpui::black(),
+                                )
+                                .with_task_checkbox(task),
+                        ),
+                )
+        }
+    }
+    for body in [13., 11.] {
+        for scale in [2., 1.] {
+            for dark in [false, true] {
+                for source in [
+                    "- [x] Checked\n- [ ] Unchecked\n  - [x] Nested checked\n  - [ ] Nested unchecked",
+                    "- [x] Checked\n\n  Details\n\n- [ ] Unchecked\n\n  Details\n\n  - [x] Nested checked\n\n    Details\n\n  - [ ] Nested unchecked",
+                ] {
+                    let (root, window) = cx.add_window_view(|_, cx| TaskRoot {
+                        state: cx.new(|cx| TextViewState::markdown(source, cx)),
+                        body,
+                        dark,
+                        offset: 0.1,
+                    });
+                    let window: &mut gpui::VisualTestContext = window;
+                    window.update(|w, _| w.set_scale_factor(scale));
+                    window.run_until_parked();
+                    window.update(|w, cx| {
+                        let _ = w.draw(cx);
+                    });
+                    let ids = [
+                        ("task-box-0-0", "task-label-0-0", "task-check-0-0"),
+                        ("task-box-0-1", "task-label-0-1", "task-check-0-1"),
+                        ("task-box-1-0", "task-label-1-0", "task-check-1-0"),
+                        ("task-box-1-1", "task-label-1-1", "task-check-1-1"),
+                    ];
+                    let before: Vec<_> = ids
+                        .iter()
+                        .map(|id| {
+                            (
+                                window.debug_bounds(id.0).unwrap(),
+                                window.debug_bounds(id.1).unwrap(),
+                            )
+                        })
+                        .collect();
+                    root.update(window, |r, _| r.offset = 0.);
+                    window.update(|w, cx| {
+                        let _ = w.draw(cx);
+                    });
+                    for (ix, id) in ids.iter().enumerate() {
+                        let box_bounds = window.debug_bounds(id.0).unwrap();
+                        let label = window.debug_bounds(id.1).unwrap();
+                        assert_eq!(
+                            label, before[ix].1,
+                            "marker correction must not move/resize labels"
+                        );
+                        window.update(|w, _| {
+                            let text_system = w.text_system();
+                            let font = gpui::Font {
+                                family: ".AppleSystemUIFont".into(),
+                                ..Default::default()
+                            };
+                            let font_id = text_system.resolve_font(&font);
+                            let ascent = text_system.ascent(font_id, px(body));
+                            let descent = text_system.descent(font_id, px(body));
+                            let leading = (px(body * 1.62) - ascent - descent) / 2.;
+                            let baseline = label.top() + leading + ascent;
+                            let previous_baseline = before[ix].1.top() + leading + ascent;
+                            assert_eq!(
+                                baseline, previous_baseline,
+                                "native-font first-line baseline remains unchanged"
+                            );
+                        });
+                        assert_eq!(box_bounds.size, before[ix].0.size);
+                        assert_eq!(box_bounds.left(), before[ix].0.left());
+                        let delta = f32::from(before[ix].0.top() - box_bounds.top());
+                        assert!((delta - body * 0.1).abs() <= 1. / scale + 0.01);
+                        let expected_top =
+                            label.top() + (px(body * 1.62) - box_bounds.size.height) / 2.;
+                        assert!(
+                            (f32::from(box_bounds.top() - expected_top)).abs() <= 1. / scale + 0.01,
+                            "first-line centering {body}/{scale}/{id:?}: {box_bounds:?} {label:?}"
+                        );
+                        if ix % 2 == 0 {
+                            let check = window.debug_bounds(id.2).unwrap();
+                            println!(
+                                "task {body}/{scale}/{dark}/{id:?}: before={:?}, box={box_bounds:?}, check={check:?}, label={label:?}",
+                                before[ix].0
+                            );
+                            assert!(
+                                (f32::from(check.left() - box_bounds.left())).abs() < 0.01,
+                                "SVG must align with border box, not start after its border: {check:?} {box_bounds:?}"
+                            );
+                            assert!((f32::from(check.top() - box_bounds.top())).abs() < 0.01);
+                            assert_eq!(check.size, box_bounds.size);
+                        } else {
+                            assert!(window.debug_bounds(id.2).is_none());
+                        }
+                    }
+                    root.update(window, |r, cx| r.state.update(cx, |s, cx| s.select_all(cx)));
+                    root.read_with(window, |r, cx| {
+                        assert_eq!(r.state.read(cx).selected_text().trim_end(), source)
+                    });
+                }
+            }
+        }
+    }
+}
+
+#[cfg(not(target_os = "macos"))]
+fn main() {}
