+#[test]
+fn parity_soft_breaks_math_and_utf8_source_projection() {
+    let source = "**甲\r\n乙** and $5 *cost* $10";
+    let extensions = MarkdownExtensions::default().soft_breaks(true).math(false);
+    let doc = configured(source, &extensions);
+    assert_eq!(doc.text(), "甲\n乙 and $5 cost $10\n");
+    assert_eq!(
+        configured("甲\n乙", &MarkdownExtensions::default()).text(),
+        "甲 乙\n"
+    );
+    let index = RenderedIndex::new(&doc);
+    for range in [0..7, 3..4, 4..7] {
+        assert_eq!(
+            TextViewState::copy_markdown_slice_with_extensions(
+                source,
+                Some(range.start),
+                Some(range.end),
+                SelectionFormat::Plain,
+                &extensions
+            )
+            .unwrap(),
+            &doc.text()[range.clone()]
+        );
+        assert_eq!(
+            TextViewState::copy_markdown_slice_with_extensions(
+                source,
+                Some(range.start),
+                Some(range.end),
+                SelectionFormat::Source,
+                &extensions
+            )
+            .unwrap(),
+            doc.copy_rendered_range(&index, range, SelectionFormat::Source)
+                .unwrap()
+        );
+    }
+    assert_eq!(
+        doc.source_range_for_rendered_range(&index, 3..4),
+        Some(5..7)
+    );
+    assert_eq!(
+        doc.source_range_for_rendered_range(&index, 4..7),
+        Some(7..10)
+    );
+    assert!(
+        TextViewState::copy_markdown_slice_with_extensions(
+            source,
+            Some(1),
+            Some(2),
+            SelectionFormat::Plain,
+            &extensions
+        )
+        .is_err()
+    );
+    let mut math_nodes = 0;
+    let disabled = extensions
+        .block_parser(|node, _| {
+            assert!(!matches!(node, super::markdown_ast::Node::Math(_)));
+            None
+        })
+        .plugin(
+            super::markdown_ext::TestInlinePlugin::new("not-math").parse_with(|node, _| {
+                assert!(!matches!(node, super::markdown_ast::Node::InlineMath(_)));
+                None
+            }),
+        );
+    let no_math = configured("$$\n甲 *乙*\n$$", &disabled);
+    for block in no_math.blocks.iter() {
+        if matches!(block, BlockNode::CodeBlock(_)) {
+            math_nodes += 1;
+        }
+    }
+    assert_eq!(math_nodes, 0);
