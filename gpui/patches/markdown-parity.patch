+#[test]
+fn parity_extensions_revisions_and_real_fence_source() {
+    let base = MarkdownExtensions::default();
+    for changed in [
+        base.clone().math(false),
+        base.clone().soft_breaks(true),
+        base.clone().skip_empty_table_header(true),
+    ] {
+        assert!(!base.has_same_parser_configuration(&changed));
+    }
+    let renderer = base.clone().code_block_body_renderer(|_, _, _| None);
+    assert!(base.has_same_parser_configuration(&renderer));
+    assert_ne!(base.revision(), renderer.revision());
+    for (source, closed) in [
+        ("~~~mermaid\n甲-->乙\n~~~", true),
+        ("```mermaid\r甲-->乙\r```", true),
+        ("```mermaid\n甲-->乙", false),
+        ("```mermaid\n甲-->乙\n``", false),
+    ] {
+        let mut cx = NodeContext {
+            offset: 19,
+            ..Default::default()
+        };
+        let doc = markdown::parse(source, &mut cx).unwrap();
+        let BlockNode::CodeBlock(code) = &doc.blocks[0] else {
+            panic!("code");
+        };
+        assert_eq!(code.source(), Some(source));
+        assert_eq!(code.source_range(), Some(19..19 + source.len()));
+        assert_eq!(code.closed_fence(), closed);
+        assert_eq!(code.lang().as_deref(), Some("mermaid"));
+    }
+    let quoted = configured("> ```mermaid\n> 甲-->乙\n> ```", &base);
+    let BlockNode::Blockquote { children, .. } = &quoted.blocks[0] else {
+        panic!("quote");
+    };
+    let BlockNode::CodeBlock(code) = &children[0] else {
+        panic!("code");
+    };
+    assert!(code.closed_fence());
+    let indented = configured("    ```\n    x\n    ```", &base);
+    let BlockNode::CodeBlock(code) = &indented.blocks[0] else {
+        panic!("code");
+    };
+    assert!(!code.closed_fence());
+}
