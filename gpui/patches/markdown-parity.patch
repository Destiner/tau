+#[gpui::test]
+fn parity_wrapped_css_table_cells_are_measured_and_vertically_centered(
+    cx: &mut gpui::TestAppContext,
+) {
+    struct Root {
+        state: Entity<TextViewState>,
+        body: f32,
+        width: f32,
+    }
+    impl Render for Root {
+        fn render(&mut self, _: &mut Window, _: &mut Context<Self>) -> impl IntoElement {
+            div()
+                .w(px(self.width))
+                .text_size(px(self.body))
+                .line_height(gpui::relative(1.62))
+                .child(
+                    TextView::new(&self.state).style(
+                        profile(self.body)
+                            .with_table_css_cells(true)
+                            .with_table_fit_content(true)
+                            .with_table({
+                                let mut table = gpui::StyleRefinement::default()
+                                    .text_size(px(self.body * 0.94));
+                                table.overflow.x = Some(gpui::Overflow::Scroll);
+                                table
+                            })
+                            .with_table_cell(
+                                gpui::StyleRefinement::default()
+                                    .py(px(6.))
+                                    .line_height(gpui::relative(1.62)),
+                            ),
+                    ),
+                )
+        }
+    }
+    cx.update(crate::init);
+    for body in [11., 13.] {
+        for width in [180., 280.] {
+            let (root, window) = cx.add_window_view(move |_, cx| Root { body, width, state: cx.new(|cx| TextViewState::markdown("| Name | Description |\n| --- | --- |\n| Alpha | A long unwrapped cell with several words |\n| Beta | Another cell |", cx)) });
+            let window: &mut gpui::VisualTestContext = window;
+            window.run_until_parked();
+            window.update(|window, cx| {
+                let _ = window.draw(cx);
+            });
+            let cell = window.debug_bounds("css-cell-1-1").unwrap();
+            let text = window.debug_bounds("css-cell-text-1-1").unwrap();
+            let short = window.debug_bounds("css-cell-text-1-0").unwrap();
+            assert!(
+                text.size.height > px(body * 0.94 * 1.62 + 1.),
+                "must wrap at {body}/{width}: {text:?}"
+            );
+            assert!(
+                text.bottom() <= cell.bottom() - px(5.9),
+                "no clipped wrapped line"
+            );
+            assert!(
+                (f32::from(text.center().y - short.center().y)).abs() <= 0.51,
+                "CSS middle alignment"
+            );
+            assert!(
+                cell.right() <= px(width + 0.1),
+                "min-content floor must fit words, not a fixed 160px"
+            );
+            root.read_with(window, |root, cx| {
+                let state = root.state.read(cx);
+                let bounds = state.selection_adapter.text_bounds();
+                assert!(
+                    bounds
+                        .iter()
+                        .any(|b| b.top() >= text.top() && b.bottom() <= text.bottom() + px(0.1))
+                );
+            });
+        }
+    }
+}
