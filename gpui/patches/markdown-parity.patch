+#[test]
+fn parity_spacing_model_is_adjacent_scaled_and_opt_in() {
+    for body in [11., 13.] {
+        let style = TextViewStyle::default()
+            .with_body_text_size(px(body))
+            .with_block_spacing(MarkdownBlockSpacing::default())
+            .with_heading(move |_| gpui::StyleRefinement::default().text_size(px(body * 1.2)));
+        let doc = configured(
+            "paragraph\n\n## heading\n\n### next\n\nbody\n\n|x|\n|--|\n|y|",
+            &MarkdownExtensions::default(),
+        );
+        let options = |ix| {
+            NodeRenderOptions::sibling(
+                &doc.blocks,
+                ix,
+                Default::default(),
+                &style,
+                px(body),
+                px(16.),
+            )
+        };
+        assert_eq!(options(0).leading_gap, px(0.));
+        assert_eq!(options(1).leading_gap, px(body * 1.2 * 1.2));
+        assert_eq!(options(2).leading_gap, px(body * 1.2 * 0.6));
+        let zero_style = style.clone().with_block_spacing(MarkdownBlockSpacing {
+            consecutive_heading_top: 0.,
+            ..Default::default()
+        });
+        assert_eq!(
+            NodeRenderOptions::sibling(
+                &doc.blocks,
+                2,
+                Default::default(),
+                &zero_style,
+                px(body),
+                px(16.)
+            )
+            .leading_gap,
+            px(body * 1.2 * 0.55),
+            "explicit zero still collapses with the preceding heading bottom"
+        );
+        assert_eq!(options(3).leading_gap, px(body * 0.7));
+        assert_eq!(options(4).leading_gap, px(body * 0.7));
+        assert!(options(4).is_last);
+    }
+    let base = TextViewStyle::default();
+    assert!(base.block_spacing().is_none());
+    assert_eq!(base.body_text_size(), None);
+    assert_eq!(base.inline_code_scale(), 0.875);
+    assert!(!base.heading_strong_inherit());
+    assert!(!base.deleted_muted());
+    assert_eq!(base.horizontal_rule_thickness(), px(2.));
+    for style in [
+        base.clone().with_body_text_size(px(11.)),
+        base.clone().with_block_spacing(Default::default()),
+        base.clone().with_heading_strong_inherit(true),
+        base.clone().with_deleted_muted(true),
+        base.clone().with_inline_code_scale(0.88),
+        base.clone().with_horizontal_rule_thickness(px(1.)),
+        base.clone()
+            .with_blockquote(gpui::StyleRefinement::default().pl(px(14.))),
+    ] {
+        assert!(base != style);
+        assert!(style == style.clone());
+    }
+}
