+#[test]
+fn parity_task_markers_follow_direct_checkbox_not_task_ancestors() {
+    let source = "- [x] Done\n\n  Details for done.\n\n  - Nested item\n  - [ ] Nested task\n\n- [ ] Pending";
+    let doc = markdown::parse(source, &mut NodeContext::default()).unwrap();
+    let BlockNode::List { children, .. } = &doc.blocks[0] else {
+        panic!("list")
+    };
+    let style = profile(13.);
+    let task = style.task_checkbox().unwrap();
+    let inherited = NodeRenderOptions {
+        todo: true,
+        ..Default::default()
+    };
+    for item in children {
+        let BlockNode::ListItem {
+            spread, checked, ..
+        } = item
+        else {
+            panic!("item")
+        };
+        assert!(*spread);
+        assert!(checked.is_some());
+        assert_eq!(task.opacity(*spread), 0.45);
+        assert!(BlockNode::list_item_has_marker(
+            inherited, *checked, *spread, &style
+        ));
+    }
+    let BlockNode::ListItem { children, .. } = &children[0] else {
+        panic!("item")
+    };
+    let BlockNode::List { children, .. } = &children[2] else {
+        panic!("nested list")
+    };
+    for (ix, item) in children.iter().enumerate() {
+        let BlockNode::ListItem {
+            spread, checked, ..
+        } = item
+        else {
+            panic!("nested item")
+        };
+        assert!(!spread);
+        assert_eq!(task.opacity(*spread), 1.);
+        assert_eq!(
+            BlockNode::list_item_has_marker(inherited, *checked, *spread, &style),
+            ix == 0
+        );
+    }
+    assert!(
+        !BlockNode::list_item_has_marker(inherited, None, false, &TextViewStyle::default()),
+        "legacy behavior stays opt-out"
+    );
+    let base = TextViewStyle::default();
+    assert!(base.task_checkbox().is_none());
+    assert!(base.inline_code_box().is_none());
+    assert!(base != profile(13.));
+    assert!(base != base.clone().with_inline_code_box(0.12, px(4.)));
+}
