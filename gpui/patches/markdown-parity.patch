diff --git a/src/text_selection/parity_tests.rs b/src/text_selection/parity_tests.rs
new file mode 100644
index 0000000..7b45455
--- /dev/null
+++ b/src/text_selection/parity_tests.rs
@@ -0,0 +1,161 @@
+use super::*;
+use crate::{MarkdownExtensions, SelectionFormat, TextViewState};
+use std::sync::Arc;
+
+#[gpui::test]
+fn parity_initial_async_configured_domain_selection_and_remount(cx: &mut gpui::TestAppContext) {
+    cx.update(crate::init);
+    let extensions = MarkdownExtensions::default().soft_breaks(true).math(false);
+    for bytes in [5 * 1024, 8 * 1024] {
+        let source = format!(
+            "**甲\r\n乙** $5 and $10\n\n{}",
+            "ordinary reply text. ".repeat((bytes - 32) / 21)
+        );
+        assert!(source.len() > 4096 && source.len() <= 8192);
+        for reversed in [false, true] {
+            let domain = TextSelectionDomain::new(|item, _| Some(item), |_, _| String::new());
+            let a = TextSelectionDomainEndpoint {
+                item: 10,
+                offset: 3,
+            };
+            let b = TextSelectionDomainEndpoint {
+                item: 10,
+                offset: 7,
+            };
+            let selected = TextSelectionDomainRange {
+                anchor: if reversed { b } else { a },
+                cursor: if reversed { a } else { b },
+            };
+            cx.update(|cx| domain.set_range(selected, false, cx));
+            let cold_plain = TextViewState::copy_markdown_slice_with_extensions(
+                &source,
+                Some(3),
+                Some(7),
+                SelectionFormat::Plain,
+                &extensions,
+            )
+            .unwrap();
+            let cold_source = TextViewState::copy_markdown_slice_with_extensions(
+                &source,
+                Some(3),
+                Some(7),
+                SelectionFormat::Source,
+                &extensions,
+            )
+            .unwrap();
+            assert_eq!(cold_plain, "\n乙");
+            for _ in 0..2 {
+                let view = cx.new(|cx| {
+                    TextViewState::markdown_with_extensions(&source, extensions.clone(), cx)
+                });
+                view.update(cx, |state, cx| {
+                    state.set_selection_domain(Some((domain.clone(), 10)), cx)
+                });
+                view.read_with(cx, |state, cx| {
+                    // A lazy async row must not expose a default-parser projection or clamp offsets.
+                    assert!(state.rendered_text().is_empty());
+                    assert_eq!(state.selected_rendered_range_with(cx), None);
+                    assert!(state.selected_text_with(cx).is_empty());
+                    assert_eq!(state.selected_source_range_with(cx), None);
+                    assert_eq!(domain.range(cx), Some(selected));
+                });
+                cx.run_until_parked();
+                view.read_with(cx, |state, cx| {
+                    assert_eq!(state.selected_rendered_range_with(cx), Some(3..7));
+                    assert_eq!(state.selected_text_with(cx), cold_plain);
+                    assert_eq!(
+                        state
+                            .copy_rendered_range(3..7, SelectionFormat::Source)
+                            .unwrap(),
+                        cold_source
+                    );
+                    assert_eq!(state.selected_source_range_with(cx), Some(5..10));
+                    assert_eq!(domain.range(cx), Some(selected));
+                });
+                let weak = view.downgrade();
+                drop(view);
+                assert!(weak.upgrade().is_none());
+                assert_eq!(domain.stored_range(), Some(selected));
+            }
+        }
+    }
+}
+
+#[gpui::test]
+fn parity_source_owned_selection_uses_configured_projection_both_directions(
+    cx: &mut gpui::TestAppContext,
+) {
+    cx.update(crate::init);
+    let source = "**甲\r\n乙** $5 and $10";
+    let extensions = Arc::new(MarkdownExtensions::default().soft_breaks(true).math(false));
+    for reversed in [false, true] {
+        let calls = Rc::new(Cell::new(0));
+        let provider = calls.clone();
+        let domain = TextSelectionDomain::new(
+            move |item, _| {
+                provider.set(provider.get() + 1);
+                Some(item)
+            },
+            |_, _| String::new(),
+        );
+        let a = TextSelectionDomainEndpoint {
+            item: 10,
+            offset: 0,
+        };
+        let b = TextSelectionDomainEndpoint {
+            item: 10,
+            offset: 7,
+        };
+        let selected = TextSelectionDomainRange {
+            anchor: if reversed { b } else { a },
+            cursor: if reversed { a } else { b },
+        };
+        for _ in 0..2 {
+            let view = cx.new(|cx| {
+                TextViewState::markdown_with_extensions(source, (*extensions).clone(), cx)
+            });
+            view.update(cx, |state, cx| {
+                state.set_selection_domain(Some((domain.clone(), 10)), cx);
+            });
+            cx.update(|cx| domain.set_range(selected, false, cx));
+            calls.set(0);
+            view.read_with(cx, |state, cx| {
+                assert_eq!(state.selected_text_with(cx), "甲\n乙");
+                assert_eq!(state.selected_source_range_with(cx), Some(2..10));
+                assert_eq!(domain.range(cx), Some(selected));
+                assert_eq!(
+                    state.selected_text_with(cx),
+                    TextViewState::copy_markdown_slice_with_extensions(
+                        source,
+                        Some(0),
+                        Some(7),
+                        SelectionFormat::Plain,
+                        &extensions
+                    )
+                    .unwrap()
+                );
+            });
+            assert_eq!(
+                calls.get(),
+                17,
+                "projection queries only endpoints and this item"
+            );
+            view.update(cx, |state, cx| {
+                state.set_markdown_extensions(
+                    Arc::new(
+                        (*extensions)
+                            .clone()
+                            .code_block_body_renderer(|_, _, _| None),
+                    ),
+                    cx,
+                )
+            });
+            view.read_with(cx, |state, cx| {
+                assert_eq!(state.selected_text_with(cx), "甲\n乙");
+                assert_eq!(domain.range(cx), Some(selected));
+            });
+            drop(view);
+            assert_eq!(domain.stored_range(), Some(selected));
+        }
+    }
+}
