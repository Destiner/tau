+/// Positive CSS-like sibling margins in local em units. Adjacent margins
+/// collapse to their maximum; root first/last margins are suppressed except
+/// for an explicitly retained first code margin. No root rem
+/// assumptions, coordinate calibration, or scanning outside adjacent siblings.
+#[derive(Clone, Copy, Debug, PartialEq)]
+pub struct MarkdownBlockSpacing {
+    pub paragraph: f32,
+    pub heading_top: f32,
+    pub heading_bottom: f32,
+    /// Defaults to 0.6 heading em. Callers must resolve their CSS cascade (a
+    /// weak adjacent selector may lose to the individual heading rule).
+    /// Set to 0. explicitly
+    /// to suppress the next heading's top margin (the previous bottom still collapses).
+    pub consecutive_heading_top: f32,
+    pub rule: f32,
+    pub loose_list_continuation: f32,
+    pub nested_list_top: f32,
+    /// Top margin retained by a first fenced code block (including a custom
+    /// diagram body). Opt in when a later CSS rule beats the root reset.
+    pub first_code_top: f32,
+}
+
+impl Default for MarkdownBlockSpacing {
+    fn default() -> Self {
+        Self {
+            paragraph: 0.7,
+            heading_top: 1.2,
+            heading_bottom: 0.55,
+            consecutive_heading_top: 0.6,
+            rule: 1.2,
+            loose_list_continuation: 0.28,
+            nested_list_top: 0.15,
+            first_code_top: 0.,
+        }
+    }
+}
+
+/// An inert task indicator, resolved in body em rather than root rem.
+#[derive(Clone, Copy, Debug, PartialEq)]
+pub struct MarkdownTaskCheckbox {
+    pub size_em: f32,
+    /// Direct input's CSS right margin, excluding the following HTML space.
+    pub gap_em: f32,
+    /// Width of the ordinary HTML space after either kind of input, in body em.
+    pub space_em: f32,
+    /// Paragraph-wrapped inputs retain the UA's intrinsic size and margins.
+    pub loose_size: gpui::Pixels,
+    pub loose_inset: gpui::Pixels,
+    pub loose_gap: gpui::Pixels,
+    /// Disabled opacity applies only to paragraph-wrapped inputs, not their labels.
+    pub loose_opacity: f32,
+    /// Offset from the centered position in the first text line.
+    pub offset_em: f32,
+    pub radius: gpui::Pixels,
+    pub border: Hsla,
+    pub background: Hsla,
+    pub checked_background: Hsla,
+}
+
+impl Default for MarkdownTaskCheckbox {
+    fn default() -> Self {
+        Self {
+            size_em: 0.95,
+            gap_em: 0.45,
+            space_em: 0.25,
+            loose_size: gpui::px(12.),
+            loose_inset: gpui::px(2.),
+            loose_gap: gpui::px(3.),
+            loose_opacity: 0.45,
+            offset_em: 0.1,
+            radius: gpui::px(3.),
+            border: gpui::rgb(0xbebebe).into(),
+            background: gpui::white(),
+            checked_background: gpui::black(),
+        }
+    }
+}
+
+impl MarkdownTaskCheckbox {
+    pub(crate) fn geometry(
+        self,
+        body_size: gpui::Pixels,
+        loose: bool,
+    ) -> (gpui::Pixels, gpui::Pixels, gpui::Pixels) {
+        let (size, inset, gap) = if loose {
+            (self.loose_size, self.loose_inset, self.loose_gap)
+        } else {
+            (
+                body_size * self.size_em,
+                gpui::Pixels::ZERO,
+                body_size * self.gap_em,
+            )
+        };
+        (size, inset, gap + body_size * self.space_em)
+    }
+
+    pub(crate) fn opacity(self, loose: bool) -> f32 {
+        if loose {
+            self.loose_opacity.clamp(0., 1.)
+        } else {
+            1.
+        }
+    }
+}
