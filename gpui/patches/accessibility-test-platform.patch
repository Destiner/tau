+    struct AccessibleCounter(Counter);
+
+    impl Render for AccessibleCounter {
+        fn render(&mut self, _: &mut Window, cx: &mut Context<Self>) -> impl IntoElement {
+            div()
+                .id("accessible-counter")
+                .size(crate::px(80.))
+                .role(crate::Role::Button)
+                .aria_label(format!("Count: {}", self.0.count))
+                .track_focus(&self.0.focus_handle)
+                .on_click(cx.listener(|counter, _, _, cx| {
+                    counter.0.count += 1;
+                    cx.notify();
+                }))
+        }
+    }
+
+    #[test]
+    fn test_accessibility_platform_callbacks() {
+        let mut app = TestApp::new();
+        let mut window = app.open_window(|_, cx| {
+            AccessibleCounter(Counter {
+                count: 0,
+                focus_handle: cx.focus_handle(),
+            })
+        });
+        window.draw();
+        assert!(window.accessibility_tree().is_none());
+        window.activate_accessibility();
+        window.draw();
+        let tree = window.accessibility_tree().expect("delivered tree");
+        let (id, node) = tree
+            .nodes
+            .iter()
+            .find(|(_, node)| node.label() == Some("Count: 0"))
+            .expect("rendered counter");
+        assert_eq!(node.role(), crate::Role::Button);
+        assert!(node.supports_action(accesskit::Action::Click));
+        let id = *id;
+        for action in [accesskit::Action::Focus, accesskit::Action::Click] {
+            window.dispatch_accessibility_action(accesskit::ActionRequest {
+                action,
+                target_tree: accesskit::TreeId::ROOT,
+                target_node: id,
+                data: None,
+            });
+        }
+        window.update(|counter, w, _| {
+            assert!(counter.0.focus_handle.is_focused(w));
+            assert_eq!(counter.0.count, 1);
+            w.refresh();
+        });
+        window.draw();
+        let latest = window.accessibility_tree().expect("latest delivered tree");
+        assert_eq!(latest.focus, id);
+        assert!(
+            latest
+                .nodes
+                .iter()
+                .any(|(_, node)| node.label() == Some("Count: 1"))
+        );
+        assert!(
+            latest
+                .nodes
+                .iter()
+                .all(|(_, node)| node.label() != Some("Count: 0"))
+        );
+        drop(window);
+        app.update(|cx| cx.shutdown());
+    }
