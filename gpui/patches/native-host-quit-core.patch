 impl TestPlatform {
+    pub(crate) fn simulate_quit(&self) -> bool {
+        let Some(mut callback) = self.quit_callback.borrow_mut().take() else {
+            return false;
+        };
+        let allowed = callback();
+        self.quit_callback.borrow_mut().get_or_insert(callback);
+        if allowed {
+            self.accepted_quits.set(self.accepted_quits.get() + 1);
+        }
+        allowed
+    }
+
+    pub(crate) fn simulate_reopen(&self) {
+        let callback = self.reopen_callback.borrow_mut().take();
+        if let Some(mut callback) = callback {
+            callback();
+            self.reopen_callback.borrow_mut().get_or_insert(callback);
+        }
+    }
