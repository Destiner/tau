+    /// Install a synchronous veto before platform termination and cleanup.
+    /// Return false while the host owns asynchronous confirmation or shutdown,
+    /// then call `quit` again after approval. Recursive evaluations fail closed.
+    /// This replaces the previous guard, not the platform callback or delegate.
+    pub fn on_app_should_quit(&mut self, guard: impl Fn(&mut App) -> bool + 'static) {
+        self.should_quit = Some(Rc::new(guard));
+    }
+
+    fn should_quit(&mut self) -> bool {
+        if self.evaluating_should_quit {
+            return false;
+        }
+        self.evaluating_should_quit = true;
+        let guard = self.should_quit.clone();
+        let allowed = guard.is_none_or(|guard| guard(self));
+        self.evaluating_should_quit = false;
+        allowed
+    }
+
+    /// Install the explicit host callback for platform reopen events.
+    pub fn on_reopen(&mut self, mut callback: impl FnMut(&mut App) + 'static) {
+        let this = self.this.clone();
+        self.platform.on_reopen(Box::new(move || {
+            if let Some(app) = this.upgrade() {
+                app.borrow_mut().update(|cx| callback(cx));
+            }
+        }));
     }
 
