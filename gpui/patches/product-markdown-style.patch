+    #[gpui::test]
+    fn css_table_cells_align_without_vertical_rules(cx: &mut TestAppContext) {
+        struct CssTable;
+        impl Render for CssTable {
+            fn render(&mut self, _: &mut Window, _: &mut Context<Self>) -> impl IntoElement {
+                let mut table = StyleRefinement::default();
+                table.overflow.x = Some(Overflow::Scroll);
+                div().w(px(320.)).child(
+                    TextView::markdown("css-cells", "| File | Change | Status |\n|---|---|---|\n| src/App.vue | Updated | Ready |\n| src/main.ts | Added | Review |")
+                        .style(TextViewStyle::default().with_table(table)
+                            .with_table_fit_content(true).with_table_css_cells(true)),
+                )
+            }
+        }
+        cx.update(crate::init);
+        let (_, window) = cx.add_window_view(|_, _| CssTable);
+        let window: &mut VisualTestContext = window;
+        window.run_until_parked();
+        window.update(|window, cx| {
+            let _ = window.draw(cx);
+        });
+        let names = [
+            ["css-cell-0-0", "css-cell-0-1", "css-cell-0-2"],
+            ["css-cell-1-0", "css-cell-1-1", "css-cell-1-2"],
+        ];
+        let mut cell = |row: usize, col: usize| window.debug_bounds(names[row][col]).unwrap();
+        for col in 0..3 {
+            let header = cell(0, col);
+            let body = cell(1, col);
+            assert_eq!(header.left(), body.left(), "column {col} left edge");
+            assert_eq!(header.right(), body.right(), "column {col} right edge");
+            if col < 2 {
+                assert_eq!(header.right(), cell(0, col + 1).left());
+            }
+        }
+        assert!(cell(0, 2).right() <= px(320.));
+        assert!(
+            cell(0, 0).size.width > px(70.),
+            "CSS cell padding is included"
+        );
+    }
