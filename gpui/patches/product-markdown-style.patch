+    #[gpui::test]
+    fn scroll_table_fit_content_is_opt_in_and_bounded(cx: &mut TestAppContext) {
+        struct TableWidthRoot {
+            fit: bool,
+            scroll: bool,
+            content: &'static str,
+        }
+        impl Render for TableWidthRoot {
+            fn render(&mut self, _: &mut Window, _: &mut Context<Self>) -> impl IntoElement {
+                let mut table = StyleRefinement::default();
+                if self.scroll {
+                    table.overflow.x = Some(Overflow::Scroll);
+                }
+                div().w(px(320.)).child(
+                    TextView::markdown("table-width", self.content)
+                        .style(
+                            TextViewStyle::default()
+                                .with_table(table)
+                                .with_table_fit_content(self.fit),
+                        )
+                        .table_actions(|_, _, _| {
+                            div()
+                                .w_full()
+                                .debug_selector(|| "table-width-action".into())
+                                .child("Copy")
+                        }),
+                )
+            }
+        }
+        let measure = |cx: &mut TestAppContext, scroll, fit, content| {
+            cx.update(crate::init);
+            let (_, window) = cx.add_window_view(move |_, _| TableWidthRoot {
+                fit,
+                scroll,
+                content,
+            });
+            let window: &mut VisualTestContext = window;
+            window.run_until_parked();
+            window.update(|window, cx| {
+                let _ = window.draw(cx);
+            });
+            window
+                .debug_bounds("table-width-action")
+                .unwrap()
+                .size
+                .width
+        };
+        let short = "| A | B |\n|---|---|\n| a | b |";
+        let long =
+            "| A | B |\n|---|---|\n| abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ | b |";
+        assert_eq!(measure(cx, false, false, short), px(320.));
+        assert_eq!(
+            measure(cx, false, true, short),
+            px(320.),
+            "wrap tables ignore fit-content"
+        );
+        let default_short = measure(cx, true, false, short);
+        let default_long = measure(cx, true, false, long);
+        let fitted_short = measure(cx, true, true, short);
+        let fitted_long = measure(cx, true, true, long);
+        assert_eq!(default_short, px(320.));
+        assert_eq!(
+            default_long, default_short,
+            "default scroll table still fills the frame"
+        );
+        assert!(
+            fitted_short < default_short,
+            "short content should fit naturally: {fitted_short:?}"
+        );
+        assert!(
+            fitted_short > px(90.),
+            "cell padding and borders must be included: {fitted_short:?}"
+        );
+        assert_eq!(
+            fitted_long, default_long,
+            "wide content must remain inside the viewport"
+        );
+    }
