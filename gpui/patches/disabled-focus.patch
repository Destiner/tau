+    fn disabled_focus_contract<M: InputModeKind>(view: InputView<M>, cx: &mut TestAppContext) {
+        let mut cx = VisualTestContext::from_window(view.window_handle.into(), cx);
+        let input = view.input;
+        cx.update(|window, cx| {
+            input.update(cx, |state, cx| state.set_disabled(true, cx));
+            window.draw(cx).clear(cx);
+            input.update(cx, |state, cx| state.focus(window, cx));
+            window.focus_next(cx);
+        });
+        cx.update(|window, cx| assert!(!input.read(cx).focus_handle.is_focused(window)));
+        let position = input.read_with(&cx, |state, _| state.input_bounds.center());
+        cx.simulate_mouse_down(position, MouseButton::Left, Default::default());
+        cx.simulate_mouse_up(position, MouseButton::Left, Default::default());
+        cx.update(|window, cx| {
+            assert!(!input.read(cx).focus_handle.is_focused(window));
+        });
+        input.read_with(&cx, |state, _| {
+            assert!(!state.selecting);
+            assert_eq!(state.cursor(), 0);
+        });
+
+        cx.update(|window, cx| {
+            input.update(cx, |state, cx| state.set_disabled(false, cx));
+            window.draw(cx).clear(cx);
+            window.focus_next(cx);
+        });
+        cx.update(|window, cx| assert!(input.read(cx).focus_handle.is_focused(window)));
+        cx.update(|window, cx| {
+            window.blur(cx);
+            input.update(cx, |state, cx| state.set_readonly(true, cx));
+            window.draw(cx).clear(cx);
+            window.focus_next(cx);
+        });
+        cx.update(|window, cx| assert!(input.read(cx).focus_handle.is_focused(window)));
     }
 
