     use super::*;
 
     use util_macros::perf;
+
+    #[test]
+    fn overflow_mask_clips_only_requested_axes_inside_enclosing_viewport() {
+        let bounds = Bounds::from_corners(point(px(20.), px(30.)), point(px(60.), px(42.)));
+        let parent = Bounds::from_corners(point(px(5.), px(7.)), point(px(100.), px(90.)));
+        for (x, y, expected) in [
+            (
+                Overflow::Hidden,
+                Overflow::Visible,
+                Some(Bounds::from_corners(
+                    point(px(21.), parent.top()),
+                    point(px(59.), parent.bottom()),
+                )),
+            ),
+            (
+                Overflow::Visible,
+                Overflow::Hidden,
+                Some(Bounds::from_corners(
+                    point(parent.left(), px(31.)),
+                    point(parent.right(), px(41.)),
+                )),
+            ),
+            (
+                Overflow::Hidden,
+                Overflow::Hidden,
+                Some(Bounds::from_corners(
+                    point(px(21.), px(31.)),
+                    point(px(59.), px(41.)),
+                )),
+            ),
+            (Overflow::Visible, Overflow::Visible, None),
+        ] {
+            let style = Style {
+                overflow: point(x, y),
+                border_color: Some(red()),
+                border_widths: Edges::all(px(1.).into()),
+                ..Default::default()
+            };
+            assert_eq!(
+                style
+                    .overflow_mask(bounds, px(16.), parent)
+                    .map(|m| m.bounds),
+                expected
+            );
+        }
+    }
+
+    #[test]
+    fn truncate_preserves_line_grid_and_explicit_vertical_clip() {
+        use crate::{Styled, div};
+        let mut label = div().line_height(crate::relative(1.)).truncate();
+        assert_eq!(label.style().overflow.x, Some(Overflow::Hidden));
+        assert_eq!(label.style().overflow.y, None);
+        assert_eq!(
+            label.text_style().line_height,
+            Some(crate::relative(1.).into())
+        );
+        let mut viewport = div().overflow_hidden().truncate();
+        assert_eq!(viewport.style().overflow.y, Some(Overflow::Hidden));
+    }
 
