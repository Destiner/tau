+    #[test]
+    fn prose_measure_limits_root_only_and_retains_selection() {
+        use gpui::TestApp;
+
+        const PROSE: &str = "A sequence of words repeats until the paragraph wraps at the readable measure: alpha beta gamma delta epsilon zeta eta theta iota kappa lambda mu nu xi omicron pi rho sigma tau upsilon phi chi psi omega.";
+        const FENCE: &str = "```text\na rather long code line with many words to occupy the available viewport width\n```";
+        const TABLE: &str = "| Key | Description |\n| --- | --- |\n| Alpha | long content that should not lose its table viewport |";
+        struct Root {
+            plain: Entity<TextViewState>,
+            measured: Entity<TextViewState>,
+            fence_plain: Entity<TextViewState>,
+            fence_measured: Entity<TextViewState>,
+            table_plain: Entity<TextViewState>,
+            table_measured: Entity<TextViewState>,
+        }
+        impl Render for Root {
+            fn render(&mut self, _: &mut Window, _: &mut Context<Self>) -> impl IntoElement {
+                let measured = TextViewStyle::default().with_prose_max_width(px(175.));
+                div()
+                    .w(px(410.))
+                    .text_size(px(13.))
+                    .child(crate::TextSelectionLayer)
+                    .child(TextView::new(&self.plain).selectable(true))
+                    .child(
+                        TextView::new(&self.measured)
+                            .selectable(true)
+                            .style(measured.clone()),
+                    )
+                    .child(TextView::new(&self.fence_plain).selectable(true))
+                    .child(
+                        TextView::new(&self.fence_measured)
+                            .selectable(true)
+                            .style(measured.clone()),
+                    )
+                    .child(TextView::new(&self.table_plain).selectable(true))
+                    .child(
+                        TextView::new(&self.table_measured)
+                            .selectable(true)
+                            .style(measured),
+                    )
+            }
+        }
+        assert_eq!(TextViewStyle::default().prose_max_width(), None);
+        assert!(
+            TextViewStyle::default() != TextViewStyle::default().with_prose_max_width(px(175.))
+        );
+        let mut app = TestApp::new();
+        app.update(crate::init);
+        let mut window = app.open_window(|_, cx| Root {
+            plain: cx.new(|cx| TextViewState::markdown(PROSE, cx)),
+            measured: cx.new(|cx| TextViewState::markdown(PROSE, cx)),
+            fence_plain: cx.new(|cx| TextViewState::markdown(FENCE, cx)),
+            fence_measured: cx.new(|cx| TextViewState::markdown(FENCE, cx)),
+            table_plain: cx.new(|cx| TextViewState::markdown(TABLE, cx)),
+            table_measured: cx.new(|cx| TextViewState::markdown(TABLE, cx)),
+        });
+        window.draw();
+        app.run_until_parked();
+        window.draw();
+        window.read(|root, cx| {
+            let lines =
+                |view: &Entity<TextViewState>| view.read(cx).selection_adapter.text_bounds();
+            let plain = lines(&root.plain);
+            let measured = lines(&root.measured);
+            assert!(measured.len() > plain.len(), "root prose must wrap sooner");
+            assert!(
+                measured
+                    .iter()
+                    .filter(|bounds| bounds.size.width <= px(175.))
+                    .count()
+                    >= 9
+            );
+            for (name, default, opted) in [
+                ("fence", &root.fence_plain, &root.fence_measured),
+                ("table", &root.table_plain, &root.table_measured),
+            ] {
+                let default = lines(default);
+                let opted = lines(opted);
+                assert_eq!(default.len(), opted.len(), "{name} keeps its viewport");
+                assert!(
+                    opted.iter().any(|bounds| bounds.size.width > px(175.)),
+                    "{name} is wider than prose"
+                );
+            }
+        });
+        window.update(|root, _, cx| {
+            for view in [
+                &root.plain,
+                &root.measured,
+                &root.fence_plain,
+                &root.fence_measured,
+                &root.table_plain,
+                &root.table_measured,
+            ] {
+                view.update(cx, |state, cx| state.select_all(cx));
+            }
+        });
+        window.draw();
+        window.read(|root, cx| {
+            assert_eq!(
+                root.plain.read(cx).selected_text(),
+                root.measured.read(cx).selected_text()
+            );
+            for (default, opted) in [
+                (&root.fence_plain, &root.fence_measured),
+                (&root.table_plain, &root.table_measured),
+            ] {
+                assert_eq!(
+                    default.read(cx).selected_text(),
+                    opted.read(cx).selected_text()
+                );
+            }
+            assert!(root.measured.read(cx).selected_text().contains("omega"));
+        });
     }
 
