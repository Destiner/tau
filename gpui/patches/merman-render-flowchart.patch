+//! Optional host typography, shared by ELK measurement and SVG painting.
+use crate::text::TextStyle;
+use serde_json::Value;
+
+pub(crate) fn label_style(config: &Value, base: &TextStyle, role: &str) -> TextStyle {
+    let mut style = base.clone();
+    if let Some(profile) = config
+        .pointer("/flowchart/nativeLabelProfile")
+        .and_then(|p| p.get(role))
+    {
+        if let Some(size) = profile
+            .get("fontSize")
+            .and_then(Value::as_f64)
+            .filter(|n| n.is_finite() && *n >= 1.0 && *n <= 256.0)
+        {
+            style.font_size = size;
+        }
+        if let Some(weight) = profile
+            .get("fontWeight")
+            .and_then(Value::as_str)
+            .filter(|w| w.parse::<u16>().is_ok_and(|n| (1..=1000).contains(&n)))
+        {
+            style.font_weight = Some(weight.into());
+        }
+    }
+    style
+}
+
+pub(crate) fn number(config: &Value, key: &str) -> Option<f64> {
+    config
+        .get("flowchart")?
+        .get(key)?
+        .as_f64()
+        .filter(|n| n.is_finite() && *n >= 0.0 && *n <= 4096.0)
+}
