+use super::*;
+use crate::model::{LayoutLabel, LayoutPoint};
+
+fn node(id: &str, x: f64, y: f64, width: f64, height: f64) -> LayoutNode {
+    LayoutNode {
+        id: id.into(),
+        x,
+        y,
+        width,
+        height,
+        is_cluster: false,
+        label_width: None,
+        label_height: None,
+    }
+}
+fn edge(from: &str, to: &str, points: &[(f64, f64)]) -> LayoutEdge {
+    LayoutEdge {
+        id: format!("{from}-{to}"),
+        from: from.into(),
+        to: to.into(),
+        from_cluster: None,
+        to_cluster: None,
+        points: points.iter().map(|&(x, y)| LayoutPoint { x, y }).collect(),
+        label: None,
+        start_label_left: None,
+        start_label_right: None,
+        end_label_left: None,
+        end_label_right: None,
+        start_marker: None,
+        end_marker: None,
+        stroke_dasharray: None,
+    }
+}
+fn spacing() -> Spacing {
+    Spacing {
+        node_node: 28.0,
+        rank: 48.0,
+        edge_edge: 12.0,
+        edge_edge_between: 12.0,
+        edge_node_between: 12.0,
+    }
+}
+
+#[test]
+fn alignment_uses_top_left_and_preserves_connected_layers_and_labels() {
+    let mut nodes = vec![
+        node("a", 0.0, 20.0, 40.0, 40.0),
+        node("b", 80.0, 32.0, 40.0, 40.0),
+        node("c", 0.0, 110.0, 40.0, 40.0),
+    ];
+    let mut edges = vec![edge("a", "c", &[(0.0, 40.0), (0.0, 60.0), (0.0, 90.0)])];
+    edges[0].label = Some(LayoutLabel {
+        x: 0.0,
+        y: 70.0,
+        width: 20.0,
+        height: 12.0,
+    });
+    align_layers(&mut nodes, &mut edges, Axis::new(Some("TB")), |_| Ok(())).unwrap();
+    assert_eq!(nodes[0].y, nodes[1].y);
+    assert_eq!(nodes[2].y, 110.0);
+    assert_eq!(edges[0].points[0].y, 46.0);
+    assert_eq!(edges[0].points[1].y, 60.0);
+    assert_eq!(edges[0].label.as_ref().unwrap().y, 70.0);
+    let mut adjacent = vec![
+        node("a", 0.0, 20.0, 40.0, 40.0),
+        node("b", 80.0, 32.0, 40.0, 40.0),
+    ];
+    align_layers(
+        &mut adjacent,
+        &mut [edge("a", "b", &[])],
+        Axis::new(Some("TB")),
+        |_| Ok(()),
+    )
+    .unwrap();
+    assert_ne!(adjacent[0].y, adjacent[1].y);
+}
+
+#[test]
+fn alignment_does_not_cluster_container_boxes() {
+    let mut nodes = vec![
+        node("a", 0.0, 20.0, 40.0, 40.0),
+        node("container", 0.0, 30.0, 60.0, 40.0),
+    ];
+    nodes[1].is_cluster = true;
+    align_layers(&mut nodes, &mut [], Axis::new(Some("TB")), |_| Ok(())).unwrap();
+    assert_eq!(nodes[0].y, 20.0);
+    assert_eq!(nodes[1].y, 30.0);
+}
+
+#[test]
+fn alignment_snap_is_top_left_not_center_for_unequal_sizes() {
+    let mut nodes = vec![
+        node("a", 20.0, 0.0, 40.0, 40.0),
+        node("b", 48.0, 80.0, 72.0, 40.0),
+    ];
+    align_layers(&mut nodes, &mut [], Axis::new(Some("LR")), |_| Ok(())).unwrap();
+    assert_eq!(
+        nodes[0].x - nodes[0].width / 2.0,
+        nodes[1].x - nodes[1].width / 2.0
+    );
+    assert_ne!(nodes[0].x, nodes[1].x);
+}
+
+#[test]
+fn constraint_locking_packs_a_chain_and_locks_an_isolated_rectangle() {
+    // The second pass locks groups without incoming reversed constraints,
+    // including isolated rectangles. Routing channels constrain non-isolated sinks.
+    let mut nodes = vec![
+        node("left", 0.0, 20.0, 40.0, 40.0),
+        node("right", 0.0, 140.0, 40.0, 40.0),
+        node("free", 100.0, 20.0, 40.0, 40.0),
+    ];
+    compact(
+        &mut nodes,
+        &mut [],
+        Axis::new(Some("TB")),
+        spacing(),
+        |_| Ok(()),
+    )
+    .unwrap();
+    assert_eq!(nodes[0].y, 20.0);
+    assert_eq!(nodes[1].y - nodes[0].y, 88.0);
+    assert_eq!(nodes[2].y, 20.0);
+}
+
+#[test]
+fn compaction_is_rotation_and_reflection_equivariant() {
+    let original = vec![
+        node("a", 0.0, 20.0, 40.0, 40.0),
+        node("b", 0.0, 140.0, 40.0, 40.0),
+        node("c", 100.0, 20.0, 40.0, 40.0),
+    ];
+    let mut down = original.clone();
+    compact(&mut down, &mut [], Axis::new(Some("TB")), spacing(), |_| {
+        Ok(())
+    })
+    .unwrap();
+    for direction in ["LR", "RL", "BT"] {
+        let axis = Axis::new(Some(direction));
+        let mut transformed = original.clone();
+        for n in &mut transformed {
+            if axis.horizontal {
+                std::mem::swap(&mut n.x, &mut n.y);
+            }
+            if axis.horizontal {
+                n.x *= axis.sign;
+            } else {
+                n.y *= axis.sign;
+            }
+        }
+        compact(&mut transformed, &mut [], axis, spacing(), |_| Ok(())).unwrap();
+        for (a, b) in down.iter().zip(&transformed) {
+            assert!((a.y - axis.main(b.x, b.y)).abs() < EPS);
+            assert_eq!(a.x, axis.cross(b.x, b.y));
+        }
+    }
+}
+
+#[test]
+fn work_rejection_and_ordinal_limit_fail_closed_before_publication() {
+    let mut nodes = vec![node("a", 0.0, 20.0, 40.0, 40.0)];
+    let err = compact(
+        &mut nodes,
+        &mut [],
+        Axis::new(Some("TB")),
+        spacing(),
+        |_| Err(limit_error()),
+    )
+    .unwrap_err();
+    assert!(err.to_string().contains("work limit"));
+    assert_eq!(nodes[0].y, 20.0);
+    let mut many: Vec<_> = (0..512)
+        .map(|i| node(&i.to_string(), i as f64 * 80.0, 20.0, 40.0, 40.0))
+        .collect();
+    let err = compact(&mut many, &mut [], Axis::new(Some("TB")), spacing(), |_| {
+        Ok(())
+    })
+    .unwrap_err();
+    assert!(err.to_string().contains("work limit"));
+    assert!(many.iter().all(|n| n.y == 20.0));
+}
+
+#[test]
+fn sweep_constraints_are_deterministic() {
+    let input = vec![
+        node("a", 0.0, 20.0, 40.0, 40.0),
+        node("b", 0.0, 140.0, 40.0, 40.0),
+        node("c", 100.0, 20.0, 40.0, 40.0),
+    ];
+    let mut previous = None;
+    for _ in 0..16 {
+        let mut nodes = input.clone();
+        compact(
+            &mut nodes,
+            &mut [],
+            Axis::new(Some("TB")),
+            spacing(),
+            |_| Ok(()),
+        )
+        .unwrap();
+        let positions: Vec<_> = nodes.iter().map(|n| (n.x, n.y)).collect();
+        if let Some(ref old) = previous {
+            assert_eq!(*old, positions);
+        }
+        previous = Some(positions);
+    }
+}
