+/// Emits already-wrapped plain lines with the profile's measured line advance.
+pub(in crate::svg::parity) fn write_native_profile_lines(
+    out: &mut String,
+    lines: &[Vec<String>],
+    font_size: f64,
+    ratio: f64,
+    center_y: f64,
+    style: &str,
+) {
+    use std::fmt::Write as _;
+    let _ = write!(
+        out,
+        r#"<text text-anchor="middle" style="{}">"#,
+        crate::svg::parity::escape_xml_display(style)
+    );
+    let advance = font_size * ratio;
+    let first =
+        center_y - (lines.len().saturating_sub(1) as f64) * advance / 2.0 + font_size * 0.35;
+    for (i, words) in lines.iter().enumerate() {
+        let _ = write!(
+            out,
+            r#"<tspan class="text-outer-tspan row" x="0" y="{}">{}</tspan>"#,
+            crate::svg::parity::fmt_display(first + i as f64 * advance),
+            crate::svg::parity::escape_xml_display(
+                crate::entities::decode_svg_text_content_entities(&words.join(" ")).as_ref()
+            )
+        );
+    }
+    out.push_str("</text>");
+}
