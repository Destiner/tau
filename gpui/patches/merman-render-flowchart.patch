+// SPDX-License-Identifier: EPL-2.0
+//! Opt-in flow-axis compaction and layer alignment.
+//!
+//! Compaction provenance: Eclipse ELK, elkjs 0.11.1 elk-worker.js,
+//! HorizontalGraphCompactor / EdgeAwareScanlineConstraintCalculation /
+//! OneDimensionalCompactor. See ELK-COMPACTION-LICENSE.md; corresponding
+//! modified Rust source is this file. Alignment retains its MIT attribution.
+//!
+//! Alignment follows beautiful-mermaid 1.1.3 layout-engine.ts (MIT; see
+//! BEAUTIFUL-MERMAID-LICENSE.md). Compaction implements ELK's orthogonal
+//! scanline constraints and two longest-path passes with constraint locking.
+//! It operates on projected rectangles, inline label boxes and routing channels,
+//! without relying on model IDs, label text, or expected diagram coordinates.
+use crate::model::{LayoutEdge, LayoutNode};
+use crate::{Error, Result};
+use std::collections::{HashMap, HashSet, VecDeque};
+
+#[cfg(test)]
+#[path = "post_layout_tests.rs"]
+mod tests;
+
+const EPS: f64 = 1e-4;
+
+struct Work<F> {
+    charge: F,
+    ordinal: usize,
+}
+impl<F: FnMut(usize) -> Result<()>> Work<F> {
+    fn tick(&mut self, units: usize) -> Result<()> {
+        self.ordinal = self.ordinal.checked_add(units).ok_or_else(limit_error)?;
+        if self.ordinal > 32_000 {
+            return Err(limit_error());
+        }
+        (self.charge)(units)
+    }
+}
+fn limit_error() -> Error {
+    Error::InvalidModel {
+        message: "flowchart post-layout work limit exceeded".into(),
+    }
+}
+
+#[derive(Clone, Copy)]
+pub(super) struct Axis {
+    horizontal: bool,
+    sign: f64,
+}
+impl Axis {
+    pub(super) fn new(direction: Option<&str>) -> Self {
+        Self {
+            horizontal: matches!(direction, Some("LR" | "RL")),
+            sign: if matches!(direction, Some("RL" | "BT")) {
+                -1.0
+            } else {
+                1.0
+            },
+        }
+    }
+    fn main(self, x: f64, y: f64) -> f64 {
+        self.sign * if self.horizontal { x } else { y }
+    }
+    fn cross(self, x: f64, y: f64) -> f64 {
+        if self.horizontal { y } else { x }
+    }
+    fn size(self, width: f64, height: f64) -> f64 {
+        if self.horizontal { width } else { height }
+    }
+    fn shift(self, x: &mut f64, y: &mut f64, delta: f64) {
+        if self.horizontal {
+            *x += self.sign * delta;
+        } else {
+            *y += self.sign * delta;
+        }
+    }
+}
+
+#[derive(Clone, Copy, PartialEq)]
+enum Kind {
+    Node,
+    Label,
+    Segment,
+}
+#[derive(Clone)]
+struct BoxItem {
+    main: f64,
+    cross: f64,
+    size: f64,
+    span: f64,
+    kind: Kind,
+    edges: HashSet<usize>,
+    points: Vec<(usize, usize)>,
+    owner: Option<usize>,
+    group: usize,
+    ignore_low: bool,
+    ignore_high: bool,
+}
+impl BoxItem {
+    fn rect(axis: Axis, x: f64, y: f64, width: f64, height: f64, kind: Kind, owner: usize) -> Self {
+        let size = axis.size(width, height);
+        let span = axis.size(height, width);
+        Self {
+            main: axis.main(x, y) - size / 2.0,
+            cross: axis.cross(x, y) - span / 2.0,
+            size,
+            span,
+            kind,
+            owner: Some(owner),
+            group: 0,
+            edges: HashSet::new(),
+            points: Vec::new(),
+            ignore_low: false,
+            ignore_high: false,
+        }
+    }
+    fn expand_cross(&mut self, delta: f64) {
+        if self.kind == Kind::Segment {
+            if self.ignore_low {
+                if !self.ignore_high {
+                    self.span += delta + 0.01;
+                }
+            } else {
+                self.cross -= delta + 0.01;
+                self.span += delta + 0.01;
+            }
+        } else {
+            self.cross -= delta;
+            self.span += 2.0 * delta;
+        }
+    }
+}
+
+#[derive(Clone, Copy)]
+pub(super) struct Spacing {
+    pub node_node: f64,
+    pub rank: f64,
+    pub edge_edge: f64,
+    pub edge_edge_between: f64,
+    pub edge_node_between: f64,
+}
+impl Spacing {
+    fn main(self, a: &BoxItem, b: &BoxItem) -> f64 {
+        if a.kind == Kind::Segment && b.kind == Kind::Segment {
+            if !a.edges.is_disjoint(&b.edges) {
+                0.0
+            } else {
+                self.edge_edge_between
+            }
+        } else if a.kind == Kind::Segment || b.kind == Kind::Segment {
+            self.edge_node_between
+        } else if a.kind == Kind::Label && b.kind == Kind::Label {
+            self.edge_edge
+        } else {
+            self.rank
+        }
+    }
+}
+
+// Scanline keeps only adjacent constraints; all-pairs overlap constraints would
+// unnecessarily pin nodes behind obstacles that are hidden by nearer channels.
+fn sweep<F: FnMut(usize) -> Result<()>>(
+    boxes: &[BoxItem],
+    selected: &[usize],
+    constraints: &mut HashSet<(usize, usize)>,
+    work: &mut Work<F>,
+) -> Result<()> {
+    work.tick(boxes.len() + selected.len().saturating_mul(2))?;
+    let mut events = Vec::with_capacity(selected.len() * 2);
+    for &i in selected {
+        events.push((boxes[i].cross, true, i));
+        events.push((boxes[i].cross + boxes[i].span, false, i));
+    }
+    work.tick(
+        events
+            .len()
+            .saturating_mul(events.len().max(1).ilog2() as usize + 1),
+    )?;
+    events.sort_by(|a, b| a.0.total_cmp(&b.0).then(a.1.cmp(&b.1)));
+    let mut active: Vec<usize> = Vec::new();
+    let mut candidates = vec![None; boxes.len()];
+    for (_, low, i) in events {
+        work.tick(1)?;
+        let center = |j: usize| boxes[j].main + boxes[j].size / 2.0;
+        let position = active.partition_point(|&j| center(j) < center(i));
+        work.tick(active.len().max(1).ilog2() as usize + 1)?;
+        if low {
+            // Projected zero-size runs can coincide; their geometry was merged
+            // beforehand. Stable ordinal ties also preserve provider model order.
+            let position = active
+                .partition_point(|&j| center(j).total_cmp(&center(i)).then(j.cmp(&i)).is_lt());
+            work.tick(active.len() - position + 1)?;
+            active.insert(position, i);
+            candidates[i] = position.checked_sub(1).map(|p| active[p]);
+            if position + 1 < active.len() {
+                candidates[active[position + 1]] = Some(i);
+            }
+        } else {
+            work.tick(active.len() - position + 1)?;
+            let position = active[position..]
+                .iter()
+                .position(|&j| j == i)
+                .map(|p| p + position)
+                .ok_or_else(|| Error::InvalidModel {
+                    message: "invalid flowchart compaction sweep".into(),
+                })?;
+            work.tick(active.len() - position + 1)?;
+            if let Some(p) = position.checked_sub(1) {
+                let left = active[p];
+                if candidates[i] == Some(left) && boxes[left].group != boxes[i].group {
+                    constraints.insert((left, i));
+                }
+            }
+            if let Some(&right) = active.get(position + 1)
+                && candidates[right] == Some(i)
+                && boxes[right].group != boxes[i].group
+            {
+                constraints.insert((i, right));
+            }
+            active.remove(position);
+        }
+    }
+    Ok(())
+}
+
+fn longest_path<F: FnMut(usize) -> Result<()>>(
+    boxes: &mut [BoxItem],
+    constraints: &[(usize, usize)],
+    spacing: Spacing,
+    reverse: bool,
+    work: &mut Work<F>,
+) -> Result<()> {
+    work.tick(boxes.len().saturating_mul(7) + constraints.len())?;
+    let groups = boxes.iter().map(|b| b.group).max().map_or(0, |g| g + 1);
+    let mut reference = vec![f64::INFINITY; groups];
+    for b in boxes.iter() {
+        reference[b.group] = reference[b.group].min(b.main);
+    }
+    let offset: Vec<_> = boxes.iter().map(|b| b.main - reference[b.group]).collect();
+    let minimum = boxes.iter().map(|b| b.main).fold(f64::INFINITY, f64::min);
+    let mut start = vec![minimum; groups];
+    let mut degree = vec![0usize; groups];
+    let mut adjacent = vec![Vec::new(); groups];
+    for &(a, b) in constraints {
+        degree[boxes[b].group] += 1;
+        adjacent[boxes[a].group].push((a, b));
+    }
+    let locked: Vec<_> = degree.iter().map(|&d| reverse && d == 0).collect();
+    let mut queue: VecDeque<_> = degree
+        .iter()
+        .enumerate()
+        .filter_map(|(i, &d)| (d == 0).then_some(i))
+        .collect();
+    let mut visited = 0;
+    while let Some(group) = queue.pop_front() {
+        work.tick(1)?;
+        visited += 1;
+        if locked[group] {
+            start[group] = start[group].max(reference[group]);
+        }
+        for &(a, b) in &adjacent[group] {
+            work.tick(1 + boxes[a].edges.len().min(boxes[b].edges.len()))?;
+            let target = boxes[b].group;
+            start[target] = start[target].max(
+                start[group] + offset[a] + boxes[a].size + spacing.main(&boxes[a], &boxes[b])
+                    - offset[b],
+            );
+            degree[target] -= 1;
+            if degree[target] == 0 {
+                queue.push_back(target);
+            }
+        }
+    }
+    if visited != groups {
+        return Err(Error::InvalidModel {
+            message: "cyclic flowchart compaction constraints".into(),
+        });
+    }
+    work.tick(boxes.len())?;
+    for (b, offset) in boxes.iter_mut().zip(offset) {
+        b.main = start[b.group] + offset;
+    }
+    Ok(())
+}
+
+pub(super) fn compact(
+    nodes: &mut [LayoutNode],
+    edges: &mut [LayoutEdge],
+    axis: Axis,
+    spacing: Spacing,
+    mut charge: impl FnMut(usize) -> Result<()>,
+) -> Result<()> {
+    let mut work = Work {
+        charge: &mut charge,
+        ordinal: 0,
+    };
+    work.tick(nodes.len() + edges.len())?;
+    let node_map: HashMap<_, _> = nodes
+        .iter()
+        .enumerate()
+        .map(|(i, n)| (n.id.clone(), i))
+        .collect();
+    let mut boxes: Vec<_> = nodes
+        .iter()
+        .enumerate()
+        .map(|(i, n)| BoxItem::rect(axis, n.x, n.y, n.width, n.height, Kind::Node, i))
+        .collect();
+    // ELK compacts label dummies before removing them. Reconstruct their measured
+    // inline rectangles, not a new label anchor chosen from endpoint names.
+    for (i, e) in edges.iter().enumerate() {
+        work.tick(1)?;
+        if e.from != e.to
+            && let Some(l) = &e.label
+        {
+            let mut b = BoxItem::rect(axis, l.x, l.y, l.width, l.height, Kind::Label, i);
+            b.edges.insert(i);
+            boxes.push(b);
+        }
+    }
+    let rectangles = boxes.len();
+    let mut segments: Vec<BoxItem> = Vec::new();
+    for (ei, e) in edges.iter().enumerate() {
+        work.tick(e.points.len())?;
+        if e.from == e.to || e.points.len() < 4 {
+            continue;
+        }
+        let mut found = Vec::new();
+        for pi in 1..e.points.len() - 2 {
+            let a = &e.points[pi];
+            let b = &e.points[pi + 1];
+            if (axis.main(a.x, a.y) - axis.main(b.x, b.y)).abs() <= EPS
+                && (axis.cross(a.x, a.y) - axis.cross(b.x, b.y)).abs() > EPS
+            {
+                found.push(segments.len());
+                let lo = axis.cross(a.x, a.y).min(axis.cross(b.x, b.y));
+                let hi = axis.cross(a.x, a.y).max(axis.cross(b.x, b.y));
+                segments.push(BoxItem {
+                    main: axis.main(a.x, a.y),
+                    cross: lo,
+                    size: 0.0,
+                    span: hi - lo,
+                    kind: Kind::Segment,
+                    edges: HashSet::from([ei]),
+                    points: vec![(ei, pi), (ei, pi + 1)],
+                    owner: None,
+                    group: 0,
+                    ignore_low: false,
+                    ignore_high: false,
+                });
+            }
+        }
+        for (si, ni, pi) in found
+            .first()
+            .zip(node_map.get(e.from.as_str()))
+            .map(|(&si, &ni)| (si, ni, segments[si].points[1].1))
+            .into_iter()
+            .chain(
+                found
+                    .last()
+                    .zip(node_map.get(e.to.as_str()))
+                    .map(|(&si, &ni)| (si, ni, segments[si].points[0].1)),
+            )
+        {
+            let n = &boxes[ni];
+            let cross = axis.cross(e.points[pi].x, e.points[pi].y);
+            if cross < n.cross {
+                segments[si].ignore_high = true;
+            } else if cross > n.cross + n.span {
+                segments[si].ignore_low = true;
+            } else {
+                segments[si].ignore_low = true;
+                segments[si].ignore_high = true;
+            }
+        }
+    }
+    work.tick(
+        segments
+            .len()
+            .saturating_mul(segments.len().max(1).ilog2() as usize + 1),
+    )?;
+    segments.sort_by(|a, b| a.main.total_cmp(&b.main).then(a.cross.total_cmp(&b.cross)));
+    for segment in segments {
+        work.tick(segment.points.len() + segment.edges.len() + 1)?;
+        if boxes.len() > rectangles
+            && let Some(last) = boxes.last_mut()
+            && (last.main - segment.main).abs() <= EPS
+            && segment.cross <= last.cross + last.span + EPS
+        {
+            last.span = (last.cross + last.span).max(segment.cross + segment.span) - last.cross;
+            last.edges.extend(segment.edges);
+            last.points.extend(segment.points);
+            last.ignore_low |= segment.ignore_low;
+            last.ignore_high |= segment.ignore_high;
+        } else {
+            boxes.push(segment);
+        }
+    }
+    for (i, b) in boxes.iter_mut().enumerate() {
+        b.group = i;
+    }
+    let original: Vec<_> = boxes.iter().map(|b| b.main).collect();
+    let mut constraints = HashSet::new();
+    let edge_expansion = (spacing.edge_edge / 2.0 - 0.5).max(0.0);
+    let min_expansion = edge_expansion.min((spacing.node_node / 2.0 - 0.5).max(0.0));
+    for pass in 0..3 {
+        work.tick(
+            boxes
+                .iter()
+                .map(|b| 2 + b.points.len() + b.edges.len())
+                .sum(),
+        )?;
+        let selected: Vec<_> = boxes
+            .iter()
+            .enumerate()
+            .filter_map(|(i, b)| {
+                (pass == 2 || (b.kind == Kind::Segment) == (pass == 0)).then_some(i)
+            })
+            .collect();
+        let mut expanded = boxes.clone();
+        for &i in &selected {
+            expanded[i].expand_cross(if pass == 2 {
+                min_expansion
+            } else {
+                edge_expansion
+            });
+        }
+        sweep(&expanded, &selected, &mut constraints, &mut work)?;
+    }
+    // Sort constraints for reproducibility independent of HashSet's random seed.
+    work.tick(
+        constraints
+            .len()
+            .saturating_mul(constraints.len().max(1).ilog2() as usize + 1),
+    )?;
+    let mut constraints: Vec<_> = constraints.into_iter().collect();
+    constraints.sort_unstable();
+    longest_path(&mut boxes, &constraints, spacing, false, &mut work)?;
+    work.tick(boxes.len() + constraints.len())?;
+    for b in &mut boxes {
+        b.main = -b.main - b.size;
+    }
+    for pair in &mut constraints {
+        *pair = (pair.1, pair.0);
+    }
+    longest_path(&mut boxes, &constraints, spacing, true, &mut work)?;
+    for b in &mut boxes {
+        b.main = -b.main - b.size;
+    }
+    work.tick(nodes.len() + edges.len())?;
+    let mut deltas = vec![0.0; nodes.len()];
+    for (b, old) in boxes.iter().zip(original) {
+        let delta = b.main - old;
+        match b.kind {
+            Kind::Node => {
+                let i = b.owner.unwrap();
+                deltas[i] = delta;
+                axis.shift(&mut nodes[i].x, &mut nodes[i].y, delta);
+            }
+            Kind::Label => {
+                let l = edges[b.owner.unwrap()].label.as_mut().unwrap();
+                axis.shift(&mut l.x, &mut l.y, delta);
+            }
+            Kind::Segment => {
+                work.tick(b.points.len())?;
+                for &(ei, pi) in &b.points {
+                    let p = &mut edges[ei].points[pi];
+                    axis.shift(&mut p.x, &mut p.y, delta);
+                }
+            }
+        }
+    }
+    for e in edges.iter_mut() {
+        work.tick(e.points.len())?;
+        if e.from == e.to {
+            if let Some(&i) = node_map.get(e.from.as_str()) {
+                for p in &mut e.points {
+                    axis.shift(&mut p.x, &mut p.y, deltas[i]);
+                }
+                if let Some(l) = &mut e.label {
+                    axis.shift(&mut l.x, &mut l.y, deltas[i]);
+                }
+            }
+        } else {
+            if let Some(&i) = node_map.get(e.from.as_str())
+                && let Some(p) = e.points.first_mut()
+            {
+                axis.shift(&mut p.x, &mut p.y, deltas[i]);
+            }
+            if let Some(&i) = node_map.get(e.to.as_str())
+                && let Some(p) = e.points.last_mut()
+            {
+                axis.shift(&mut p.x, &mut p.y, deltas[i]);
+            }
+        }
+    }
+    Ok(())
+}
+
+pub(super) fn align_layers(
+    nodes: &mut [LayoutNode],
+    edges: &mut [LayoutEdge],
+    axis: Axis,
+    mut charge: impl FnMut(usize) -> Result<()>,
+) -> Result<()> {
+    let mut work = Work {
+        charge: &mut charge,
+        ordinal: 0,
+    };
+    work.tick(nodes.len() + edges.len())?;
+    let mut connected = HashSet::new();
+    for e in edges.iter() {
+        connected.insert((e.from.as_str(), e.to.as_str()));
+        connected.insert((e.to.as_str(), e.from.as_str()));
+    }
+    let position = |n: &LayoutNode| {
+        if axis.horizontal {
+            n.x - n.width / 2.0
+        } else {
+            n.y - n.height / 2.0
+        }
+    };
+    let mut sorted: Vec<_> = nodes
+        .iter()
+        .enumerate()
+        .filter_map(|(i, n)| (!n.is_cluster).then_some(i))
+        .collect();
+    work.tick(
+        sorted
+            .len()
+            .saturating_mul(sorted.len().max(1).ilog2() as usize + 1),
+    )?;
+    sorted.sort_by(|&a, &b| position(&nodes[a]).total_cmp(&position(&nodes[b])));
+    let mut layers: Vec<Vec<usize>> = Vec::new();
+    for &i in &sorted {
+        work.tick(1)?;
+        let join = if let Some(layer) = layers.last() {
+            work.tick(layer.len())?;
+            position(&nodes[i]) - position(&nodes[*layer.last().unwrap()]) <= 48.0 * 0.6
+                && !layer
+                    .iter()
+                    .any(|&j| connected.contains(&(nodes[j].id.as_str(), nodes[i].id.as_str())))
+        } else {
+            false
+        };
+        if join {
+            layers.last_mut().unwrap().push(i);
+        } else {
+            layers.push(vec![i]);
+        }
+    }
+    let mut deltas = HashMap::new();
+    for layer in layers {
+        work.tick(layer.len())?;
+        let low = layer
+            .iter()
+            .map(|&i| position(&nodes[i]))
+            .fold(f64::INFINITY, f64::min);
+        let high = layer
+            .iter()
+            .map(|&i| position(&nodes[i]))
+            .fold(f64::NEG_INFINITY, f64::max);
+        if high - low <= 1.0 {
+            continue;
+        }
+        let target = (low + high) / 2.0;
+        for i in layer {
+            let delta = target - position(&nodes[i]);
+            if delta.abs() > 0.5 {
+                if axis.horizontal {
+                    nodes[i].x += delta;
+                } else {
+                    nodes[i].y += delta;
+                }
+                deltas.insert(nodes[i].id.as_str(), delta);
+            }
+        }
+    }
+    for e in edges.iter_mut() {
+        work.tick(1)?;
+        if e.points.len() < 2 {
+            continue;
+        }
+        for (id, first, adjacent) in [
+            (&e.from, 0, 1),
+            (&e.to, e.points.len() - 1, e.points.len() - 2),
+        ] {
+            if let Some(&delta) = deltas.get(id.as_str()) {
+                let old = if axis.horizontal {
+                    e.points[first].x
+                } else {
+                    e.points[first].y
+                };
+                let adj = if axis.horizontal {
+                    e.points[adjacent].x
+                } else {
+                    e.points[adjacent].y
+                };
+                if axis.horizontal {
+                    e.points[first].x += delta;
+                } else {
+                    e.points[first].y += delta;
+                }
+                if adj == old {
+                    if axis.horizontal {
+                        e.points[adjacent].x += delta;
+                    } else {
+                        e.points[adjacent].y += delta;
+                    }
+                }
+            }
+        }
+    }
+    Ok(())
+}
