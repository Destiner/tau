@@ -0,0 +1,255 @@
+//! Opt-in post-layout trunks; adapted from beautiful-mermaid 1.1.3 layout-engine.ts.
+//! See BEAUTIFUL-MERMAID-LICENSE.md. ELK mergeEdges remains independent.
+use super::FlowchartModel;
+use crate::model::{LayoutCluster, LayoutEdge, LayoutNode, LayoutPoint};
+use crate::{Error, Result};
+use std::collections::{HashMap, HashSet};
+
+pub(super) fn bundle(
+    model: &FlowchartModel,
+    nodes: &[LayoutNode],
+    clusters: &[LayoutCluster],
+    edges: &mut [LayoutEdge],
+    mut charge: impl FnMut(usize) -> Result<()>,
+) -> Result<()> {
+    let horizontal = matches!(model.direction.as_deref(), Some("LR" | "RL"));
+    let reverse = matches!(model.direction.as_deref(), Some("RL" | "BT"));
+    let sign = if reverse { -1.0 } else { 1.0 };
+    let node_map: HashMap<_, _> = nodes.iter().map(|n| (n.id.as_str(), n)).collect();
+    let source_map: HashMap<_, _> = model.edges.iter().map(|e| (e.id.as_str(), e)).collect();
+    let mut processed = HashSet::new();
+    let mut ordinal = 0usize;
+    let mut tick = || -> Result<()> {
+        ordinal += 1;
+        if ordinal > 32_000 {
+            return Err(Error::InvalidModel {
+                message: "flowchart bundling work limit exceeded".into(),
+            });
+        }
+        charge(1)
+    };
+    let main = |n: &LayoutNode| if horizontal { n.x } else { n.y };
+    let cross = |n: &LayoutNode| if horizontal { n.y } else { n.x };
+    let half = |n: &LayoutNode| {
+        if horizontal {
+            n.width / 2.0
+        } else {
+            n.height / 2.0
+        }
+    };
+    let point = |m, c| {
+        if horizontal {
+            LayoutPoint { x: m, y: c }
+        } else {
+            LayoutPoint { x: c, y: m }
+        }
+    };
+    for fan_in in [false, true] {
+        let mut group_index = HashMap::new();
+        let mut groups: Vec<(&str, Vec<usize>)> = Vec::new();
+        for (i, edge) in edges.iter().enumerate() {
+            tick()?;
+            if edge.from == edge.to || (fan_in && processed.contains(&i)) {
+                continue;
+            }
+            let id = if fan_in {
+                edge.to.as_str()
+            } else {
+                edge.from.as_str()
+            };
+            let index = *group_index.entry(id).or_insert_with(|| {
+                groups.push((id, Vec::new()));
+                groups.len() - 1
+            });
+            groups[index].1.push(i);
+        }
+        // Preserve Source Map insertion order, then own keys before replacing paths.
+        let groups: Vec<_> = groups
+            .into_iter()
+            .map(|(id, group)| (id.to_owned(), group))
+            .collect();
+        for (id, group) in groups {
+            tick()?;
+            if group.len() < 2 {
+                continue;
+            }
+            let Some(reference) = node_map.get(id.as_str()).copied() else {
+                continue;
+            };
+            let first = source_map[edges[group[0]].id.as_str()];
+            let mut eligible = true;
+            for &i in &group {
+                tick()?;
+                let e = source_map[edges[i].id.as_str()];
+                if edges[i].label.is_some()
+                    || e.stroke != first.stroke
+                    || e.style != first.style
+                    || e.classes != first.classes
+                {
+                    eligible = false;
+                }
+            }
+            if !eligible {
+                continue;
+            }
+            let mut forward = Vec::new();
+            for i in group {
+                tick()?;
+                let e = &edges[i];
+                let Some(other) = node_map
+                    .get(if fan_in {
+                        e.from.as_str()
+                    } else {
+                        e.to.as_str()
+                    })
+                    .copied()
+                else {
+                    continue;
+                };
+                let gap = if fan_in {
+                    main(reference) * sign - half(reference) - (main(other) * sign + half(other))
+                } else {
+                    main(other) * sign - half(other) - (main(reference) * sign + half(reference))
+                };
+                if gap > 0.0 {
+                    forward.push((i, other));
+                }
+            }
+            if forward.len() < 2 {
+                continue;
+            }
+            let boundary = main(reference)
+                + if fan_in {
+                    -sign * half(reference)
+                } else {
+                    sign * half(reference)
+                };
+            let mut nearest = if fan_in {
+                f64::NEG_INFINITY
+            } else {
+                f64::INFINITY
+            };
+            for (_, other) in &forward {
+                tick()?;
+                let b = main(other) * sign + if fan_in { half(other) } else { -half(other) };
+                nearest = if fan_in {
+                    nearest.max(b)
+                } else {
+                    nearest.min(b)
+                };
+            }
+            let mut junction = (boundary + nearest * sign) / 2.0;
+            let contains = |c: &LayoutCluster, x: f64, y: f64| {
+                x >= c.x - c.width / 2.0
+                    && x <= c.x + c.width / 2.0
+                    && y >= c.y - c.height / 2.0
+                    && y <= c.y + c.height / 2.0
+            };
+            let probe = point(junction, cross(reference));
+            // Largest enclosing foreign group is the outer boundary that must be cleared.
+            let mut crossing: Option<&LayoutCluster> = None;
+            for c in clusters {
+                tick()?;
+                if contains(c, probe.x, probe.y)
+                    && !contains(c, reference.x, reference.y)
+                    && crossing.is_none_or(|old| c.width * c.height > old.width * old.height)
+                {
+                    crossing = Some(c);
+                }
+            }
+            if let Some(c) = crossing {
+                junction = if horizontal {
+                    c.x - sign * (c.width / 2.0 + 12.0)
+                } else {
+                    c.y - sign * (c.height / 2.0 + 12.0)
+                };
+            }
+            for (i, other) in forward {
+                tick()?;
+                let (src, dst) = if fan_in {
+                    (other, reference)
+                } else {
+                    (reference, other)
+                };
+                let exit = main(src) + sign * half(src);
+                let entry = main(dst) - sign * half(dst);
+                edges[i].points = vec![
+                    point(exit, cross(src)),
+                    point(junction, cross(src)),
+                    point(junction, cross(dst)),
+                    point(entry, cross(dst)),
+                ];
+                if !fan_in {
+                    processed.insert(i);
+                }
+            }
+        }
+    }
+    Ok(())
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use serde_json::json;
+
+    fn fixture() -> (FlowchartModel, Vec<LayoutNode>, Vec<LayoutEdge>) {
+        let model: FlowchartModel =
+            serde_json::from_value(json!({"direction":"TD","nodes":[],"edges":[
+                {"id":"e1","from":"A","to":"B","label":null,"length":1},
+                {"id":"e2","from":"A","to":"C","label":null,"length":1}
+            ]}))
+            .unwrap();
+        let nodes = [("A", 0.0, 0.0), ("B", -40.0, 100.0), ("C", 40.0, 100.0)]
+            .into_iter()
+            .map(|(id, x, y)| {
+                serde_json::from_value(
+                    json!({"id":id,"x":x,"y":y,"width":40,"height":30,"is_cluster":false}),
+                )
+                .unwrap()
+            })
+            .collect();
+        let edges = model
+            .edges
+            .iter()
+            .map(|e| {
+                serde_json::from_value(
+                    json!({"id":e.id,"from":e.from,"to":e.to,"points":[],"label":null}),
+                )
+                .unwrap()
+            })
+            .collect();
+        (model, nodes, edges)
+    }
+
+    #[test]
+    fn shared_trunks_are_post_layout_and_orthogonal() {
+        let (model, nodes, mut edges) = fixture();
+        bundle(&model, &nodes, &[], &mut edges, |_| Ok(())).unwrap();
+        for i in 0..2 {
+            assert_eq!(edges[0].points[i].x, edges[1].points[i].x);
+            assert_eq!(edges[0].points[i].y, edges[1].points[i].y);
+        }
+        for e in edges {
+            for p in e.points.windows(2) {
+                assert!(p[0].x == p[1].x || p[0].y == p[1].y);
+            }
+        }
+    }
+
+    #[test]
+    fn bundling_charges_the_shared_budget_and_has_one_graph_ordinal_guard() {
+        let (model, nodes, mut edges) = fixture();
+        assert!(
+            bundle(&model, &nodes, &[], &mut edges, |_| Err(
+                Error::InvalidModel {
+                    message: "exhausted".into()
+                }
+            ))
+            .is_err()
+        );
+        let mut edges = vec![edges[0].clone(); 32_001];
+        let error = bundle(&model, &[], &[], &mut edges, |_| Ok(())).unwrap_err();
+        assert!(error.to_string().contains("bundling work limit"));
+    }
+}
