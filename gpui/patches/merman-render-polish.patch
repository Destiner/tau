+//! Paint-only primitives for the opt-in compact/native presentations.
+use super::*;
+
+pub(super) fn label_backplate(
+    config: &serde_json::Value,
+    width: f64,
+    height: f64,
+    padding: (f64, f64),
+    stroke_width: f64,
+) -> String {
+    let width = width.max(0.0) + padding.0 * 2.0;
+    let height = height.max(0.0) + padding.1 * 2.0;
+    let fill = theme_token(config, "background", "#ffffff");
+    let fallback_stroke = theme_token(config, "nodeBorder", "#9370DB");
+    let stroke = theme_token(config, "edgeLabelBorderColor", &fallback_stroke);
+    format!(
+        r#"<rect class="native-edge-label-background" x="{}" y="{}" width="{}" height="{}" rx="2" ry="2" style="fill:{};stroke:{};stroke-width:{};opacity:1"/>"#,
+        fmt(-width / 2.0),
+        fmt(-height / 2.0),
+        fmt(width),
+        fmt(height),
+        escape_xml(&fill),
+        escape_xml(&stroke),
+        fmt(stroke_width)
+    )
+}
+
+#[cfg(any(
+    feature = "diagram-flowchart",
+    feature = "diagram-agentflow",
+    feature = "diagram-swimlane"
+))]
+pub(super) fn flow_enabled(config: &serde_json::Value) -> bool {
+    config
+        .pointer("/flowchart/nativeLabelProfile")
+        .is_some_and(serde_json::Value::is_object)
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    #[test]
+    fn backplates_are_centered_and_preserve_family_padding() {
+        for (padding, stroke, expected) in [
+            ((8.0, 8.0), 1.0, (36.0, 30.0)),
+            ((4.0, 3.0), 0.5, (28.0, 20.0)),
+        ] {
+            let svg = label_backplate(
+                &serde_json::json!({"themeVariables":{"background":"#151515","nodeBorder":"#444444"}}),
+                20.0,
+                14.0,
+                padding,
+                stroke,
+            );
+            assert!(svg.contains(&format!(
+                "width=\"{}\" height=\"{}\"",
+                fmt(expected.0),
+                fmt(expected.1)
+            )));
+            assert!(svg.contains(&format!(
+                "x=\"{}\" y=\"{}\"",
+                fmt(-expected.0 / 2.0),
+                fmt(-expected.1 / 2.0)
+            )));
+            assert!(svg.contains("rx=\"2\" ry=\"2\""));
+            assert!(svg.contains("fill:#151515;stroke:#444444"));
+        }
+    }
+}
