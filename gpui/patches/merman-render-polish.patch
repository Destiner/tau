+use crate::{
+    LayoutOptions,
+    environment::RenderEnvironment,
+    family,
+    svg::{SvgDebugOptions, SvgRenderOptions},
+};
+use futures::executor::block_on;
+use merman_core::{Engine, MermaidConfig, ParseOptions};
+use serde_json::{Value, json};
+
+#[test]
+#[cfg(all(feature = "diagram-flowchart", feature = "layout-elk"))]
+fn aligned_flow_retains_provider_extent_in_both_palettes() {
+    let source = "flowchart TD\nS[Start; α] --> R{Retry?}\nR --> Q[Queue]\nR --> P[Primary]\nR --> F[Fallback]\nF --> P2[Secondary] --> OK[Accepted; ✓]\nP & P2 --> W[Wait]\nE[External] --> W\nW --> Z[Retry timer]\nZ --> R\nW --> T[Timeout]\nR -.remaining-deadline fires.-> T";
+    for dark in [false, true] {
+        let mut cfg = config(dark);
+        cfg["layout"] = json!("elk");
+        cfg["flowchart"]["nativePostCompaction"] = json!("LEFT_RIGHT_CONSTRAINT_LOCKING");
+        cfg["flowchart"]["nativeAlignLayers"] = json!(true);
+        let (layout, svg) = render(source, cfg.clone());
+        let bounds = &layout["layout"]["FlowchartV2"]["bounds"];
+        let doc = roxmltree::Document::parse(&svg).unwrap();
+        let viewport: Vec<f64> = doc
+            .root_element()
+            .attribute("viewBox")
+            .unwrap()
+            .split_whitespace()
+            .map(|v| v.parse().unwrap())
+            .collect();
+        assert!(viewport[0] <= bounds["min_x"].as_f64().unwrap());
+        assert!(viewport[1] <= bounds["min_y"].as_f64().unwrap());
+        assert!(viewport[0] + viewport[2] >= bounds["max_x"].as_f64().unwrap());
+        assert!(viewport[1] + viewport[3] >= bounds["max_y"].as_f64().unwrap());
+
+        cfg["flowchart"]
+            .as_object_mut()
+            .unwrap()
+            .remove("nativeAlignLayers");
+        let stock = render(source, cfg.clone());
+        for disabled in [json!(false), json!("true"), json!(1), Value::Null] {
+            cfg["flowchart"]["nativeAlignLayers"] = disabled;
+            let disabled = render(source, cfg.clone());
+            assert_eq!(stock.0["layout"], disabled.0["layout"]);
+            assert_eq!(stock.1, disabled.1);
+        }
+    }
+}
+
+#[test]
+#[cfg(all(feature = "diagram-flowchart", feature = "layout-elk"))]
+fn native_asymmetric_is_convex_and_connected_in_both_directions() {
+    for direction in ["LR", "RL", "TD", "BT"] {
+        for dark in [false, true] {
+            let source =
+                format!("flowchart {direction}\nL[Left] --- A>\"Readable α\"] --- R[Right]");
+            let mut cfg = config(dark);
+            cfg["layout"] = json!("elk");
+            cfg["look"] = json!("classic");
+            cfg["handDrawnSeed"] = json!(1);
+            cfg["flowchart"]["nativeNodePaddingHorizontal"] = json!(16);
+            cfg["flowchart"]["nativeNodePaddingVertical"] = json!(12);
+            cfg["flowchart"]["nativeNodeLineHeight"] = json!(1.3);
+            let (layout, svg) = render(&source, cfg.clone());
+            let doc = roxmltree::Document::parse(&svg).unwrap();
+            let polygon = doc
+                .descendants()
+                .find(|n| {
+                    n.has_tag_name("polygon")
+                        && n.attribute("class") == Some("label-container outer-path")
+                })
+                .unwrap();
+            let coordinates: Vec<f64> = polygon
+                .attribute("points")
+                .unwrap()
+                .split(|c: char| c == ',' || c.is_whitespace())
+                .filter(|s| !s.is_empty())
+                .map(|s| s.parse().unwrap())
+                .collect();
+            assert_eq!(coordinates.len(), 10);
+            assert_eq!(coordinates[0] - coordinates[8], 12.0);
+            assert_eq!(coordinates[6] - coordinates[8], 12.0);
+            assert_eq!(coordinates[9], 0.0);
+            assert_eq!(polygon.attribute("transform"), Some("translate(0,0)"));
+            let flow = &layout["layout"]["FlowchartV2"];
+            assert_eq!(flow["nodes"].as_array().unwrap().len(), 3);
+            assert_eq!(flow["edges"].as_array().unwrap().len(), 2);
+            assert!(svg.contains("Readable α"));
+            let node = flow["nodes"]
+                .as_array()
+                .unwrap()
+                .iter()
+                .find(|n| n["id"] == "A")
+                .unwrap();
+            let cx = node["x"].as_f64().unwrap();
+            let cy = node["y"].as_f64().unwrap();
+            let points: Vec<(f64, f64)> = (0..5)
+                .map(|i| (coordinates[2 * i], coordinates[2 * i + 1]))
+                .collect();
+            let on_boundary = |x: f64, y: f64| {
+                (0..5).any(|i| {
+                    let (ax, ay) = points[i];
+                    let (bx, by) = points[(i + 1) % 5];
+                    let cross = (x - ax) * (by - ay) - (y - ay) * (bx - ax);
+                    cross.abs() < 1e-5
+                        && x >= ax.min(bx) - 1e-5
+                        && x <= ax.max(bx) + 1e-5
+                        && y >= ay.min(by) - 1e-5
+                        && y <= ay.max(by) + 1e-5
+                })
+            };
+            for edge in flow["edges"].as_array().unwrap() {
+                assert!(matches!(
+                    (edge["from"].as_str().unwrap(), edge["to"].as_str().unwrap()),
+                    ("L", "A") | ("A", "R")
+                ));
+                let path = doc
+                    .descendants()
+                    .find(|n| {
+                        n.attribute("data-id") == edge["id"].as_str() && n.has_tag_name("path")
+                    })
+                    .unwrap();
+                let values: Vec<f64> = path
+                    .attribute("d")
+                    .unwrap()
+                    .split(|c: char| c.is_ascii_alphabetic() || c == ',' || c.is_whitespace())
+                    .filter(|s| !s.is_empty())
+                    .map(|s| s.parse().unwrap())
+                    .collect();
+                let endpoint = if edge["from"] == "A" {
+                    &values[..2]
+                } else {
+                    &values[values.len() - 2..]
+                };
+                assert!(
+                    on_boundary(endpoint[0] - cx, endpoint[1] - cy),
+                    "{direction}: painted edge must terminate on the convex polygon, not the old notch"
+                );
+            }
+            // A conservative rectangle inside the convex polygon contains the measured label.
+            use crate::text::{DeterministicTextMeasurer, TextMeasurer, TextStyle};
+            let metrics = DeterministicTextMeasurer::default().measure(
+                "Readable α",
+                &TextStyle {
+                    font_family: Some("TauInter".into()),
+                    font_size: 13.0,
+                    font_weight: Some("500".into()),
+                    font_style: None,
+                },
+            );
+            assert!(-metrics.width / 2.0 > coordinates[0]);
+            assert!(metrics.width / 2.0 < coordinates[2]);
+            assert!(metrics.height < node["height"].as_f64().unwrap());
+            let label = polygon
+                .parent()
+                .unwrap()
+                .children()
+                .find(|n| n.attribute("class") == Some("label"))
+                .unwrap();
+            assert!(
+                label
+                    .attribute("transform")
+                    .unwrap()
+                    .starts_with("translate(0,")
+            );
+            // Non-object values cannot enable the native silhouette.
+            cfg["flowchart"]
+                .as_object_mut()
+                .unwrap()
+                .remove("nativeLabelProfile");
+            let stock = render(&source, cfg.clone());
+            assert_ne!(svg, stock.1);
+            for disabled in [
+                Value::Null,
+                json!(false),
+                json!("compact"),
+                json!(1),
+                json!([]),
+            ] {
+                cfg["flowchart"]["nativeLabelProfile"] = disabled;
+                let disabled = render(&source, cfg.clone());
+                assert_eq!(stock.0["layout"], disabled.0["layout"]);
+                let doc = roxmltree::Document::parse(&disabled.1).unwrap();
+                assert!(!doc.descendants().any(|n| n.has_tag_name("polygon")
+                    && n.attribute("class") == Some("label-container outer-path")));
+            }
+        }
+    }
+}
+
+fn config(dark: bool) -> Value {
+    json!({"htmlLabels":false,"fontFamily":"TauInter","fontSize":false,"themeVariables":{
+        "fontFamily":"TauInter","fontSize":"11px","background":if dark {"#151515"} else {"#ffffff"},
+        "textColor":"#777777","arrowheadColor":"#777777","lineColor":"#888888","nodeBorder":"#444444","edgeLabelBorderColor":"#333333"
+    },"class":{"presentationProfile":"compact","memberFontFamily":"Menlo"},
+    "er":{"presentationProfile":"compact","attributeFontFamily":"Menlo"},
+    "state":{"presentationProfile":"compact"},"sequence":{"presentationProfile":"compact"},
+    "flowchart":{"htmlLabels":false,"nativeEdgeLineHeight":1.3,"nativeLabelProfile":{
+        "node":{"fontSize":13,"fontWeight":500},"edge":{"fontSize":11,"fontWeight":400}
+    }}})
+}
+fn render(source: &str, config: Value) -> (Value, String) {
+    render_in(source, config, RenderEnvironment::deterministic())
+}
+fn render_in(source: &str, config: Value, environment: RenderEnvironment) -> (Value, String) {
+    let parsed = block_on(
+        Engine::new()
+            .with_site_config(MermaidConfig::from_value(config))
+            .parse_diagram_for_render_model(source, ParseOptions::default()),
+    )
+    .unwrap()
+    .unwrap();
+    let artifact = family::prepare(
+        parsed,
+        &LayoutOptions::default(),
+        environment.begin_session().unwrap(),
+    )
+    .unwrap();
+    (
+        artifact.layout_json().unwrap(),
+        artifact
+            .render_svg(&SvgRenderOptions::default(), &SvgDebugOptions::default())
+            .unwrap()
+            .svg()
+            .to_owned(),
+    )
+}
+#[cfg(all(
+    feature = "diagram-flowchart",
+    feature = "diagram-state",
+    feature = "diagram-er"
+))]
+fn dimension(node: roxmltree::Node<'_, '_>, attr: &str) -> f64 {
+    node.attribute(attr).unwrap().parse().unwrap()
+}
+#[cfg(all(
+    feature = "diagram-flowchart",
+    feature = "diagram-state",
+    feature = "diagram-er"
+))]
+fn label_box(layout: &Value) -> &Value {
+    &layout["layout"]
+        .as_object()
+        .unwrap()
+        .values()
+        .next()
+        .unwrap()["edges"]
+        .as_array()
+        .unwrap()
+        .iter()
+        .find(|edge| edge["label"].is_object())
+        .unwrap()["label"]
+}
