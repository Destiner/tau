+#[test]
+#[cfg(all(feature = "diagram-class", feature = "diagram-er"))]
+fn header_measurement_and_paint_request_the_same_seven_hundred_weight() {
+    use crate::{
+        environment::{
+            MeasurementProfileId, TextMeasurementPolicy, TextMeasurementProfile,
+            TextMeasurementProfileIdentity,
+        },
+        text::{TextMeasurer, TextMetrics, TextStyle},
+    };
+    use std::sync::{Arc, Mutex};
+    #[derive(Default)]
+    struct Measure(Mutex<Vec<TextStyle>>);
+    impl TextMeasurer for Measure {
+        fn measure(&self, text: &str, style: &TextStyle) -> TextMetrics {
+            self.0.lock().unwrap().push(style.clone());
+            TextMetrics {
+                width: text.len() as f64 * 6.0,
+                height: style.font_size,
+                line_count: 1,
+            }
+        }
+    }
+    for source in [
+        "classDiagram\nclass Example {\n+String member\n}",
+        "erDiagram\nExample {\nstring member PK\n}",
+    ] {
+        let measurer = Arc::new(Measure::default());
+        let identity = TextMeasurementProfileIdentity::new(
+            MeasurementProfileId::new("test.compact-header").unwrap(),
+            "v1",
+        )
+        .unwrap();
+        let env = RenderEnvironment::deterministic().with_text_measurement_policy(
+            TextMeasurementPolicy::uniform(TextMeasurementProfile::new(identity, measurer.clone())),
+        );
+        let (_, svg) = render_in(source, config(false), env);
+        assert!(svg.contains("font-family:TauInter;font-size:13px;font-weight:700"));
+        let calls = measurer.0.lock().unwrap();
+        assert!(
+            calls
+                .iter()
+                .any(|s| s.font_family.as_deref() == Some("TauInter")
+                    && s.font_size == 13.0
+                    && s.font_weight.as_deref() == Some("700"))
+        );
+        assert!(
+            calls
+                .iter()
+                .any(|s| s.font_family.as_deref() == Some("Menlo")
+                    && s.font_size == 11.0
+                    && s.font_weight.as_deref() == Some("400"))
+        );
+    }
+}
