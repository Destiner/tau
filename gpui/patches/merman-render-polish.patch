+pub(super) fn compact_class_markers(
+    out: &mut String,
+    diagram_id: SvgDiagramId<'_>,
+    diagram_type: &str,
+    config: &serde_json::Value,
+) {
+    let canvas = theme_token(config, "background", "#ffffff");
+    let arrow = theme_token(config, "arrowheadColor", "#333333");
+    for (kind, points, width, height, stroke_width) in [
+        ("extension", "0,0 12,5 0,10", 12, 10, 1.5),
+        ("aggregation", "6,0 12,5 6,10 0,5", 12, 10, 1.5),
+        ("composition", "6,0 12,5 6,10 0,5", 12, 10, 1.0),
+        ("dependency", "0,0 8,3 0,6", 8, 6, 1.5),
+    ] {
+        for start in [true, false] {
+            for margin in [false, true] {
+                let end = if start { "Start" } else { "End" };
+                let suffix = if margin { "-margin" } else { "" };
+                let hollow = matches!(kind, "extension" | "aggregation");
+                let fill = if hollow {
+                    canvas.as_str()
+                } else if kind == "dependency" {
+                    "none"
+                } else {
+                    arrow.as_str()
+                };
+                let shape = if kind == "dependency" {
+                    "polyline"
+                } else {
+                    "polygon"
+                };
+                let _ = write!(
+                    out,
+                    r#"<defs><marker id="{diagram_id}_{}-{kind}{end}{suffix}" class="marker {kind} {}" markerUnits="userSpaceOnUse" markerWidth="{width}" markerHeight="{height}" refX="{}" refY="{}" orient="auto" overflow="visible"><{shape} points="{points}" transform="{}" style="fill:{};stroke:{};stroke-width:{};stroke-dasharray:0"/></marker></defs>"#,
+                    escape_xml(diagram_type),
+                    escape_xml(diagram_type),
+                    if start { width } else { 0 },
+                    fmt(height as f64 / 2.0),
+                    if start {
+                        format!("translate({width},0) scale(-1,1)")
+                    } else {
+                        String::new()
+                    },
+                    escape_xml(fill),
+                    escape_xml(&arrow),
+                    fmt(stroke_width)
+                );
+            }
+        }
+    }
+    // Lollipop relationships retain their distinct circle semantics.
+    for start in [true, false] {
+        for margin in [false, true] {
+            let end = if start { "Start" } else { "End" };
+            let suffix = if margin { "-margin" } else { "" };
+            let _ = write!(
+                out,
+                r#"<defs><marker id="{diagram_id}_{}-lollipop{end}{suffix}" class="marker lollipop {}" markerUnits="userSpaceOnUse" markerWidth="14" markerHeight="14" refX="{}" refY="7" orient="auto"><circle cx="7" cy="7" r="6" style="fill:{};stroke:{};stroke-width:1"/></marker></defs>"#,
+                escape_xml(diagram_type),
+                escape_xml(diagram_type),
+                if start { "13" } else { "1" },
+                escape_xml(&canvas),
+                escape_xml(&arrow)
+            );
+        }
+    }
+}
