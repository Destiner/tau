+#[cfg(any(
+    feature = "diagram-flowchart",
+    feature = "diagram-agentflow",
+    feature = "diagram-swimlane"
+))]
+pub(in crate::svg::parity) fn push_native_edge_marker(
+    out: &mut String,
+    diagram_id: SvgDiagramId<'_>,
+    diagram_type: &str,
+    base: &str,
+    margin: bool,
+    color: Option<(&str, Option<&str>)>,
+) {
+    if !matches!(base, "pointStart" | "pointEnd") {
+        push_edge_marker(out, diagram_id, diagram_type, base, margin, color);
+        return;
+    }
+    let start = base == "pointStart";
+    let ref_x = if margin {
+        if start { 0.0 } else { 8.0 }
+    } else {
+        4.0
+    };
+    let _ = write!(
+        out,
+        r#"<marker id="{diagram_id}_{}-{base}{}"#,
+        escape_xml_display(diagram_type),
+        if margin { "-margin" } else { "" }
+    );
+    if let Some((id, _)) = color {
+        let _ = write!(out, "_{}", escape_xml_display(id));
+    }
+    let _ = write!(
+        out,
+        r#"" class="marker {}" viewBox="0 0 8 5" refX="{}" refY="2.5" markerUnits="userSpaceOnUse" markerWidth="8" markerHeight="5" orient="auto"><path d="{}" class="arrowMarkerPath" style="stroke:none !important;stroke-dasharray:0""#,
+        escape_xml_display(diagram_type),
+        ref_x,
+        if start {
+            "M 8 0 L 0 2.5 L 8 5 z"
+        } else {
+            "M 0 0 L 8 2.5 L 0 5 z"
+        }
+    );
+    if let Some((_, Some(paint))) = color {
+        let _ = write!(out, r#" fill="{}""#, escape_xml_display(paint));
+    }
+    out.push_str("/></marker>");
+}
+
