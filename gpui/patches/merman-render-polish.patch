+#[test]
+#[cfg(all(
+    feature = "diagram-flowchart",
+    feature = "diagram-state",
+    feature = "diagram-er"
+))]
+fn measured_label_rectangles_keep_family_padding_and_ids_in_both_palettes() {
+    for dark in [false, true] {
+        for (source, padding, inset, stroke) in [
+            ("flowchart TD\nA -->|two<br/>lines| B", (8.0, 8.0), 4.0, "1"),
+            (
+                "stateDiagram-v2\nIdle --> Active: two<br/>lines",
+                (8.0, 8.0),
+                0.0,
+                "1",
+            ),
+            (
+                "erDiagram\nA ||--o{ B : \"two<br/>lines\"",
+                (4.0, 3.0),
+                0.0,
+                "0.5",
+            ),
+        ] {
+            let (layout, svg) = render(source, config(dark));
+            let doc = roxmltree::Document::parse(&svg).unwrap();
+            let rect = doc
+                .descendants()
+                .find(|n| n.attribute("class") == Some("native-edge-label-background"))
+                .unwrap();
+            let label = label_box(&layout);
+            let w = label["width"].as_f64().unwrap() - inset + 2.0 * padding.0;
+            let h = label["height"].as_f64().unwrap() - inset + 2.0 * padding.1;
+            assert!((dimension(rect, "width") - w).abs() < 0.01, "{source}");
+            assert!((dimension(rect, "height") - h).abs() < 0.01, "{source}");
+            assert!((dimension(rect, "x") + w / 2.0).abs() < 0.01);
+            assert!((dimension(rect, "y") + h / 2.0).abs() < 0.01);
+            assert_eq!(rect.attribute("rx"), Some("2"));
+            assert!(
+                rect.attribute("style")
+                    .unwrap()
+                    .contains(&format!("stroke-width:{stroke}"))
+            );
+            assert!(rect.attribute("style").unwrap().contains("stroke:#333333"));
+            assert!(rect.attribute("style").unwrap().contains(if dark {
+                "fill:#151515"
+            } else {
+                "fill:#ffffff"
+            }));
+            assert!(svg.contains("two") && svg.contains("lines"));
+            if !source.starts_with("state") {
+                assert!(
+                    rect.parent()
+                        .unwrap()
+                        .descendants()
+                        .any(|n| n.attribute("data-id").is_some())
+                );
+            }
+        }
+    }
+}
