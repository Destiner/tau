+#[cfg(test)]
+mod action_availability_tests {
+    use super::*;
+    use crate::{Context, IntoElement, Render, TestAppContext, div, prelude::*};
+    use std::cell::Cell;
+
+    crate::actions!(availability_tests, [Probe]);
+
+    struct Responder {
+        calls: Rc<Cell<usize>>,
+        explicit_policy: bool,
+        focus: crate::FocusHandle,
+    }
+
+    impl Render for Responder {
+        fn render(&mut self, _: &mut Window, _: &mut Context<Self>) -> impl IntoElement {
+            let calls = self.calls.clone();
+            let mut child = div()
+                .track_focus(&self.focus)
+                .on_action(move |_: &Probe, _, cx| {
+                    calls.set(calls.get() + 1);
+                    cx.propagate();
+                });
+            if self.explicit_policy {
+                child = child.action_availability::<Probe>(|_, _| true);
+            }
+            div()
+                .action_availability::<Probe>(|_, _| false)
+                .child(child)
+        }
+    }
+
+    fn register_global(cx: &mut App, capture: Rc<Cell<usize>>, bubble: Rc<Cell<usize>>) {
+        cx.global_action_listeners
+            .entry(TypeId::of::<Probe>())
+            .or_default()
+            .push(Rc::new(move |_, phase, cx| {
+                let count = match phase {
+                    DispatchPhase::Capture => &capture,
+                    DispatchPhase::Bubble => &bubble,
+                };
+                count.set(count.get() + 1);
+                cx.propagate();
+            }));
+    }
+
+    #[gpui::test]
+    fn global_validator_requires_handlers_and_blocks_both_app_dispatch_phases(
+        cx: &mut TestAppContext,
+    ) {
+        let capture = Rc::new(Cell::new(0));
+        let bubble = Rc::new(Cell::new(0));
+        cx.update(|cx| {
+            cx.on_action_available::<Probe>(|_, _| true);
+            assert!(!cx.is_action_available(&Probe));
+            cx.dispatch_action(&Probe);
+            register_global(cx, capture.clone(), bubble.clone());
+            cx.on_action_available::<Probe>(|_, _| false);
+            assert!(!cx.is_action_available(&Probe));
+            cx.dispatch_action(&Probe);
+            assert_eq!((capture.get(), bubble.get()), (0, 0));
+            cx.on_action_available::<Probe>(|_, _| true);
+            assert!(cx.is_action_available(&Probe));
+            cx.dispatch_action(&Probe);
+            assert_eq!((capture.get(), bubble.get()), (1, 1));
+        });
+    }
+
+    #[gpui::test]
+    fn denied_global_dispatch_preserves_nearest_window_responder(cx: &mut TestAppContext) {
+        let capture = Rc::new(Cell::new(0));
+        let bubble = Rc::new(Cell::new(0));
+        let local = Rc::new(Cell::new(0));
+        cx.update(|cx| {
+            register_global(cx, capture.clone(), bubble.clone());
+            cx.on_action_available::<Probe>(|_, _| false);
+        });
+        let window = cx.add_window({
+            let calls = local.clone();
+            move |w, cx| {
+                let focus = cx.focus_handle();
+                w.focus(&focus, cx);
+                Responder {
+                    calls,
+                    explicit_policy: false,
+                    focus,
+                }
+            }
+        });
+        window.update(cx, |_, w, _| w.activate_window()).unwrap();
+        cx.run_until_parked();
+        for explicit_policy in [false, true] {
+            window
+                .update(cx, |view, _, cx| {
+                    view.explicit_policy = explicit_policy;
+                    cx.notify();
+                })
+                .unwrap();
+            cx.update_window(window.into(), |_, w, cx| w.draw(cx).clear(cx))
+                .unwrap();
+            cx.update(|cx| {
+                assert!(cx.is_action_available(&Probe));
+                cx.dispatch_action(&Probe);
+            });
+            cx.run_until_parked();
+            window
+                .update(cx, |_, w, cx| w.dispatch_action(Box::new(Probe), cx))
+                .unwrap();
+            cx.run_until_parked();
+        }
+        assert_eq!(local.get(), 4);
+        assert_eq!((capture.get(), bubble.get()), (0, 0));
+    }
+}
