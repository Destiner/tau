+    #[gpui::test]
+    fn textarea_selection_newline_fills_only_hard_break_rows(cx: &mut TestAppContext) {
+        let (editor, window) = decoration_editor(cx, "ab\n\ncd", false);
+        let mut cx = VisualTestContext::from_window(window.into(), cx);
+        cx.update(|window, cx| {
+            window.draw(cx).clear(cx);
+            let state = editor.read(cx);
+            let layout = state.last_layout.as_ref().unwrap();
+            let corners = |range, full| {
+                TextElement::<EditorMode>::layout_range_corners_with_newlines(range, layout, full)
+                    .unwrap()
+            };
+            let default = corners(&(3..5), false);
+            let webkit = corners(&(3..5), true);
+            assert_eq!(webkit.len(), 2);
+            assert_eq!(webkit[0].top_left.x, px(0.));
+            assert_eq!(
+                webkit[0].top_right.x,
+                layout.content_width - layout.line_number_width
+            );
+            assert_eq!(
+                webkit[0].top_left.y,
+                layout.visible_top + layout.line_height
+            );
+            assert_eq!(webkit[1].top_left.y, webkit[0].bottom_left.y);
+            assert_eq!(webkit[1].top_right.x, default[1].top_right.x);
+            assert_eq!(default[0].top_right.x, layout.space_width);
+            assert_eq!(corners(&(3..4), true).len(), 1);
+            assert_eq!(corners(&(4..6), true).len(), 1);
+            assert_eq!(
+                corners(&(0..3), true)[0].top_right.x,
+                layout.content_width - layout.line_number_width
+            );
+            assert_eq!(
+                corners(&(4..6), true)[0].top_right.x,
+                corners(&(4..6), false)[0].top_right.x
+            );
+        });
+    }
