+    #[gpui::test]
+    fn code_scroll_is_opt_in_and_keeps_actions_at_viewport_edge(cx: &mut TestAppContext) {
+        struct CodeRoot {
+            scroll: bool,
+        }
+        impl Render for CodeRoot {
+            fn render(&mut self, _: &mut Window, _: &mut Context<Self>) -> impl IntoElement {
+                div().w(px(260.)).child(
+                    TextView::markdown(
+                        "code-scroll-geometry",
+                        "```rust\nwide_🦀_abcdefghijklmnopqrstuvwxyz_ABCDEFGHIJKLMNOPQRSTUVWXYZ_0123456789\nshort\n```\n\n```rust\nnext\n```",
+                    )
+                    .style(TextViewStyle::default().with_code_block_horizontal_scroll(self.scroll))
+                    .code_block_actions(|block, _, _| {
+                        let selector = if block.code().contains("wide") { "wide-action" } else { "next-action" };
+                        div().debug_selector(move || selector.into()).child("Copy")
+                    }),
+                )
+            }
+        }
+        let mut next_tops = Vec::new();
+        for scroll in [false, true] {
+            cx.update(crate::init);
+            let (_, window) = cx.add_window_view(move |_, _| CodeRoot { scroll });
+            let window: &mut VisualTestContext = window;
+            window.run_until_parked();
+            window.update(|window, cx| {
+                let _ = window.draw(cx);
+            });
+            let action = window.debug_bounds("wide-action").unwrap();
+            let next = window.debug_bounds("next-action").unwrap();
+            assert!(
+                action.right() < px(260.),
+                "action must stay pinned: {action:?}"
+            );
+            next_tops.push(next.top());
+        }
+        assert!(
+            next_tops[0] > next_tops[1] + px(20.),
+            "default code should wrap, scrolled code should retain only hard-line height: {next_tops:?}"
+        );
+    }
