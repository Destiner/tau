+/// Maximum shaped hard-line width in the exact mono font and highlighted runs
+/// rendered by the code block. Newlines contribute height, not width.
+fn measure_code_width(
+    code: &str,
+    highlights: &[(Range<usize>, InlineHighlight)],
+    style: &TextViewStyle,
+    window: &mut Window,
+    cx: &App,
+) -> Pixels {
+    let mut text_style = window.text_style();
+    text_style.font_family = cx.theme().tokens.typography.mono.clone();
+    text_style.font_size = cx.theme().tokens.typography.mono_md.size.into();
+    text_style.refine(&style.code_block().text);
+    let font_size = text_style.font_size.to_pixels(window.rem_size());
+    let mut start = 0;
+    let mut width = Pixels::ZERO;
+    for line in code.split('\n') {
+        let end = start + line.len();
+        if !line.is_empty() {
+            let line_highlights = slice_ranges(highlights, start, end, |range, highlight| {
+                (range, highlight.clone())
+            });
+            let runs = text_runs(line.len(), &text_style, &line_highlights);
+            width = width.max(
+                window
+                    .text_system()
+                    .layout_line(line, font_size, &runs, None)
+                    .width,
+            );
+        }
+        start = end + 1;
+    }
+    width
