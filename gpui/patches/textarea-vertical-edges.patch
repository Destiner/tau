+        cx.run_until_parked();
+        cx.update(|window, cx| {
+            view.input.update(cx, |state, cx| {
+                state.move_to(3, None, cx);
+                state.up(&MoveUp, window, cx);
+                assert_eq!(state.cursor(), 0);
+                state.down(&MoveDown, window, cx);
+                assert_eq!(state.cursor(), 6);
+                state.set_value("", window, cx);
+                state.up(&MoveUp, window, cx);
+                state.down(&MoveDown, window, cx);
+                assert_eq!(state.cursor(), 0);
+            });
+        });
