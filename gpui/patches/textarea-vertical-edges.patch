+    #[gpui::test]
+    fn test_textarea_vertical_edges_preserve_column(cx: &mut TestAppContext) {
+        let view = InputView::build_textarea(cx, |state| state.default_value("abcdef\nuvwxyz"));
+        let mut cx = VisualTestContext::from_window(view.window_handle.into(), cx);
+        cx.run_until_parked();
+        cx.update(|window, cx| {
+            view.input.update(cx, |state, cx| {
+                state.move_to(3, None, cx);
+                state.up(&MoveUp, window, cx);
+                assert_eq!(state.cursor(), 0);
+                state.down(&MoveDown, window, cx);
+                assert_eq!(state.cursor(), 10);
+                state.down(&MoveDown, window, cx);
+                assert_eq!(state.cursor(), 13);
+                state.up(&MoveUp, window, cx);
+                assert_eq!(state.cursor(), 3);
+            });
+        });
+    }
+
+    #[gpui::test]
+    fn test_textarea_vertical_edges_single_row_and_empty(cx: &mut TestAppContext) {
+        let view = InputView::build_textarea(cx, |state| state.default_value("abcdef"));
