+    /// Simulate native close control ordering, without holding the platform lock.
+    pub fn simulate_close(&self) -> bool {
+        let handler = self.0.lock().should_close_handler.take();
+        let allowed = if let Some(mut handler) = handler {
+            let allowed = handler();
+            self.0.lock().should_close_handler.get_or_insert(handler);
+            allowed
+        } else {
+            true
+        };
+        if allowed {
+            let close = self.0.lock().close_handler.take();
+            if let Some(close) = close {
+                close();
+            }
+        }
+        allowed
+    }
