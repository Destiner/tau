+    /// Request closing this window through the same veto used by native close controls.
+    /// Returns whether closing was allowed. Unlike `remove_window`, this invokes
+    /// `on_window_should_close`. The guard is synchronous; hosts waiting for an
+    /// asynchronous decision must return false and request again after approval.
+    pub fn request_close(&mut self, cx: &mut App) -> bool {
+        if self.removed {
+            return false;
+        }
+        if self.should_close(cx) {
+            self.remove_window();
+            true
+        } else {
+            false
+        }
+    }
+
+    fn should_close(&mut self, cx: &mut App) -> bool {
+        if self.removed || self.checking_close.replace(true) {
+            return false;
+        }
+        // Clone before calling: a guard can replace itself or request close again.
+        let guard = self.should_close.borrow().clone();
+        let allowed = guard.is_none_or(|guard| guard(self, cx));
+        self.checking_close.set(false);
+        allowed
+    }
