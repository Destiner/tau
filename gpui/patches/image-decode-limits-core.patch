+    #[test]
+    fn bounded_svg_checks_physical_output_before_pixmap() -> Result<()> {
+        let renderer = SvgRenderer::new(Arc::new(()));
+        let small = renderer
+            .parse_svg(br#"<svg xmlns="http://www.w3.org/2000/svg" width="2" height="3"/>"#)?;
+        let image = renderer.render_parsed_with_limits(&small, 1.0, Some(OUTPUT_LIMITS))?;
+        assert_eq!(image.as_bytes(0).unwrap().len(), 4 * 6 * 4);
+        for (width, height) in [(2048, 2048), (2048, 4096), (50000, 50000)] {
+            let source = format!(
+                r#"<svg xmlns="http://www.w3.org/2000/svg" width="{width}" height="{height}"/>"#
+            );
+            let svg = renderer.parse_svg(source.as_bytes())?;
+            assert!(
+                renderer
+                    .render_parsed_with_limits(&svg, 1.0, Some(OUTPUT_LIMITS))
+                    .is_err()
+            );
+        }
+        // At the physical byte boundary, admission succeeds without allocating it.
+        assert_eq!(OUTPUT_LIMITS.check(4096, 2048, 0, 0)?, 32 * 1024 * 1024);
+        assert!(OUTPUT_LIMITS.check(4096, 2049, 0, 0).is_err());
+        Ok(())
+    }
