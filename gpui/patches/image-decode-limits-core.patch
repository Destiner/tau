+/// Optional per-image limits on retained BGRA output. Decoder scratch is additional.
+#[derive(Clone, Copy, Debug, PartialEq, Eq, Hash)]
+pub struct ImageDecodeLimits {
+    /// Maximum cumulative retained bytes across all frames.
+    pub max_bytes: u64,
+    /// Maximum retained animation frames.
+    pub max_frames: u64,
+    /// Maximum physical output axis.
+    pub max_axis: u32,
+}
+
+impl ImageDecodeLimits {
+    pub(crate) fn check(self, width: u32, height: u32, bytes: u64, frames: u64) -> Result<u64> {
+        let total = u64::from(width)
+            .checked_mul(u64::from(height))
+            .and_then(|pixels| pixels.checked_mul(4))
+            .and_then(|frame| bytes.checked_add(frame));
+        anyhow::ensure!(
+            width > 0
+                && height > 0
+                && width <= self.max_axis
+                && height <= self.max_axis
+                && frames < self.max_frames
+                && total.is_some_and(|total| total <= self.max_bytes),
+            "image decode limit exceeded"
+        );
+        Ok(total.unwrap())
+    }
+
+    fn decoder_limits(self) -> image::Limits {
+        let mut limits = image::Limits::default();
+        limits.max_image_width = Some(self.max_axis);
+        limits.max_image_height = Some(self.max_axis);
+        limits.max_alloc = Some(self.max_bytes);
+        limits
+    }
+}
