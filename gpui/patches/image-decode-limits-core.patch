+    fn decode_static_image(
+        &self,
+        bytes: &[u8],
+        format: image::ImageFormat,
+    ) -> Result<SmallVec<[Frame; 1]>> {
+        use image::ImageDecoder;
+        let Some(limits) = self.decode_limits else {
+            return decode_static_image(bytes, format);
+        };
+        let mut reader = image::ImageReader::with_format(Cursor::new(bytes), format);
+        reader.limits(limits.decoder_limits());
+        let mut decoder = reader
+            .into_decoder()
+            .context("creating bounded image decoder")?;
+        let (width, height) = decoder.dimensions();
+        limits.check(width, height, 0, 0)?;
+        decoder.set_limits(limits.decoder_limits())?;
+        decode_static_image_from_decoder(decoder)
+    }
