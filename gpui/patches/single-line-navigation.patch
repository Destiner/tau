+    #[gpui::test]
+    fn test_single_line_vertical_boundaries(cx: &mut TestAppContext) {
+        let view = InputView::build(cx, |state| state.default_value("A😀BC"));
+        view.window_handle
+            .update(cx, |_, window, cx| {
+                view.input.update(cx, |state, cx| {
+                    state.set_selected_range(5..5, cx);
+                    state.up(&MoveUp, window, cx);
+                    assert_eq!(state.selected_range(), 0..0);
+                    state.up(&MoveUp, window, cx);
+                    assert_eq!(state.selected_range(), 0..0);
+                    state.down(&MoveDown, window, cx);
+                    assert_eq!(state.selected_range(), 7..7);
+                    state.set_selected_range(1..6, cx);
+                    state.up(&MoveUp, window, cx);
+                    assert_eq!(state.selected_range(), 0..0);
+                    state.set_selected_range(1..6, cx);
+                    state.down(&MoveDown, window, cx);
+                    assert_eq!(state.selected_range(), 7..7);
+                    state.set_selected_range(5..5, cx);
+                    state.set_readonly(true, cx);
+                    state.up(&MoveUp, window, cx);
+                    state.down(&MoveDown, window, cx);
+                    assert_eq!(state.selected_range(), 5..5);
+                    state.set_readonly(false, cx);
+                    state.set_value("", window, cx);
+                    state.up(&MoveUp, window, cx);
+                    state.down(&MoveDown, window, cx);
+                    assert_eq!(state.selected_range(), 0..0);
+                });
+            })
