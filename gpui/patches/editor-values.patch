+//! Mutate live policy without notifying: the delivered enabled listener must still fail closed.
+use super::*;
+use crate::input::{Input, InputBase, InputState};
+use core::prelude::v1::test;
+use gpui::{
+    TestApp,
+    accesskit::{Action, ActionData, ActionRequest, TreeId},
+};
+
+struct Host(Entity<InputState>);
+impl Render for Host {
+    fn render(&mut self, _: &mut Window, _: &mut Context<Self>) -> impl IntoElement {
+        InputBase::new("shell")
+            .role(None)
+            .w(px(300.))
+            .h(px(40.))
+            .child(Input::new(&self.0))
+    }
+}
+#[test]
+fn accessibility_value_retained_enabled_listener_checks_live_policy() {
+    let mut app = TestApp::new();
+    app.update(crate::init);
+    let mut window = app.open_window(|w, cx| {
+        Host(cx.new(|cx| {
+            InputState::new(w, cx)
+                .accessibility_label("Field")
+                .default_value("private😀")
+        }))
+    });
+    window.activate_accessibility();
+    for guard in 0..6 {
+        // Restore directly and then genuinely render an enabled action.
+        window.update(|s, _, cx| {
+            s.0.update(cx, |s, cx| {
+                s.disabled = false;
+                s.readonly = false;
+                s.masked = false;
+                s.ime_marked_range = None;
+                s.accessibility_label = Some("Field".into());
+                s.text = Rope::from("private😀");
+                cx.notify();
+            })
+        });
+        window.draw();
+        let tree = window.accessibility_tree().unwrap();
+        let (id, n) = tree
+            .nodes
+            .iter()
+            .find(|(_, n)| n.label() == Some("Field"))
+            .unwrap();
+        assert!(n.supports_action(Action::SetValue));
+        let id = *id;
+        // No notify or redraw: this intentionally retains the actual rendered listener.
+        window.update(|s, _, cx| {
+            s.0.update(cx, |s, _| match guard {
+                0 => s.disabled = true,
+                1 => s.readonly = true,
+                2 => s.masked = true,
+                3 => s.ime_marked_range = Some((0..1).into()),
+                4 => s.text = Rope::from("x".repeat(64 * 1024 + 1)),
+                5 => s.accessibility_label = None,
+                _ => unreachable!(),
+            })
+        });
+        assert!(
+            window
+                .accessibility_tree()
+                .unwrap()
+                .nodes
+                .iter()
+                .find(|(node, _)| *node == id)
+                .unwrap()
+                .1
+                .supports_action(Action::SetValue),
+            "must still be the delivered enabled action, not a redraw rejection"
+        );
+        window.dispatch_accessibility_action(ActionRequest {
+            action: Action::SetValue,
+            target_tree: TreeId::ROOT,
+            target_node: id,
+            data: Some(ActionData::Value("overwrite".into())),
+        });
+        window.read(|s, cx| {
+            let s = s.0.read(cx);
+            assert_eq!(
+                s.value().as_ref(),
+                if guard == 4 {
+                    "x".repeat(64 * 1024 + 1)
+                } else {
+                    "private😀".into()
+                }
+            );
+            assert!(
+                !s.undo_manager.can_undo(),
+                "rejected action must not enter history"
+            );
+            if guard == 3 {
+                assert!(s.ime_marked_range.is_some());
+            }
+        });
+    }
+    drop(window);
+    app.update(|cx| cx.shutdown());
+}
