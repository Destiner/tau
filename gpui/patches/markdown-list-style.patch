index 43d6cf3..a1272e4 100644
--- a/src/text/text_view.rs
+++ b/src/text/text_view.rs
@@ -2647,6 +2647,64 @@ mod tests {
         }
     }
 
+    #[test]
+    fn opt_in_list_style_changes_rendered_indent_and_item_spacing_only() {
+        use gpui::TestApp;
+
+        struct ListRoot {
+            original: Entity<TextViewState>,
+            styled: Entity<TextViewState>,
+        }
+        impl Render for ListRoot {
+            fn render(&mut self, _: &mut Window, _: &mut Context<Self>) -> impl IntoElement {
+                div()
+                    .w(px(300.))
+                    .text_size(px(11.))
+                    .child(crate::TextSelectionLayer)
+                    .child(TextView::new(&self.original).selectable(true))
+                    .child(TextView::new(&self.styled).selectable(true).style(
+                        TextViewStyle::default().with_list_style(
+                            px(17.),
+                            px(5.),
+                            gpui::rgb(0xa1a8b2).into(),
+                        ),
+                    ))
+            }
+        }
+
+        let mut app = TestApp::new();
+        app.update(crate::init);
+        let mut window = app.open_window(|_, cx| ListRoot {
+            original: cx.new(|cx| TextViewState::markdown("- One\n- Two", cx)),
+            styled: cx.new(|cx| TextViewState::markdown("- One\n- Two", cx)),
+        });
+        window.draw();
+        app.run_until_parked();
+        window.draw();
+        window.read(|root, cx| {
+            let rows = |view: &Entity<TextViewState>| {
+                let view = view.read(cx);
+                let bounds = view.bounds();
+                view.selection_adapter
+                    .text_bounds()
+                    .into_iter()
+                    .map(|line| (line.left() - bounds.left(), line.top() - bounds.top()))
+                    .collect::<Vec<_>>()
+            };
+            let original = rows(&root.original);
+            let styled = rows(&root.styled);
+            assert_eq!(original.len(), 2);
+            assert_eq!(styled.len(), 2);
+            assert_eq!(styled[0].0 - original[0].0, px(17.) - original[0].0);
+            assert_eq!(styled[1].0, styled[0].0);
+            assert_eq!(
+                styled[1].1 - styled[0].1,
+                original[1].1 - original[0].1 + px(5.)
+            );
+            assert_eq!(TextViewStyle::default().list_style(), None);
+        });
+    }
+
     /// The code-bearing list item takes `InlineFlow`; the plain item takes the
     /// ordinary text path. Their first body glyphs must begin at the same row
