# Local build and tooling outputs
**/node_modules/
**/target/
**/.cache/
.worktrees/
logs/
*.log

# Retain ignores for existing legacy local outputs; these are not product inputs.
/dist/
/dist-ssr/
/playwright-report/
/test-results/
/src-tauri/

# Local environment variables
.env
.env.*
!.env.example
*.local

# Editor files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Agent skills are versioned despite global excludes.
!.agents/
!.claude/
.claude/settings.local.json
