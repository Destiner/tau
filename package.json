{
  "name": "tau",
  "private": true,
  "license": "MIT",
  "version": "0.3.0",
  "type": "module",
  "scripts": {
    "prepare": "bun gpui/scripts/prepare.ts",
    "dev": "bun scripts/native.ts dev",
    "build": "bun scripts/native.ts build",
    "package": "bun gpui/scripts/package.ts",
    "package:macos": "bun scripts/macos-release.ts prepare",
    "verify:macos": "bun scripts/macos-release.ts verify",
    "format": "prettier --write . && bun scripts/native.ts format",
    "lint": "prettier --check . && eslint .",
    "typecheck": "tsc --noEmit",
    "check": "bun run lint && bun run typecheck && bun scripts/native.ts check",
    "test": "bun run test:tooling && bun run test:packaging && bun run test:keychain && bun run test:core && bun run test:native && bun run test:metal",
    "test:tooling": "bun test ./gpui/tests/package.bun.ts ./gpui/tests/version.bun.ts ./tests/tooling/native.bun.ts ./tests/tooling/native-package.bun.ts ./tests/tooling/macos-licenses.bun.ts",
    "test:packaging": "bun test ./tests/tooling/macos-bundle.bun.ts ./tests/tooling/macos-release.bun.ts",
    "test:keychain": "bun scripts/macos/keychain-tests.ts",
    "test:core": "bun scripts/native.ts test-core",
    "test:native": "bun scripts/native.ts test-native",
    "test:metal": "bun scripts/native.ts test-metal",
    "test:pi-contract": "bun scripts/pi-contract.ts"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/bun": "1.4.2",
    "@types/node": "26.2.0",
    "eslint": "10.8.1",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.11.0",
    "prettier": "3.9.6",
    "typescript": "5.9.3",
    "typescript-eslint": "8.67.0"
  }
}
